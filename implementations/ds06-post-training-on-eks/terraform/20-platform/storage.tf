# One bucket holds the four durable things of the design: versioned datasets, the tracking store (runs/), the model
# registry (registry/) and evaluation results (evals/). Each job identity can read and write only the prefixes it
# needs; the reward verifiers have no AWS identity at all.
resource "random_id" "bucket" {
  byte_length = 4
}

resource "aws_s3_bucket" "data" {
  bucket        = "${var.project}-data-${random_id.bucket.hex}"
  force_destroy = true # so teardown removes the objects with it
}

resource "aws_s3_bucket_public_access_block" "data" {
  bucket                  = aws_s3_bucket.data.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

# ---- datasets, generated by datasets/make_datasets.py ----------------------------------------------------------------
locals {
  ds_index = jsondecode(file("${var.datasets_dir}/index.json"))
}

resource "aws_s3_object" "dataset" {
  for_each = local.ds_index
  bucket   = aws_s3_bucket.data.id
  key      = each.value.key
  source   = "${var.datasets_dir}/${trimprefix(each.value.key, "datasets/")}"
  etag     = filemd5("${var.datasets_dir}/${trimprefix(each.value.key, "datasets/")}")
}

resource "aws_s3_object" "dataset_index" {
  bucket     = aws_s3_bucket.data.id
  key        = "datasets/index.json"
  source     = "${var.datasets_dir}/index.json"
  etag       = filemd5("${var.datasets_dir}/index.json")
  depends_on = [aws_s3_object.dataset]
}

# ---- workload identities (EKS Pod Identity) --------------------------------------------------------------------------
data "aws_iam_policy_document" "pod_identity_trust" {
  statement {
    actions = ["sts:AssumeRole", "sts:TagSession"]
    principals {
      type        = "Service"
      identifiers = ["pods.eks.amazonaws.com"]
    }
  }
}

locals {
  bucket_arn = aws_s3_bucket.data.arn
  # name => namespace, service account, prefixes it may read, prefixes it may write
  identities = {
    trainer   = { ns = "post-training", sa = "trainer", read = ["datasets", "registry", "runs"], write = ["runs", "registry"] }
    datagen   = { ns = "post-training", sa = "datagen", read = ["datasets", "registry", "runs"], write = ["runs", "datasets/generated"] }
    evaluator = { ns = "post-training", sa = "evaluator", read = ["datasets", "registry", "runs"], write = ["runs", "evals"] }
    monitor   = { ns = "platform", sa = "health-monitor", read = ["runs"], write = ["runs"] }
  }
}

resource "aws_iam_role" "identity" {
  for_each           = local.identities
  name               = "${var.project}-${each.key}"
  assume_role_policy = data.aws_iam_policy_document.pod_identity_trust.json
}

resource "aws_iam_role_policy" "identity" {
  for_each = local.identities
  name     = "prefix-access"
  role     = aws_iam_role.identity[each.key].id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      { Effect = "Allow", Action = ["s3:GetObject"], Resource = [for p in each.value.read : "${local.bucket_arn}/${p}/*"] },
      { Effect = "Allow", Action = ["s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload"], Resource = [for p in each.value.write : "${local.bucket_arn}/${p}/*"] },
      { Effect = "Allow", Action = ["s3:ListBucket"], Resource = local.bucket_arn, Condition = { StringLike = { "s3:prefix" = [for p in each.value.read : "${p}/*"] } } },
    ]
  })
}

resource "kubernetes_service_account_v1" "identity" {
  for_each = local.identities
  metadata {
    name      = each.value.sa
    namespace = each.value.ns
  }
  depends_on = [kubernetes_namespace_v1.ns]
}

resource "aws_eks_pod_identity_association" "identity" {
  for_each        = local.identities
  cluster_name    = var.project
  namespace       = each.value.ns
  service_account = each.value.sa
  role_arn        = aws_iam_role.identity[each.key].arn
  depends_on      = [kubernetes_service_account_v1.identity]
}

# A pod only gets Pod Identity credentials if the association exists when the pod is created, and a new association
# takes a few seconds to take effect. Pods that need an identity wait for this.
resource "time_sleep" "identity_ready" {
  create_duration = "45s"
  depends_on      = [aws_eks_pod_identity_association.identity]
}
