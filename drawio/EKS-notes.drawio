        <mxCell id="radb1vWyycFr9nWMZkw7-145" value="XFS vs&lt;br&gt;ext4" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontStyle=0" parent="1" vertex="1">
          <mxGeometry x="2230" y="760" width="120" height="40" as="geometry" />
