        <mxCell id="BqjdZk35KocaEsqu3exb-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-3" target="BqjdZk35KocaEsqu3exb-12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-3" value="Security Groups for Pods" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="2200" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-70" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-6" target="BqjdZk35KocaEsqu3exb-71">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1050" y="2000" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-6" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;10,0,1,0,0&quot;&gt;iptables Mode:&lt;/b&gt; Linear search/Random probability NAT; uses &lt;code data-index-in-node=&quot;58&quot; data-path-to-node=&quot;10,0,1,0,0&quot;&gt;conntrack&lt;/code&gt;." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="1970" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-7">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1080" y="2100" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-7" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;10,0,1,1,0&quot;&gt;IPVS Mode:&lt;/b&gt; Hash-table based; high performance for &amp;gt;1000 services; multiple LB algorithms (RR, LC)." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="637" y="2070" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-153" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-10" target="BqjdZk35KocaEsqu3exb-154">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1040" y="2200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-10" value="Uses &lt;b data-index-in-node=&quot;5&quot; data-path-to-node=&quot;10,1,1,0,0&quot;&gt;Branch ENIs&lt;/b&gt; assigned to specific pods." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="642" y="2170" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-168" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-12" target="BqjdZk35KocaEsqu3exb-169">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1050" y="2330" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-12" value="Allows isolation via standard AWS SG rules instead of just K8s NetworkPolicies." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="642" y="2300" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-14" target="BqjdZk35KocaEsqu3exb-16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-14" target="BqjdZk35KocaEsqu3exb-19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-14" value="Network Policies" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="2440" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-16" value="Requirement: &lt;br&gt;VPC CNI 1.14+ native (eBPF), or Calico/Cilium for advanced" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="642" y="2400" width="308" height="73.2" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-19" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;10,2,1,1,0&quot;&gt;Calico:&lt;/b&gt; &lt;br&gt;Enforces policies via iptables/eBPF while VPC CNI handles routing." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="642" y="2520" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-21">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="2990" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-21" value="Operations &amp;amp; Troubleshooting" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="2800" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-38" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" vertex="1" parent="1">
          <mxGeometry x="860" y="154.3" width="502" height="271.4" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-40" target="BqjdZk35KocaEsqu3exb-42">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1190" y="820" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-40" value="This tells the VPC CNI to always keep a specific number of &lt;b data-index-in-node=&quot;59&quot; data-path-to-node=&quot;3&quot;&gt;entirely empty ENIs&lt;/b&gt; attached to the node, with all their secondary IPs already allocated." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="862" y="790" width="278" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-42" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;4,1,0&quot;&gt;Best For:&lt;/b&gt; Handling massive, sudden bursts of Pods. If one ENI fills up, the next Pod can jump onto the warm ENI instantly." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1362" y="790" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-43" target="BqjdZk35KocaEsqu3exb-45">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="910" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-43" value="Instead of asking for a whole ENI, it tells the CNI to maintain a specific number of &lt;b data-index-in-node=&quot;123&quot; data-path-to-node=&quot;7&quot;&gt;individual free IP addresses&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="870" y="880" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-45" value="If you have 5 Pods running and &lt;code data-index-in-node=&quot;45&quot; data-path-to-node=&quot;8,1,0&quot;&gt;WARM_IP_TARGET&lt;/code&gt; is set to 5, the CNI will ensure you have 10 IPs allocated. If you start a 6th Pod, the CNI will immediately request 1 more IP from AWS to maintain that &quot;buffer&quot; of 5." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1352" y="880" width="328" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-47" target="BqjdZk35KocaEsqu3exb-50">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-47" value="This sets a &quot;floor&quot; for the &lt;b&gt;total number of IPs assigned to a node&lt;/b&gt;, regardless of how many Pods are actually running" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="970" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-50" value="&amp;nbsp;If this is set to 10 and you have 0 Pods, the node will still have 10 IPs ready. If you scale up to 12 Pods, this setting stops doing anything, and &lt;code data-index-in-node=&quot;162&quot; data-path-to-node=&quot;12,1,0&quot;&gt;WARM_IP_TARGET&lt;/code&gt; (if set) would take over." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1410" y="970" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-52" value="&quot;The Vibe&quot;: Aggressive:" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=#d6b656;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="1170" y="780" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-53" value="&quot;The Vibe&quot;: Balanced" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=#d6b656;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="1190" y="870" width="140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-54" value="&quot;The Vibe&quot;: Conservative" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=#d6b656;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="1220" y="967" width="160" height="30" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-55" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" vertex="1" parent="1">
          <mxGeometry x="1790" y="729.46" width="665" height="361.08" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-56" target="BqjdZk35KocaEsqu3exb-58">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="910" y="1135" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-56" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="820" y="1060" width="20" height="150" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-58">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1280" y="1135" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-58" value="If you are hitting the hardware/instance thresholds frequently, you &lt;b&gt;&lt;u&gt;don't &lt;/u&gt;&lt;/b&gt;necessarily need a bigger (more expensive) instance. You should enable &lt;b data-index-in-node=&quot;129&quot; data-path-to-node=&quot;16&quot;&gt;Prefix Delegation&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="890" y="1105" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-60">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2210" y="1312.54" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-60" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" vertex="1" parent="1">
          <mxGeometry x="1330" y="1105" width="762" height="415.08" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-61" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#FF0000;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1">
          <mxGeometry x="1352" y="1355" width="138" height="30" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-62" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#FF0000;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1">
          <mxGeometry x="1562" y="1390" width="168" height="20" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-63" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#FF0000;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1">
          <mxGeometry x="1700" y="1346" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-64" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" vertex="1" parent="1">
          <mxGeometry x="2220" y="1120" width="692" height="376.95" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-66">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1170" y="1695" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-66" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1045" y="1440" width="20" height="510" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-68" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" vertex="1" parent="1">
          <mxGeometry x="1200" y="1560.05" width="720" height="389.95" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-71" target="BqjdZk35KocaEsqu3exb-74">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-71" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;5,0,0&quot;&gt;Linear Search:&lt;/b&gt; When a packet arrives, the kernel has to read through the list of rules from top to bottom until it finds a match." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1090" y="1970" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-72">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2200" y="2000" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-72" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;5,3,0&quot;&gt;conntrack:&lt;/b&gt; It relies heavily on the Linux &quot;connection tracking&quot; table to remember where packets should go. If this table fills up, the node starts dropping connections." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1820" y="1970" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-76" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-74">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1810" y="2000" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-74" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;5,2,0&quot;&gt;Random Probability NAT:&lt;/b&gt; To balance traffic, &lt;code data-index-in-node=&quot;44&quot; data-path-to-node=&quot;5,2,0&quot;&gt;iptables&lt;/code&gt; uses a simple &quot;&lt;u&gt;statistic&lt;/u&gt;&quot; module. For example, if you have 3 pods, it gives the first pod a 33% chance of being picked, then the second a 50% chance of the remainder, etc." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1410" y="1970" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-82" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-77" target="BqjdZk35KocaEsqu3exb-79">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-77" value="&lt;b style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot; data-index-in-node=&quot;0&quot; data-path-to-node=&quot;9,0,0&quot;&gt;Hash-Table Based:&lt;/b&gt; Instead of a long list, IPVS stores service information in a &lt;b style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot; data-index-in-node=&quot;79&quot; data-path-to-node=&quot;9,0,0&quot;&gt;hash table&lt;/b&gt;. No matter if you have 10 services or 10,000, the lookup time is nearly &lt;b style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot; data-index-in-node=&quot;162&quot; data-path-to-node=&quot;9,0,0&quot;&gt;instant (O(1) complexity)&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1090" y="2080" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-84" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-79" target="BqjdZk35KocaEsqu3exb-83">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-86" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-79" target="BqjdZk35KocaEsqu3exb-85">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-79" value="&amp;nbsp;Unlike the &quot;random&quot; nature of iptables, IPVS supports real algorithms: RR (Round Robin),&amp;nbsp;LC (Least Connection),&amp;nbsp;DH (Destination Hashing)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1480" y="2080" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-81" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;15,0,0&quot;&gt;Use iptables if:&lt;/b&gt; You have a small-to-medium cluster (&amp;lt; 500 services) and want the simplest possible setup." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="2210" y="1970" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-83" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;15,1,0&quot;&gt;Use IPVS if:&lt;/b&gt; You are running &lt;b data-index-in-node=&quot;29&quot; data-path-to-node=&quot;15,1,0&quot;&gt;Large Language Models&lt;/b&gt;, high-frequency APIs, or large clusters where network latency is a critical bottleneck." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1915" y="2080" width="305" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-87" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-85">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2320" y="2200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-85" value="Even though IPVS uses a fast hash table to decide &lt;i data-index-in-node=&quot;50&quot; data-path-to-node=&quot;4&quot;&gt;which&lt;/i&gt; pod should get the traffic, it still needs to perform NAT to rewrite the &lt;b data-index-in-node=&quot;129&quot; data-path-to-node=&quot;4&quot;&gt;Destination IP&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1920" y="2170" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-88" value="&lt;b data-index-in-node=&quot;10&quot; data-path-to-node=&quot;0&quot;&gt;IPVS still uses conntrack&lt;/b&gt;,but it uses it differently and much more efficiently than &lt;code data-index-in-node=&quot;95&quot; data-path-to-node=&quot;0&quot;&gt;iptables&lt;/code&gt; mode does.&lt;br&gt;&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="2330" y="2170" width="370" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-89" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" vertex="1" parent="1">
          <mxGeometry x="2740" y="1920" width="612" height="330.15" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-92" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;flowAnimation=1;strokeColor=#FF0000;strokeWidth=2;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-90">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2980" y="2260" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-90" value="Think of &lt;b data-index-in-node=&quot;9&quot; data-path-to-node=&quot;0&quot;&gt;conntrack&lt;/b&gt; (Connection Tracking) as the &lt;b data-index-in-node=&quot;48&quot; data-path-to-node=&quot;0&quot;&gt;stateful memory&lt;/b&gt; of the Linux networking stack. Without it, your network would be &quot;forgetful,&quot; and almost every modern internet interaction would break." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="2920" y="2380" width="120" height="190" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-96" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-94">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3280" y="2540" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-94" value="Conntrack. It keeps a &quot;&lt;b&gt;&lt;font color=&quot;#cc0000&quot;&gt;notebook&lt;/font&gt;&lt;/b&gt;&quot; entry: &lt;i data-index-in-node=&quot;155&quot; data-path-to-node=&quot;7&quot;&gt;&quot;I just sent a packet from Pod A to DB X. If a packet comes back from DB X, give it to Pod A.&quot;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="3170" y="2410" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-95" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=-0.083;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-90" target="BqjdZk35KocaEsqu3exb-94">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-98" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-97">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3670" y="2580" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-97" value="Every entry in the conntrack table has a &lt;b data-index-in-node=&quot;41&quot; data-path-to-node=&quot;4&quot;&gt;TTL (Time To Live)&lt;/b&gt;. Every time a packet for that connection passes through the node, the timer is reset. If no packets are seen, the timer counts down to zero and the entry is deleted." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="3232" y="2550" width="368" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-99" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" vertex="1" parent="1">
          <mxGeometry x="3680" y="2500.0000000000005" width="615" height="189.18" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-102" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-100" target="BqjdZk35KocaEsqu3exb-101">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-100" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;strokeWidth=4;" vertex="1" parent="1">
          <mxGeometry x="3680" y="2570" width="650" height="40" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-104" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-101" target="BqjdZk35KocaEsqu3exb-103">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-101" value="Solution:&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3c800;fontColor=#000000;strokeColor=#B09500;" vertex="1" parent="1">
          <mxGeometry x="4410" y="2560" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-103" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" vertex="1" parent="1">
          <mxGeometry x="4620" y="2537" width="763" height="106" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-106" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-105">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="3470" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-138" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-105" target="BqjdZk35KocaEsqu3exb-137">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-181" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-105" target="BqjdZk35KocaEsqu3exb-180">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-105" value="Packet Journey" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="3440" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-108" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-107" target="BqjdZk35KocaEsqu3exb-109">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="3470" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-107" value="In put &lt;b&gt;iptable &lt;/b&gt;and &lt;b&gt;IPVS&lt;/b&gt;, the packet goes through a series of gates" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="3440" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-110" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-109">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="800" y="3470" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-109" value="These gates are line chains" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="615" y="3440" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-111" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="810" y="3410" width="20" height="160" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-113" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-112">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="970" y="3425" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-112" value="PREROUTING" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="820" y="3410" width="100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-115" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-114" target="BqjdZk35KocaEsqu3exb-116">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1110" y="3425" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-114" value="The Entry Gate" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="960" y="3410" width="110" height="30" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-128" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-116">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1470" y="3425" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-116" value="The very first stop. This is where &lt;b data-index-in-node=&quot;35&quot; data-path-to-node=&quot;5,1,2,0&quot;&gt;DNAT&lt;/b&gt; happens (changing a Service IP to a Pod IP) &lt;b data-index-in-node=&quot;84&quot; data-path-to-node=&quot;5,1,2,0&quot;&gt;before&lt;/b&gt; the kernel decides where to send it." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1150" y="3395" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-118" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-117">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="950" y="3495" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-117" value="FORWARD" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="825" y="3480" width="90" height="30" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-120" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-119" target="BqjdZk35KocaEsqu3exb-121">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1100" y="3495" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-119" value="The Hallway" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="950" y="3480" width="90" height="30" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-130" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-121">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1480" y="3495" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-121" value="This is only used if the packet is &quot;passing through&quot; (e.g., from the outside world to a Pod, or Pod-to-Pod). It's used for &lt;b data-index-in-node=&quot;123&quot; data-path-to-node=&quot;5,2,2,0&quot;&gt;Filtering&lt;/b&gt; (Security)." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1140" y="3465" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-122" value="POSTROUTING" style="text;whiteSpace=wrap;html=1;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="830" y="3540" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-125" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-124" target="BqjdZk35KocaEsqu3exb-126">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1140" y="3545" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-124" value="The Exit Gate" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1005" y="3545" width="100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-134" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-126">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1580" y="3560" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-126" value="The final stop before the packet leaves the network card. This is where &lt;b data-index-in-node=&quot;72&quot; data-path-to-node=&quot;5,3,2,0&quot;&gt;SNAT/Masquerade&lt;/b&gt; happens (changing the Pod's IP to the Node's IP)." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1220" y="3530" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-127" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=-0.05;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-122" target="BqjdZk35KocaEsqu3exb-124">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-129" value="In Kubernetes, &lt;b data-index-in-node=&quot;15&quot; data-path-to-node=&quot;8&quot;&gt;PREROUTING&lt;/b&gt; is the most important chain. Why? Because it handles the &lt;b data-index-in-node=&quot;83&quot; data-path-to-node=&quot;8&quot;&gt;Service IP translation.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1480" y="3395" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-132" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-131" target="BqjdZk35KocaEsqu3exb-133">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1800" y="3495" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-131" value="Once the destination is set to a Pod IP, the packet enters the &lt;b data-index-in-node=&quot;63&quot; data-path-to-node=&quot;14&quot;&gt;FORWARD&lt;/b&gt; chain." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1480" y="3465" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-133" value="&amp;nbsp;This is where &lt;b data-index-in-node=&quot;24&quot; data-path-to-node=&quot;15,0,0&quot;&gt;Network Policies&lt;/b&gt; usually live." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1820" y="3465" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-135" value="A Pod has a private IP (e.g., 192.168.1.5); the Internet can't reply to it. The Solution: POSTROUTING performs Masquerading (SNAT), stamping the node's primary private IP over the Pod's IP; a NAT gateway or public IP handles the Internet hop." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1580" y="3530" width="420" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-136" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" vertex="1" parent="1">
          <mxGeometry x="2030" y="3360" width="578" height="313.09" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-139" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-137">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="3710" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-137" value="Where Conntrack Sits in the gate system in above item?" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="3680" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-140" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="532" y="3650" width="20" height="170" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-142" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-141" target="BqjdZk35KocaEsqu3exb-143">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="710" y="3680" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-141" value="At the Entry (PREROUTING)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6d8764;fontColor=#ffffff;strokeColor=#3A5431;" vertex="1" parent="1">
          <mxGeometry x="552" y="3670" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-145" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-143" target="BqjdZk35KocaEsqu3exb-144">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-147" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-143" target="BqjdZk35KocaEsqu3exb-146">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-143" value="As the packet hits the gate, the &quot;Switchboard&quot; (DNAT) asks &lt;b&gt;&lt;u&gt;&lt;font color=&quot;#cc0000&quot;&gt;Conntrack&lt;/font&gt;&lt;/u&gt;&lt;/b&gt;: &lt;i data-index-in-node=&quot;97&quot; data-path-to-node=&quot;5,0,0&quot;&gt;&lt;b&gt;&quot;Have I seen this conversation before?&lt;/b&gt;&quot;&lt;/i&gt;&amp;nbsp;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="735" y="3670" width="395" height="40" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-144" value="&amp;nbsp;&lt;b style=&quot;border-color: var(--border-color);&quot; data-index-in-node=&quot;139&quot; data-path-to-node=&quot;5,0,0&quot;&gt;If No (New Packet):&lt;/b&gt;&amp;nbsp;Conntrack creates a new entry in its ledger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;" vertex="1" parent="1">
          <mxGeometry x="1190" y="3630" width="305" height="40" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-146" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;5,0,1,0,0&quot;&gt;If Yes (Reply Packet):&lt;/b&gt; Conntrack says, &lt;i data-index-in-node=&quot;39&quot; data-path-to-node=&quot;5,0,1,0,0&quot;&gt;&quot;I remember this! This is the reply for Pod A,&quot;&lt;/i&gt; and it automatically rewrites the IP addresses without having to look through the complex rules again." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;" vertex="1" parent="1">
          <mxGeometry x="1200" y="3730" width="440" height="40" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-151" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-149">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="3800" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-149" value="At the Exit (POSTROUTING)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6d8764;fontColor=#ffffff;strokeColor=#3A5431;" vertex="1" parent="1">
          <mxGeometry x="552" y="3780" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-150" value="As the packet leaves, &lt;b&gt;&lt;u&gt;&lt;font color=&quot;#cc0000&quot;&gt;Conntrack &lt;/font&gt;&lt;/u&gt;&lt;/b&gt;notes the &quot;return address&quot; (the Node's IP) so it knows exactly which Pod to give the answer to when it eventually comes back." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="735" y="3780" width="395" height="40" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-152" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" vertex="1" parent="1">
          <mxGeometry x="1660" y="3700" width="460" height="282.66" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-155" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-154" target="BqjdZk35KocaEsqu3exb-156">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1500" y="2200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-154" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;0&quot;&gt;&lt;font color=&quot;#67ab9f&quot;&gt;Security Groups for Pods&lt;/font&gt;&lt;/b&gt; (&lt;font color=&quot;#67ab9f&quot;&gt;&lt;b&gt;SGP&lt;/b&gt;&lt;/font&gt;) is an EKS feature that allows you to treat a Pod like a first-class AWS citizen. Instead of all Pods on a node sharing the same &quot;security identity&quot; (the node's Security Group), specific Pods can have their own firewall rules." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="2170" width="370" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-159" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-160" target="BqjdZk35KocaEsqu3exb-158">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-156" value="Standard EKS networking &lt;b&gt;assigns secondary IPs&lt;/b&gt; from the node's ENI to Pods. SGP changes this to a &lt;b data-index-in-node=&quot;97&quot; data-path-to-node=&quot;3&quot;&gt;Trunking&lt;/b&gt; model" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1500" y="2170" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-157" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" vertex="1" parent="1">
          <mxGeometry x="2130" y="2300" width="438.8" height="420" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-158" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;4,0,0&quot;&gt;The Trunk ENI:&lt;/b&gt; A special &quot;master&quot; network interface (&lt;code data-index-in-node=&quot;53&quot; data-path-to-node=&quot;4,0,0&quot;&gt;aws-k8s-trunk-eni&lt;/code&gt;) attached to the EC2 node." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1900" y="2340" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-161" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-156" target="BqjdZk35KocaEsqu3exb-160">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1820" y="2200" as="sourcePoint" />
            <mxPoint x="1870" y="2350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-163" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-160" target="BqjdZk35KocaEsqu3exb-162">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-165" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-160" target="BqjdZk35KocaEsqu3exb-164">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-160" value="How it works: Trunk &amp;amp; Branch ENIs" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1770" y="2270" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-162" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;4,1,0&quot;&gt;The Branch ENI:&lt;/b&gt; For every Pod that needs a custom Security Group, EKS creates a &lt;b data-index-in-node=&quot;80&quot; data-path-to-node=&quot;4,1,0&quot;&gt;Branch ENI&lt;/b&gt; (&lt;code data-index-in-node=&quot;92&quot; data-path-to-node=&quot;4,1,0&quot;&gt;aws-k8s-branch-eni&lt;/code&gt;)." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1900" y="2450" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-164" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;4,2,0&quot;&gt;The Connection:&lt;/b&gt; The Branch ENI is &quot;plugged into&quot; the Trunk ENI." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1900" y="2540" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-166" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;4,3,0&quot;&gt;The Security:&lt;/b&gt; You apply the &lt;b data-index-in-node=&quot;28&quot; data-path-to-node=&quot;4,3,0&quot;&gt;AWS Security Group&lt;/b&gt; directly to the Branch ENI. Since that ENI is dedicated to one Pod, that Pod now has its own unique virtual firewall." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1900" y="2631.8" width="230" height="88.2" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-167" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=-0.001;entryY=0.579;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-160" target="BqjdZk35KocaEsqu3exb-166">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-170" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-169" target="BqjdZk35KocaEsqu3exb-171">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1250" y="2330" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-169" value="&lt;b data-index-in-node=&quot;11&quot; data-path-to-node=&quot;3&quot;&gt;Branch ENI&lt;/b&gt; is a physical-to-virtual mapping designed for &lt;b data-index-in-node=&quot;68&quot; data-path-to-node=&quot;3&quot;&gt;isolation&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1070" y="2300" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-174" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-171" target="BqjdZk35KocaEsqu3exb-173">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-171" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;17,1,0&quot;&gt;Density:&lt;/b&gt; Using Branch ENIs reduces the number of &quot;&lt;b&gt;standard&lt;/b&gt;&quot; Pods you can run on a node because the Trunk ENI takes up one of the instance's ENI slots." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1290" y="2299" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-176" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-173" target="BqjdZk35KocaEsqu3exb-175">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-173" value="&lt;b&gt;&lt;u&gt;When to avoid ENI Trunking:&lt;br&gt;&lt;/u&gt;&lt;/b&gt;You should stay in the &quot;Normal Case&quot; unless you have a specific compliance requirement (like PCI-DSS) that mandates using &lt;b data-index-in-node=&quot;122&quot; data-path-to-node=&quot;16&quot;&gt;AWS-level firewalls&lt;/b&gt; instead of Kubernetes internal ones. &lt;br&gt;For most AI and web workloads, standard &lt;b data-index-in-node=&quot;219&quot; data-path-to-node=&quot;16&quot;&gt;NetworkPolicies&lt;/b&gt; (using &lt;font color=&quot;#67ab9f&quot;&gt;&lt;b&gt;Calico &lt;/b&gt;&lt;/font&gt;or &lt;b&gt;&lt;font color=&quot;#67ab9f&quot;&gt;Cilium&lt;/font&gt;&lt;/b&gt;) are faster and don't reduce your pod density (they use &lt;b&gt;eBPF &lt;/b&gt;or &lt;b&gt;iptables&lt;/b&gt;)." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1420" y="2400" width="430" height="110" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-175" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" vertex="1" parent="1">
          <mxGeometry x="1420" y="2559.06" width="445" height="240.94" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-179" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;flowAnimation=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-177" target="BqjdZk35KocaEsqu3exb-178">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-177" value="By default, Kubernetes Network Policies are like a &quot;&lt;b&gt;specification without an implementation&lt;/b&gt;.&quot; While you can write the YAML to block traffic, the basic &lt;b&gt;&lt;font color=&quot;#67ab9f&quot;&gt;AWS VPC CNI&lt;/font&gt;&lt;/b&gt; was originally designed only to handle routing (giving &lt;b&gt;&lt;u&gt;pods IPs&lt;/u&gt;&lt;/b&gt; and moving packets). It didn't actually &quot;read&quot; the security rules you wrote." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="2400" width="350" height="80" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-178" value="This is why you traditionally needed a 3rd-party &lt;b&gt;Policy Engine&lt;/b&gt; like &lt;b&gt;&lt;font color=&quot;#cc0000&quot;&gt;Calico &lt;/font&gt;&lt;/b&gt;or &lt;b&gt;&lt;font color=&quot;#cc0000&quot;&gt;Cilium &lt;/font&gt;&lt;/b&gt;to act as the &quot;Security Guard&quot; sitting on top of the VPC CNI's &quot;Roads.&quot;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1145" y="2520" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-182" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-180">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="3340" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-180" value="&lt;b data-index-in-node=&quot;69&quot; data-path-to-node=&quot;0&quot;&gt;Linux Kernel has 3 gates to contro the flow of packets.&lt;br&gt;&lt;/b&gt;&amp;nbsp;They exist even without Kubernetes" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="3310" width="420" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-185" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-183">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1540" y="3340" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-183" value="The Linux Kernel has a subsystem called &lt;b&gt;&lt;font color=&quot;#cc0000&quot;&gt;&lt;u&gt;Netfilter&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;. This subsystem is &lt;b&gt;built directly into the operating system&lt;/b&gt;.&lt;br&gt;&lt;b&gt;Netfilter Hooks&lt;/b&gt;: These are the &quot;&lt;b&gt;&lt;u&gt;gates&lt;/u&gt;&lt;/b&gt;&quot; we discuss below. They are hard-coded locations in the Linux networking stack where the kernel &lt;b&gt;pauses &lt;/b&gt;for a microsecond to ask, &quot;Does anyone have a rule for this packet?" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="822" y="3310" width="638" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-186" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-184">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2100" y="3340" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-184" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;4,1,0&quot;&gt;Conntrack:&lt;/b&gt; This is a kernel module (&lt;code data-index-in-node=&quot;36&quot; data-path-to-node=&quot;4,1,0&quot;&gt;nf_conntrack&lt;/code&gt;) that provides the &quot;&lt;b&gt;&lt;font color=&quot;#cc0000&quot;&gt;&lt;u&gt;ledger&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&quot; or state table. It tracks every connection passing through the machine, regardless of whether that machine is a laptop, a web server, or a K8s node." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1550" y="3310" width="480" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-188" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-187" target="BqjdZk35KocaEsqu3exb-189">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2480" y="3320" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-187" value="If you have a fresh Linux server with no apps, those gates are &quot;empty.&quot; They exist, but they don't have any specific instructions." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="2110" y="3290" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-189" value="When you install &lt;b&gt;Kubernetes&lt;/b&gt;, the&lt;b&gt;&lt;u&gt;&lt;font color=&quot;#cc0000&quot;&gt; kube-proxy component&lt;/font&gt;&lt;/u&gt;&lt;/b&gt; starts writing the instructions:&lt;br&gt;Kube-proxy uses tools like &lt;b&gt;iptable&lt;/b&gt;s or &lt;b&gt;nftables &lt;/b&gt;to tell the Kernel: &quot;When a packet hits the &lt;b&gt;&lt;u&gt;PREROUTING &lt;/u&gt;&lt;/b&gt;gate and its destination is this Service VIP, use &lt;b&gt;Conntrack &lt;/b&gt;to pick a Pod and rewrite the address (&lt;b&gt;DNAT&lt;/b&gt;).&quot;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="2506" y="3290" width="554" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-190" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" vertex="1" parent="1">
          <mxGeometry x="3080" y="3190" width="456" height="471.53" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-191" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" vertex="1" parent="1">
          <mxGeometry x="3070" y="3690" width="430" height="328.22" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-192" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.003;entryY=0.371;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-16" target="BqjdZk35KocaEsqu3exb-177">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-193" value="&lt;b&gt;1. The Law:&amp;nbsp; NetworkPolicy (K8s Object)&lt;br&gt;&lt;/b&gt;This is the high-level &quot;intent&quot; you write in YAML. It’s just a set of rules saying &quot;Pod A can talk to Pod B.&quot; By itself, this YAML file does nothing—it’s just a record in the Kubernetes database." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="3930" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-195" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-194" target="BqjdZk35KocaEsqu3exb-193">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-197" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-194" target="BqjdZk35KocaEsqu3exb-196">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-199" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-194" target="BqjdZk35KocaEsqu3exb-198">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-194" value="Network Policy vs. Netfilter gates&amp;nbsp; in kernel" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="110" y="4020" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-196" value="&lt;b&gt;2. The Translator: Calico&lt;/b&gt;&lt;br&gt;Calico is the &lt;b&gt;Controller&lt;/b&gt;. It sits on every node in your cluster and watches the Kubernetes API. When it sees you’ve created a NetworkPolicy, it thinks: &quot;Okay, I need to make sure this node actually blocks or allows this traffic.&quot; Calico’s job is to take that &lt;b&gt;human-readable YAML&lt;/b&gt; and translate it into a language the Linux Kernel understands." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="4070" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-201" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-198" target="BqjdZk35KocaEsqu3exb-200">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-203" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-198" target="BqjdZk35KocaEsqu3exb-202">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-205" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-198" target="BqjdZk35KocaEsqu3exb-204">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-198" value="&lt;h3 data-path-to-node=&quot;5&quot;&gt;3. The Enforcement: iptables (The Rulebook)&lt;/h3&gt;&lt;p data-path-to-node=&quot;6&quot;&gt;In Calico's default mode, that &quot;language&quot; is &lt;b data-index-in-node=&quot;45&quot; data-path-to-node=&quot;6&quot;&gt;iptables&lt;/b&gt;.&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="322" y="4210" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-200" value="Calico creates specific Chains (lists of rules) within the iptables of the Linux Node" style="rounded=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="840" y="4180" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-202" value="It places these rules at the &lt;b&gt;&lt;font color=&quot;#cc0000&quot;&gt;FORWARD &lt;/font&gt;&lt;/b&gt;hook of the Netfilter gate." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="4280" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-207" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-204">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1190" y="4399.999999999999" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-204" value="When a packet arrives at the &lt;b&gt;FORWARD &lt;/b&gt;hook, , the Linux Kernel pause and looks at the &lt;b&gt;iptables &lt;/b&gt;rules Calico wrote and decides to either &lt;b&gt;ACCEPT &lt;/b&gt;or &lt;b&gt;DROP &lt;/b&gt;the packet based on your original policy." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="4370" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-208" value="If accepted in goes to POSTROUTING GATE&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1190" y="4370" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-209" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" vertex="1" parent="1">
          <mxGeometry x="1394" y="4057.54" width="442" height="372.46" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-212" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-210" target="BqjdZk35KocaEsqu3exb-211">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-218" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-210" target="BqjdZk35KocaEsqu3exb-217">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-210" value="Calico vs.&amp;nbsp;Cilium " style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="4520" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-213" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-211" target="BqjdZk35KocaEsqu3exb-214">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="4504.999999999999" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-211" value="Calico is the most common choice for EKS because it can run in &quot;&lt;b&gt;&lt;font color=&quot;#cc0000&quot;&gt;Policy-Only Mode&lt;/font&gt;&lt;/b&gt;.&quot; This means it doesn't try to manage IPs (it leaves that to AWS); it only handles the security rules." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="322" y="4460" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-215" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-214" target="BqjdZk35KocaEsqu3exb-216">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1210" y="4504.999999999999" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-226" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-214" target="BqjdZk35KocaEsqu3exb-225">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-214" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;9,0,0&quot;&gt;How it works (iptables):&lt;/b&gt; Calico reads your Kubernetes labels (e.g., &lt;code data-index-in-node=&quot;68&quot; data-path-to-node=&quot;9,0,0&quot;&gt;&lt;b&gt;&lt;font color=&quot;#cc0000&quot;&gt;role: frontend&lt;/font&gt;&lt;/b&gt;&lt;/code&gt;) and translates them into thousands of Linux &lt;b data-index-in-node=&quot;128&quot; data-path-to-node=&quot;9,0,0&quot;&gt;iptables&lt;/b&gt; rules on the fly." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="830" y="4475" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-216" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;9,1,0&quot;&gt;The Workflow:&lt;/b&gt; &lt;br&gt;When a packet arrives at the node via the AWS ENI, it immediately hits the &lt;code data-index-in-node=&quot;89&quot; data-path-to-node=&quot;9,1,0&quot;&gt;iptables&lt;/code&gt; chain managed by Calico. If the packet is &quot;allowed,&quot; Calico lets it pass through to the pod." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1220" y="4475" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-219" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-217">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="4694.999999999999" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-217" value="&lt;h3 data-path-to-node=&quot;11&quot;&gt;Cilium: The eBPF Specialist&lt;/h3&gt;&lt;p data-path-to-node=&quot;12&quot;&gt;Cilium takes a more modern approach. Instead of using the old &quot;iptables&quot; chains (which can get slow and messy), it uses &lt;b data-index-in-node=&quot;120&quot; data-path-to-node=&quot;12&quot;&gt;eBPF (extended Berkeley Packet Filter)&lt;/b&gt;.&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="332" y="4650" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-222" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-220" target="BqjdZk35KocaEsqu3exb-221">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-232" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-220" target="BqjdZk35KocaEsqu3exb-231">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-238" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-220" target="BqjdZk35KocaEsqu3exb-237">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-220" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;13,0,0&quot;&gt;eBPF Magic:&lt;/b&gt; Cilium injects tiny, lightning-fast programs directly into the Linux kernel." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="4665" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-224" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-221" target="BqjdZk35KocaEsqu3exb-223">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-221" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;13,1,0&quot;&gt;Efficiency:&lt;/b&gt; Instead of a packet walking through a long list of iptables rules, the eBPF program sees the packet at the very first moment it touches the network card and makes an instant &quot;Allow/Deny&quot; decision." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1090" y="4665" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-223" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;13,2,0&quot;&gt;Identity-Aware:&lt;/b&gt; Cilium doesn't just look at IPs; it understands &lt;b data-index-in-node=&quot;64&quot; data-path-to-node=&quot;13,2,0&quot;&gt;identities&lt;/b&gt;. It knows that &quot;Pod A&quot; is the &quot;Payment Service&quot; and can block it from talking to anything except the &quot;Database.&quot;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1490" y="4665" width="390" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-227" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-225" target="BqjdZk35KocaEsqu3exb-228">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1590" y="4589.999999999999" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-225" value="When you write a policy that says &quot;Allow &lt;code data-index-in-node=&quot;41&quot; data-path-to-node=&quot;3&quot;&gt;frontend&lt;/code&gt; to talk to &lt;code data-index-in-node=&quot;61&quot; data-path-to-node=&quot;3&quot;&gt;backend&lt;/code&gt;,&quot; Calico has to do the heavy lifting" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1220" y="4560" width="305" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-229" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-228" target="BqjdZk35KocaEsqu3exb-230">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1990" y="4589.999999999999" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-228" value="It looks up all Pods with the label role: frontend.&#10;It looks up all Pods with the label role: backend." style="rounded=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1630" y="4560" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-230" value="If you have 10 frontend Pods and 10 backend Pods, Calico has to create rules that cover all those IP combinations." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="2040" y="4560" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-231" value="Cilium &lt;b&gt;does not &lt;/b&gt;rely on the linear rules of &lt;code data-index-in-node=&quot;44&quot; data-path-to-node=&quot;3&quot;&gt;iptables&lt;/code&gt; or the specialized hash tables of &lt;code data-index-in-node=&quot;87&quot; data-path-to-node=&quot;3&quot;&gt;ipvs&lt;/code&gt;. Instead, it injects tiny, high-performance programs directly into the Linux kernel hooks (specifically &lt;b data-index-in-node=&quot;196&quot; data-path-to-node=&quot;3&quot;&gt;tc&lt;/b&gt; or &lt;b data-index-in-node=&quot;202&quot; data-path-to-node=&quot;3&quot;&gt;XDP&lt;/b&gt;)." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="4825" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-233" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1460" y="4740" width="20" height="230" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-234" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;4,0,0&quot;&gt;&lt;u&gt;&lt;font color=&quot;#cc0000&quot;&gt;iptables&lt;/font&gt;&lt;/u&gt;:&lt;/b&gt; Processes packets by walking down a long list of &quot;if/then&quot; rules.&lt;sup data-turn-source-index=&quot;1&quot; class=&quot;superscript&quot;&gt;&lt;/sup&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
          <mxGeometry x="1490" y="4740" width="410" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-235" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;4,1,0&quot;&gt;&lt;font color=&quot;#cc0000&quot;&gt;&lt;u&gt;ipvs&lt;/u&gt;&lt;/font&gt;:&lt;/b&gt; Processes packets using a hash table lookup (better, but still limited by the fixed kernel logic)." style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
          <mxGeometry x="1490" y="4817" width="410" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-260" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-236">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1950" y="4929.999999999999" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-236" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;4,2,0&quot;&gt;&lt;font color=&quot;#cc0000&quot;&gt;&lt;u&gt;Cilium (eBPF)&lt;/u&gt;&lt;/font&gt;:&lt;/b&gt; Processes packets using custom-compiled code that runs at the &quot;front door&quot; of the network card. It uses its own eBPF hash maps to store service and endpoint data." style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
          <mxGeometry x="1495" y="4900" width="410" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-237" value="Cilium &lt;b&gt;operates in 3 modes.&lt;br&gt;It depends on&amp;nbsp;&lt;/b&gt;Helm setting &lt;code data-index-in-node=&quot;47&quot; data-path-to-node=&quot;1&quot;&gt;kubeProxyReplacement&lt;/code&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1105" y="5030" width="285" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-239" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1394" y="4995" width="20" height="245" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-241" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-240" target="BqjdZk35KocaEsqu3exb-242">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1880" y="5024.999999999999" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-240" value="&lt;code data-index-in-node=&quot;47&quot; data-path-to-node=&quot;1&quot;&gt;kubeProxyReplacement--&amp;gt;&amp;nbsp;&lt;/code&gt;Disabled Mode (&lt;code data-index-in-node=&quot;18&quot; data-path-to-node=&quot;3&quot;&gt;false&lt;/code&gt;&lt;span class=&quot;citation-85 citation-end-85&quot;&gt;)&lt;sup data-turn-source-index=&quot;1&quot; class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1430" y="4995" width="390" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-244" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-242">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2350" y="5024.999999999999" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-242" value="In this mode, Cilium acts as a &quot;&lt;b&gt;&lt;font color=&quot;#cc0000&quot;&gt;Traditional CNI.&lt;/font&gt;&lt;/b&gt;&quot; It focuses on giving &lt;b&gt;Pods IP&lt;/b&gt;s and &lt;b&gt;enforcing Network Policies&lt;/b&gt;, but it s&lt;font color=&quot;#ff0000&quot;&gt;tays out of the way of Service load balancing.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1915" y="4995" width="385" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-245" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-243" target="BqjdZk35KocaEsqu3exb-246">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2730" y="5024.999999999999" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-243" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;5,0,0&quot;&gt;Role of kube-proxy:&lt;/b&gt; It continues to run normally using &lt;code data-index-in-node=&quot;55&quot; data-path-to-node=&quot;5,0,0&quot;&gt;iptables&lt;/code&gt; or &lt;code data-index-in-node=&quot;67&quot; data-path-to-node=&quot;5,0,0&quot;&gt;IPVS&lt;/code&gt; to manage &lt;b&gt;&lt;font color=&quot;#cc0000&quot;&gt;Services &lt;/font&gt;&lt;/b&gt;(ClusterIP, NodePort)." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="2352.5" y="4995" width="325" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-246" value="You d&lt;b&gt;&lt;font color=&quot;#cc0000&quot;&gt;on't get the high-performance eBPF speed &lt;/font&gt;&lt;/b&gt;for service traffic; you still pay the &quot;iptables tax.&quot;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="2770" y="4995" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-250" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-247">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1910" y="5119.999999999999" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-247" value="&lt;code data-index-in-node=&quot;47&quot; data-path-to-node=&quot;1&quot;&gt;kubeProxyReplacement--&amp;gt;&amp;nbsp;&lt;/code&gt; Full / Strict Mode (&lt;code data-index-in-node=&quot;23&quot; data-path-to-node=&quot;7&quot;&gt;true&lt;/code&gt; / &lt;code data-index-in-node=&quot;30&quot; data-path-to-node=&quot;7&quot;&gt;strict&lt;/code&gt;)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1430" y="5090" width="390" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-253" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-249" target="BqjdZk35KocaEsqu3exb-252">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-249" value="This is the &quot;Superstar&quot; mode where Cilium takes over everything. You can (and should) physically delete the &lt;code data-index-in-node=&quot;108&quot; data-path-to-node=&quot;8&quot;&gt;kube-proxy&lt;/code&gt; DaemonSet from your cluster." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1915" y="5090" width="385" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-255" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-252" target="BqjdZk35KocaEsqu3exb-254">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-252" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;9,0,0&quot;&gt;Role of Cilium:&lt;/b&gt; It handles all Service types (ClusterIP, NodePort, LoadBalancer, ExternalIPs) using eBPF hash tables.&lt;sup data-turn-source-index=&quot;2&quot; class=&quot;superscript&quot;&gt;&lt;/sup&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="2360" y="5090" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-254" value="Direct Server Return (DSR): with eBPF, return traffic goes straight from the pod to the client instead of back through the load-balancing node, saving a hop and preserving client IP." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="2750" y="5090" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-258" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-256">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1910" y="5209.999999999999" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-256" value="&lt;code data-index-in-node=&quot;47&quot; data-path-to-node=&quot;1&quot;&gt;kubeProxyReplacement--&amp;gt;&amp;nbsp;&lt;/code&gt;&amp;nbsp;Partial / Hybrid Mode (&lt;code data-index-in-node=&quot;26&quot; data-path-to-node=&quot;11&quot;&gt;partial&lt;/code&gt;)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1430" y="5180" width="390" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-257" value="Cilium might handle &lt;b data-index-in-node=&quot;34&quot; data-path-to-node=&quot;13,0,0&quot;&gt;ClusterIP&lt;/b&gt; traffic (internal pod-to-pod) because it can do that very fast with eBPF, but it might leave &lt;b data-index-in-node=&quot;137&quot; data-path-to-node=&quot;13,0,0&quot;&gt;NodePort&lt;/b&gt; or &lt;b data-index-in-node=&quot;149&quot; data-path-to-node=&quot;13,0,0&quot;&gt;LoadBalancer&lt;/b&gt; traffic to &lt;code data-index-in-node=&quot;173&quot; data-path-to-node=&quot;13,0,0&quot;&gt;kube-proxy&lt;/code&gt;." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1915" y="5180" width="385" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-259" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" vertex="1" parent="1">
          <mxGeometry x="2310" y="4660" width="602" height="320.71" as="geometry" />
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-262" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="BqjdZk35KocaEsqu3exb-261">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2290" y="4929.999999999999" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BqjdZk35KocaEsqu3exb-261" value="&amp;nbsp;Cilium can catch packets at the &lt;b data-index-in-node=&quot;49&quot; data-path-to-node=&quot;12,0,0&quot;&gt;XDP (eXpress Data Path)&lt;/b&gt; layer—before the kernel even allocates a memory buffer (&lt;code data-index-in-node=&quot;129&quot; data-path-to-node=&quot;12,0,0&quot;&gt;sk_buff&lt;/code&gt;) for the packet. &lt;code data-index-in-node=&quot;154&quot; data-path-to-node=&quot;12,0,0&quot;&gt;ipvs&lt;/code&gt; happens much later in the stack." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1955" y="4900" width="285" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>