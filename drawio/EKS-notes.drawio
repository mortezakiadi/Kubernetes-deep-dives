        <mxCell id="jfUqYFFZsvSrPms0PR91-1" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;Nvidia device plug-in for Kubernetes&amp;nbsp;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="385" y="320" width="270" height="30" as="geometry" />
        </mxCell>
        <mxCell id="jfUqYFFZsvSrPms0PR91-2" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="250" y="350" width="843.33" height="460" as="geometry" />
        </mxCell>
        <mxCell id="jfUqYFFZsvSrPms0PR91-3" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;1) We install plugin on the worker nodes as DS&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;2) The plug in register itself to API server through kubelet&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;3 and 4) When a pod is scheduled on a&amp;nbsp; worker node&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;5) the kubelet in that node informs the plugin about the GPU resource requirement&amp;nbsp;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="280" y="850" width="460" height="70" as="geometry" />
        </mxCell>
        <mxCell id="jfUqYFFZsvSrPms0PR91-4" value="We add a module in EKS to install that plug-in" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="280" y="1020" width="270" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
