        </mxCell>
        <mxCell id="AZkzkRU9zzAwxuQuecVx-110" value="Rather than using k8s Secrets, many organizations opt for external secret management like HashiCorp Vault or AWS Secrets Manager" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
