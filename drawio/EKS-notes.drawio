        <mxCell id="z9_rcHuFkmwgBg6yj20q-61" value="  Observability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0a30a;strokeColor=#BD7000;fontColor=#000000;" parent="1" vertex="1">
          <mxGeometry x="3620" y="285" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-63" value="  FluentBit (Tenant labels)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0a30a;strokeColor=#BD7000;fontColor=#000000;" parent="1" vertex="1">
          <mxGeometry x="3450" y="410" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-64" value=" Prometheus &amp;amp; Thanos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0a30a;strokeColor=#BD7000;fontColor=#000000;" parent="1" vertex="1">
          <mxGeometry x="3640" y="402.5" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-65" value=" Distributed Tracing (X-Ray)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0a30a;strokeColor=#BD7000;fontColor=#000000;" parent="1" vertex="1">
          <mxGeometry x="3810" y="402" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-69" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;rotation=-90;" parent="1" vertex="1">
          <mxGeometry x="570" y="410" width="20" height="120" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-70" value="To prevent &lt;br&gt;resource exhaustion" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Comic Sans MS;" parent="1" vertex="1">
          <mxGeometry x="515" y="480" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-71" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;rotation=-90;" parent="1" vertex="1">
          <mxGeometry x="870" y="410" width="20" height="120" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-73" value="&lt;b&gt;Privileged:&lt;br&gt;&lt;/b&gt;no restrictions (danger zone)&lt;br&gt;&lt;b&gt;Baseline:&lt;br&gt;&lt;/b&gt;Reasonable defaults&lt;br&gt;&lt;b&gt;Restricted:&lt;br&gt;&lt;/b&gt;Maximum security, &lt;br&gt;production-grade hardening" style="text;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;html=1;" parent="1" vertex="1">
          <mxGeometry x="816" y="480" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-74" value="Pod Security Admission (PSA)" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="820" y="620" width="190" height="40" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-75" value="apiVersion: v1&#10;kind: Namespace&#10;metadata:&#10;  name: prod&#10;  labels:&#10;    pod-security.kubernetes.io/enforce: restricted" style="text;whiteSpace=wrap;fontFamily=Comic Sans MS;fillColor=#e3c800;fontColor=#000000;strokeColor=#B09500;gradientColor=#F8CECC;" parent="1" vertex="1">
          <mxGeometry x="810" y="650" width="290" height="110" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-76" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;rotation=-90;" parent="1" vertex="1">
          <mxGeometry x="1020" y="410" width="20" height="120" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-77" value="A &lt;strong data-end=&quot;630&quot; data-start=&quot;612&quot;&gt;ServiceAccount&lt;/strong&gt; &lt;br&gt;that&amp;nbsp;is the &lt;em data-end=&quot;648&quot; data-start=&quot;638&quot;&gt;identity&lt;/em&gt; &lt;br&gt;a pod runs as&lt;br&gt;&lt;br&gt;We want service accounts&lt;br&gt;to be &lt;b&gt;namespace&lt;/b&gt; scoped&lt;br&gt;and not &lt;b&gt;cluster&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="960" y="480" width="160" height="110" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-78" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;rotation=-90;" parent="1" vertex="1">
          <mxGeometry x="1320" y="410" width="20" height="120" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-79" value="Ensuring tenant pods only &lt;br&gt;run on designated nodes" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1260" y="472" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-80" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;rotation=-90;" parent="1" vertex="1">
          <mxGeometry x="1170" y="410" width="20" height="120" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-81" value="Different instance families&lt;br&gt;based on workload characteristics" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1090" y="500" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-82" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;rotation=-90;" parent="1" vertex="1">
          <mxGeometry x="1490" y="410" width="20" height="120" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-83" value="Separate VPC subnets &lt;br&gt;per tenant&amp;nbsp;tier for &lt;br&gt;network-level segmentation" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1410" y="480" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-84" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;rotation=-90;" parent="1" vertex="1">
          <mxGeometry x="1640" y="410" width="20" height="120" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-85" value="The trade-off is&lt;br&gt;&amp;nbsp;operational complexity &lt;br&gt;and cost vs. complete isolation." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1565" y="470" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-86" value=" Each tenant's pods get unique IAM roles mapped to&lt;br&gt;&amp;nbsp;Kubernetes service accounts via OIDC provider,&lt;br&gt;&lt;b&gt;reducing blast radius and enforcing tenant isolation&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1745" y="470" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-87" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;rotation=-90;" parent="1" vertex="1">
          <mxGeometry x="1905" y="285" width="20" height="370" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-88" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;rotation=-90;" parent="1" vertex="1">
          <mxGeometry x="2180" y="410" width="20" height="120" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-90" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="z9_rcHuFkmwgBg6yj20q-89" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2200" y="670" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-89" value="Prevents “connection storm” crashes,&lt;br&gt;The app uses AWS IAM to request a &lt;br&gt;&lt;strong data-end=&quot;1179&quot; data-start=&quot;1150&quot;&gt;short-lived DB auth token.&lt;br&gt;&lt;/strong&gt;RLS (row-level security)&lt;br&gt;&amp;nbsp;enforces &lt;strong data-end=&quot;1835&quot; data-start=&quot;1787&quot;&gt;data access rules &lt;br&gt;inside the database itself by mapping&lt;br&gt;IAM role--&amp;gt; DB role&lt;br&gt;and DB role --&amp;gt; RLS policy&lt;br&gt;&lt;/strong&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="2080" y="470" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-91" value="&lt;span style=&quot;font-weight: normal;&quot;&gt;In this case, the “tenant boundary” is enforced at three layers:&lt;/span&gt;&lt;br&gt;1) Kubernetes namespace/scheduling boundary&lt;br&gt;2) AWS IAM identity boundary (per-tenant)&lt;br&gt;3) Database boundary (instance-level OR RLS)" style="text;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=1;html=1;" parent="1" vertex="1">
          <mxGeometry x="2065" y="680" width="350" height="70" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-92" value=" S3 buckets &lt;b&gt;per tenant &lt;/b&gt;with bucket policies &lt;br&gt;and VPC endpoints: preventing cross-tenant &lt;br&gt;access even if credentials leak" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="2260" y="600" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-93" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;rotation=-90;" parent="1" vertex="1">
          <mxGeometry x="2330" y="410" width="20" height="120" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-94" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.418;entryY=-0.043;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="z9_rcHuFkmwgBg6yj20q-93" target="z9_rcHuFkmwgBg6yj20q-92" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-95" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;rotation=-90;" parent="1" vertex="1">
          <mxGeometry x="2460" y="410" width="20" height="120" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-96" value="Separate ElastiCache clusters&lt;br&gt;&amp;nbsp;per tier with&amp;nbsp;&amp;nbsp;logical databases per &lt;br&gt;tenant in shared tiers" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="2365" y="472" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-97" value="Shared ALB for standard tier with host-based routing&lt;br&gt;Dedicated NLBs for premium tier with client IP preservation&amp;nbsp;&lt;br&gt;and&amp;nbsp;no noisy neighbors (This is )&lt;strong data-end=&quot;2419&quot; data-start=&quot;2385&quot;&gt;network-level tenant isolation&lt;/strong&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="2465" y="530" width="370" height="60" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-101" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="z9_rcHuFkmwgBg6yj20q-98" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2610" y="520" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-98" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;rotation=-90;" parent="1" vertex="1">
          <mxGeometry x="2600" y="410" width="20" height="120" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-100" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;rotation=-90;" parent="1" vertex="1">
          <mxGeometry x="2842.5" y="412.5" width="15" height="110" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-104" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="z9_rcHuFkmwgBg6yj20q-102" target="z9_rcHuFkmwgBg6yj20q-103" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2845" y="510" />
              <mxPoint x="2845" y="510" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-102" value="If consumer of the application is&lt;br&gt;on VPC:" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="2770" y="480" width="190" height="40" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-103" value="consumer VPC → VPC Endpoint → AWS Backbone → Your NLB → Your service" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="2620" y="620" width="450" height="30" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-105" value="for advanced NetworkPolicies &lt;br&gt;since native Kubernetes NetworkPolicies &lt;br&gt;are limited (no L7 controls, no egress filtering by DNS)." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="2940" y="462.5" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-106" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;rotation=-90;" parent="1" vertex="1">
          <mxGeometry x="3070" y="402" width="15" height="110" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-108" value="&lt;b&gt;Tenant labels&lt;/b&gt; forwarding to &lt;br&gt;separate CloudWatch Log Groups" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="3273" y="462.5" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-109" value="using Thanos for long-term storage" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="3590" y="490" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-110" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;rotation=-90;" parent="1" vertex="1">
          <mxGeometry x="3280" y="520" width="20" height="120" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-114" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;rotation=-90;" parent="1" vertex="1">
          <mxGeometry x="3690" y="422.5" width="20" height="120" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-115" value="X-Ray or Jaeger with tenant context propagation" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="3800" y="487" width="280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-116" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;rotation=-90;" parent="1" vertex="1">
          <mxGeometry x="3850" y="423" width="20" height="120" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-117" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;rotation=-90;" parent="1" vertex="1">
          <mxGeometry x="810" y="540" width="20" height="560" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-118" value="&amp;nbsp;Kubernetes namespaces provide &lt;b&gt;&lt;em&gt;authorization&lt;/em&gt; &lt;/b&gt;boundaries, not &lt;b&gt;&lt;em&gt;trust&lt;/em&gt; &lt;/b&gt;boundaries. &lt;br&gt;They protect against &lt;font color=&quot;#ea6b66&quot;&gt;&lt;b&gt;configuration errors&lt;/b&gt;&lt;/font&gt; but not against &lt;b&gt;&lt;font color=&quot;#ea6b66&quot;&gt;kernel exploits&lt;/font&gt;&lt;/b&gt; or &lt;b&gt;&lt;font color=&quot;#ea6b66&quot;&gt;resource exhaustio&lt;/font&gt;&lt;/b&gt;n at the host level." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=0" parent="1" vertex="1">
          <mxGeometry x="505" y="830" width="640" height="40" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-121" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="10" y="1220" width="990" height="534" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-122" value="Using gVisor and KATA containers" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Comic Sans MS;fontStyle=1;fontSize=24;" parent="1" vertex="1">
          <mxGeometry x="285" y="1180" width="440" height="40" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-123" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1080" y="1220" width="20" height="530" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-124" value="&lt;font color=&quot;#ea6b66&quot;&gt;&lt;b&gt;Standard Tier:&lt;/b&gt; &lt;/font&gt;Use default runtimes (runC) for internal, trusted apps.&lt;br&gt;&lt;font color=&quot;#ea6b66&quot;&gt;&lt;b&gt;Premium Tier:&lt;/b&gt; &lt;/font&gt;Use gVisor for multi-tenant SaaS apps to prevent cross-tenant breaches.&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#ea6b66&quot;&gt;Ultra-Secure/Regulated Tier:&lt;/font&gt;&lt;/b&gt; Use Kata Containers for customers with strict compliance &lt;br&gt;needs (PCI-DSS/HIPAA) who require the hardware-level isolation of a VM." style="text;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;fontStyle=0;html=1;" parent="1" vertex="1">
          <mxGeometry x="1110" y="1440" width="650" height="90" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-125" value="apiVersion: node.k8s.io/v1&#10;kind: RuntimeClass&#10;metadata:&#10;  name: gvisor  # This is the name you will use later&#10;handler: runsc  # This tells the underlying container engine to use gVisor" style="text;whiteSpace=wrap;fillColor=#fa6800;fontColor=#000000;strokeColor=#C73500;fontFamily=Comic Sans MS;gradientColor=#A9C4EB;sketch=1;curveFitting=1;jiggle=2;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="40" y="1800" width="420" height="100" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-126" value="apiVersion: apps/v1&#10;kind: Deployment&#10;metadata:&#10;  name: premium-tenant-app&#10;  namespace: tenant-a-premium&#10;spec:&#10;  replicas: 2&#10;  selector:&#10;    matchLabels:&#10;      app: my-app&#10;  template:&#10;    metadata:&#10;      labels:&#10;        app: my-app&#10;    spec:&#10;      # HERE IS THE MAGIC LINE&#10;      # This forces Kubernetes to find a node with gVisor&#10;      # and use it to run these containers.&#10;      runtimeClassName: gvisor &#10;      containers:&#10;      - name: my-container&#10;        # This image was built with a standard Dockerfile&#10;        image: my-company/standard-image:v1 &#10;        ports:&#10;        - containerPort: 80" style="text;whiteSpace=wrap;fontFamily=Comic Sans MS;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;gradientColor=#D5E8D4;sketch=1;curveFitting=1;jiggle=2;" parent="1" vertex="1">
          <mxGeometry x="40" y="1910" width="320" height="380" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-127" value="" style="endArrow=classic;html=1;rounded=0;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="840" y="1770" as="sourcePoint" />
            <mxPoint x="840" y="1900" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-128" value="Using KATA &lt;br&gt;is very similar to Fargate&amp;nbsp;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="840" y="1775" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-130" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;imageBackground=#9AC7BF;sketch=1;curveFitting=1;jiggle=2;" parent="1" vertex="1">
          <mxGeometry x="716" y="1920" width="574" height="308.73" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-131" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1780" y="1427" width="20" height="120" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-134" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;flowAnimation=1;shadow=0;" parent="1" source="z9_rcHuFkmwgBg6yj20q-132" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1995" y="1600" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-132" value="If we use standard &lt;b&gt;runC&lt;/b&gt;, and if an attacker finds a bug in the kernel, &lt;br&gt;they can escape the container and take over the host.&amp;nbsp;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1800" y="1467" width="390" height="40" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-133" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1680" y="1610" width="590" height="324.5" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-136" value="" style="shape=flexArrow;endArrow=classic;html=1;rounded=0;fillColor=#fa6800;strokeColor=#C73500;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="2190" y="1486.5" as="sourcePoint" />
            <mxPoint x="2420" y="1487" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-137" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="2430" y="1425" width="20" height="765" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-138" value="so to manage risk for standard runC&amp;nbsp;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="2190" y="1500" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-141" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="z9_rcHuFkmwgBg6yj20q-140" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2610" y="1440" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-140" value="We&amp;nbsp; use &lt;b&gt;seccomp&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="2440" y="1425" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-142" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="3040" y="1370" width="500" height="269.84" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-144" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="z9_rcHuFkmwgBg6yj20q-143" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3010" y="1447" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-143" value=" A &quot;properly configured seccomp profile&quot; is a &lt;br&gt;whitelist that blocks any system call the &lt;br&gt;application doesn't absolutely need to function. " style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Comic Sans MS;" parent="1" vertex="1">
          <mxGeometry x="2620" y="1417" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-145" value=" AppArmor / SELinux Policies:&amp;nbsp;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="2430" y="1690" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-146" value="&lt;b&gt;Mandatory Access Control (MAC)&lt;/b&gt; systems in the kernel. &lt;br&gt;They provide a layer of security beyond standard file permissions (like chmod 777). &lt;br&gt;A policy might state: &quot;The Nginx process can only read files in /var/www/html and only write to /var/log/nginx.&quot;" style="text;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;html=1;" parent="1" vertex="1">
          <mxGeometry x="2680" y="1680" width="600" height="60" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-147" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2670" y="1704.5" as="targetPoint" />
            <mxPoint x="2620" y="1704.5" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-148" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="3273" y="1690" width="550" height="296.45" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-149" value="User Namespace Remapping" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="2440" y="2160" width="190" height="30" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-150" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2672" y="2177.5" as="targetPoint" />
            <mxPoint x="2622" y="2177.5" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-151" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="3204" y="2060" width="606" height="340.72" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-152" value="The kernel maps UID 0 inside the container to a high, unprivileged UID outside on the host. &lt;br&gt;If an attacker successfully breaks out of the container, they suddenly find themselves as a &lt;br&gt;powerless user on the host machine, unable to do any damage." style="text;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;html=1;" parent="1" vertex="1">
          <mxGeometry x="2680" y="2160" width="510" height="60" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-153" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="-200" y="1240" width="20" height="540" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-154" value="Kernel Level Isolation&amp;nbsp;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="-395" y="1500" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-155" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="-200" y="2350" width="20" height="540" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-156" value="Control Plane Security&amp;nbsp;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="-400" y="2605" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-159" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="z9_rcHuFkmwgBg6yj20q-158" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="370" y="2405" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-158" value="EKS control plane is managed by AWS, but &lt;b&gt;&lt;font color=&quot;#ea6b66&quot;&gt;API server access requires hardening&lt;/font&gt;&lt;/b&gt;." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-185" y="2390" width="480" height="30" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-160" value="Use private endpoint access only for production clusters, with VPC endpoint policies restricting source IPs." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="360" y="2390" width="590" height="30" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-164" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="z9_rcHuFkmwgBg6yj20q-161" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="2655" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-161" value="Implement &lt;b&gt;&lt;font color=&quot;#ea6b66&quot;&gt;admission webhooks (OPA Gatekeeper or Kyverno)&lt;/font&gt;&lt;/b&gt; enforcing policies that the in-tree admission controllers can't handle - things like image registry restrictions, label requirements, resource ratios." style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-170" y="2620" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-169" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="z9_rcHuFkmwgBg6yj20q-162" target="z9_rcHuFkmwgBg6yj20q-168" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-162" value="Enable audit logging to CloudWatch with &lt;b&gt;&lt;font color=&quot;#ea6b66&quot;&gt;tenant context&lt;/font&gt;&lt;/b&gt;. Parse these logs for anomalies using CloudWatch Insights or EventBridge patterns." style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-180" y="2830" width="560" height="50" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-163" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1010" y="2290.9" width="584" height="314.1" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-165" value="Network Isolation" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="-380" y="3540" width="170" height="30" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-166" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="-200" y="3290" width="20" height="700" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-167" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="540" y="2549.99" width="523" height="280.01" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-168" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="761" y="2860" width="539" height="297.59" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-173" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="z9_rcHuFkmwgBg6yj20q-170" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="3315" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-170" value="Consider &lt;b&gt;&lt;font color=&quot;#ea6b66&quot;&gt;Calico with VXLAN encapsulation&lt;/font&gt;&lt;/b&gt; for overlay networking, providing tenant isolation at the network overlay level independent of VPC subnet architecture." style="text;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=0;html=1;" parent="1" vertex="1">
          <mxGeometry x="-190" y="3300" width="890" height="30" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-174" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="z9_rcHuFkmwgBg6yj20q-171" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="520" y="3580" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-171" value="Or use custom CNI like &lt;font color=&quot;#ea6b66&quot;&gt;&lt;b&gt;Cilium with eBPF&lt;/b&gt;&lt;/font&gt; for efficient packet filtering at the kernel level without iptables overhead. &lt;br&gt;Cilium &lt;b&gt;&lt;font color=&quot;#ea6b66&quot;&gt;enables L7 network policies&lt;/font&gt;&lt;/b&gt; (HTTP method/path filtering) and DNS-aware policies." style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-180" y="3560" width="630" height="40" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-172" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="770" y="3220" width="490" height="262.46" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-176" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="z9_rcHuFkmwgBg6yj20q-175" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1170" y="3580" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-175" value="Cilium is a CNI plugin that replaces &lt;b&gt;kube-proxy and iptables.&lt;/b&gt; Instead of using the giant rulebook, &lt;br&gt;it uses &lt;b&gt;eBPF programs&lt;/b&gt; to reprogram the kernel's network path on the fly" style="text;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;html=1;" parent="1" vertex="1">
          <mxGeometry x="520" y="3560" width="550" height="40" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-180" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="z9_rcHuFkmwgBg6yj20q-177" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="440" y="3785" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-177" value="Implement &lt;b&gt;&lt;font color=&quot;#ea6b66&quot;&gt;transparent&lt;/font&gt;&lt;/b&gt; &lt;b&gt;encryption between pods&lt;/b&gt; using WireGuard or IPSec for regulated workloads." style="text;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;html=1;" parent="1" vertex="1">
          <mxGeometry x="-190" y="3770" width="570" height="30" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-187" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="z9_rcHuFkmwgBg6yj20q-178" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="4020" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-178" value="For egress control, use AWS &lt;b&gt;VPC endpoints&lt;/b&gt; for AWS services and NAT gateway with security group rules, &lt;br&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;or deploy a &lt;b&gt;transparent egress proxy &lt;/b&gt;with tenant-aware filtering.&lt;/span&gt;&lt;/div&gt;" style="text;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;html=1;" parent="1" vertex="1">
          <mxGeometry x="-180" y="3950" width="590" height="40" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-179" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1200" y="3500" width="676" height="367.18" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-182" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="z9_rcHuFkmwgBg6yj20q-181" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1070" y="3880" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-181" value="The underlying networking infrastructure (usually managed by a &lt;b&gt;CNI plugin like Cilium or Calico&lt;/b&gt;) &lt;b&gt;intercepts &lt;/b&gt;that packet just before it leaves the node. It &lt;font color=&quot;#ea6b66&quot;&gt;&lt;b&gt;wraps &lt;/b&gt;&lt;/font&gt;it in an encrypted tunnel, sends it across the wire, decrypts it on the receiving node, and hands it to Pod B" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" parent="1" vertex="1">
          <mxGeometry x="460" y="3760" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-184" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="z9_rcHuFkmwgBg6yj20q-183" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1300" y="3950" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-183" value="We can implement end-to-end encryption without a service mesh.&lt;br&gt;It is fast as it is implemented in Kernel and it works in L3 ." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Comic Sans MS;" parent="1" vertex="1">
          <mxGeometry x="785" y="3875" width="390" height="40" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-185" value="Cilium is currently the most popular choice for adding transparent encryption to EKS because &lt;br&gt;it uses eBPF for very high-performance WireGuard or IPSec implementations.&lt;br&gt;OR&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#ea6b66&quot;&gt;Better&lt;/font&gt;&lt;/b&gt;: AWS offers &lt;b data-index-in-node=&quot;11&quot; data-path-to-node=&quot;21&quot;&gt;automatic encryption-in-transit&lt;/b&gt;&lt;span class=&quot;citation-73 citation-end-73&quot;&gt; at the hardware level between specific types of EC2 instances&lt;br&gt;&lt;/span&gt;on specific &lt;b&gt;AWS Nitro Instances&lt;/b&gt;." style="text;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;html=1;fontFamily=Comic Sans MS;" parent="1" vertex="1">
          <mxGeometry x="1100" y="3950" width="680" height="90" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-188" value="The problem we are trying to solve is we do not know which tenant has sent the packet and the IP of the pods keep changing.&lt;br&gt;Tenant-Aware Filtering&quot; is the process of &lt;b data-index-in-node=&quot;54&quot; data-path-to-node=&quot;4&quot;&gt;bridging that identity gap&lt;/b&gt;. The proxy must figure out &lt;i data-index-in-node=&quot;108&quot; data-path-to-node=&quot;4&quot;&gt;who&lt;/i&gt; sent the packet before it can decide &lt;i data-index-in-node=&quot;149&quot; data-path-to-node=&quot;4&quot;&gt;what&lt;/i&gt; rules to apply." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="80" y="4040" width="850" height="40" as="geometry" />
        </mxCell>
        <mxCell id="z9_rcHuFkmwgBg6yj20q-189" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="515" y="4090" width="651" height="351.19" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
