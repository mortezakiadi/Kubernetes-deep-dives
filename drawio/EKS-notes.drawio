        </mxCell>
        <mxCell id="XwgDIaC6WEWvp0HOkpPq-43" value="&lt;b&gt;&lt;font color=&quot;#cc0066&quot;&gt;Steady State: &lt;/font&gt;&lt;/b&gt;&lt;br&gt;Run 1 replica in AZ-A.&lt;br&gt;Data Protection: Run a &lt;code data-index-in-node=&quot;34&quot; data-path-to-node=&quot;18,1,0&quot;&gt;CronJob&lt;/code&gt; that performs a logical dump (e.g., &lt;code data-index-in-node=&quot;78&quot; data-path-to-node=&quot;18,1,0&quot;&gt;pg_dump&lt;/code&gt; or &lt;code data-index-in-node=&quot;89&quot; data-path-to-node=&quot;18,1,0&quot;&gt;mysqldump&lt;/code&gt;) to an S3 bucket" style="rounded=1;whiteSpace=wrap;align=left;html=1;" parent="1" vertex="1">
          <mxGeometry x="1355" y="4150" width="385" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XwgDIaC6WEWvp0HOkpPq-44" value="&lt;b&gt;&lt;font color=&quot;#cc0066&quot;&gt;Failure Event (AZ-A goes down):&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Restore latest snapshot as a new volume in AZ-B.&lt;br&gt;Update nodeSelector in StatefulSet to AZ-B.&lt;br&gt;Pod restarts in AZ-B and attaches to the new volume" style="rounded=1;whiteSpace=wrap;align=left;html=1;" parent="1" vertex="1">
          <mxGeometry x="1355" y="4270" width="385" height="100" as="geometry" />
        </mxCell>
