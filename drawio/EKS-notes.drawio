        <mxCell id="AZkzkRU9zzAwxuQuecVx-134" value="&lt;span style=&quot;color: rgb(34, 34, 34); text-align: left; background-color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;Enforce TLS for all communications to ensure data is encrypted in transit and verify the authenticity of clients and services using appropriate authentication methods.&amp;nbsp;&lt;/font&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
