        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-25" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;fontColor=#FFFFFF;" parent="1" vertex="1">
          <mxGeometry x="225" y="409" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-26" value="CNI is an open source API to allow k8s to handle container networking&amp;nbsp;&lt;div&gt;by using any plug-and-play CNI-compatible plug-in like Calico or Amazon VPC CNI. kubelet asks CNI plug in to create a network namespace&amp;nbsp;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="78" y="144" width="770" height="40" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-27" value="Cilium" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="260" y="420" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-28" value="Calico" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="320" y="420" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-29" value="Amazon VPC CNI" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="380" y="420" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-30" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;fontColor=#FFFFFF;" parent="1" vertex="1">
          <mxGeometry x="50" y="200" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-31" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;fontColor=#FFFFFF;" parent="1" vertex="1">
          <mxGeometry x="502" y="420" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-32" value="CNI plug-in communicates with IPAM to get the IP for Pods" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="75" y="195" width="340" height="30" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-33" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;fontColor=#FFFFFF;" parent="1" vertex="1">
          <mxGeometry x="50" y="240" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-34" value="CNI plug in also communicates with IPTable that is part of Linux kernel for packet filtering and network traffic" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="60" y="235" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.75;entryDx=0;entryDy=0;endArrow=none;endFill=0;" parent="1" source="DeEQa3-ZB6ySzQWw1Uut-36" target="DeEQa3-ZB6ySzQWw1Uut-10" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="460" y="470" />
              <mxPoint x="460" y="413" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-36" value="IPTable" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="381" y="460" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-37" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;fontColor=#FFFFFF;" parent="1" vertex="1">
          <mxGeometry x="462" y="420" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=none;endFill=0;" parent="1" source="DeEQa3-ZB6ySzQWw1Uut-39" target="DeEQa3-ZB6ySzQWw1Uut-36" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-39" value="kube proxy" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="168" y="460" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-40" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;fontColor=#FFFFFF;" parent="1" vertex="1">
          <mxGeometry x="290" y="480" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-41" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fa6800;shadow=1;sketch=1;curveFitting=1;jiggle=2;opacity=50;fontColor=#000000;strokeColor=#C73500;" parent="1" vertex="1">
          <mxGeometry x="360" y="455" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-42" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;fontColor=#FFFFFF;" parent="1" vertex="1">
          <mxGeometry x="50" y="280" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-43" value="In k8s, kube-proxy also uses IPTable for to manage network traffic" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="70" y="275" width="370" height="30" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-44" value="&lt;b style=&quot;&quot;&gt;&lt;font color=&quot;#663300&quot;&gt;Kernel API&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="365" y="486" width="80" height="30" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-45" value="By default k8s network policies support limited set of rules like&lt;div&gt;IP, port, protocol, podSelector and namespace selector.&lt;/div&gt;&lt;div&gt;When we use external APIs like OpenAI or Claude, we want more&lt;/div&gt;&lt;div&gt;advanced settings like DNS based policies and globall&amp;nbsp;&lt;/div&gt;&lt;div&gt;policy accross all namespaces.&lt;/div&gt;&lt;div&gt;Cilium and Calico can help on that part&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="165" y="660" width="370" height="100" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-46" value="Network Optmization" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="75" y="900" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-47" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="205" y="800" width="20" height="530" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="DeEQa3-ZB6ySzQWw1Uut-49" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="825" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-49" value="Single Root Input/Output Virtualization (SR-IOV)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="215" y="810" width="280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-50" value="extended Berkeley Packet Filter (eBPF)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="215" y="870" width="230" height="30" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-51" value="Kube-proxy" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="210" y="1000" width="80" height="30" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-52" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="280" y="955" width="20" height="120" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-53" value="It maintains&amp;nbsp; network rules to direct traffic to the backend pod" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="280" y="955" width="350" height="30" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-54" value="By default it uses IPTables to intercept traffic and redirect them&amp;nbsp;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="283" y="985" width="360" height="30" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-55" value="For large scale network, using IPTables can be bottleneck" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="283" y="1015" width="330" height="30" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-56" value="kube-proxy can work in IP Virtual server mode (&lt;b&gt;IPVS&lt;/b&gt;) than &lt;b&gt;IPTables&lt;/b&gt; mode&lt;div&gt;(IPVS maintains an in-memory hash table for &lt;b&gt;Service-to-Pod&lt;/b&gt; routing)&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="280" y="1040" width="420" height="40" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="DeEQa3-ZB6ySzQWw1Uut-58" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="690" y="885" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-58" value="For network observability&amp;nbsp;&lt;div&gt;in kernel level processing&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="483" y="865" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.044;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="DeEQa3-ZB6ySzQWw1Uut-50" target="DeEQa3-ZB6ySzQWw1Uut-58" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-60" value="fine grained network security ,&amp;nbsp;&lt;div&gt;load balancing&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;and observability&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="690" y="865" width="190" height="40" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-61" value="eBPF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;" parent="1" vertex="1">
          <mxGeometry x="270" y="450" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-62" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="DeEQa3-ZB6ySzQWw1Uut-63" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="930" y="825" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-63" value="A single physical NIC to be partitioned into&amp;nbsp;&lt;div&gt;multiple &lt;b&gt;virtual functions. &lt;/b&gt;We will have dedicated&amp;nbsp;&lt;/div&gt;&lt;div&gt;and isolated network path&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="535" y="795" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-64" value="provides direct access to VMs and containers&lt;div&gt;hence less CPU overhead by offloading packet processing&lt;/div&gt;&lt;div&gt;to NIC&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="950" y="795" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="DeEQa3-ZB6ySzQWw1Uut-66" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="390" y="1165" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-66" value="CoreDNS scaling" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="205" y="1150" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="DeEQa3-ZB6ySzQWw1Uut-68" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="600" y="1165" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-68" value="Important in service discovery" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="380" y="1150" width="180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-69" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="DeEQa3-ZB6ySzQWw1Uut-70" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="920" y="1165" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-70" value="Better to have CoreDNS service in autoscaling" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="600" y="1150" width="270" height="30" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-71" value="with cluster proportional autoscaler" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="910" y="1150" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-72" value="Run DNS caching agent on every worker node" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="600" y="1200" width="270" height="30" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.733;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="DeEQa3-ZB6ySzQWw1Uut-68" target="DeEQa3-ZB6ySzQWw1Uut-72" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-74" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="DeEQa3-ZB6ySzQWw1Uut-75" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="390" y="1260" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-75" value="Network Latency" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="220" y="1245" width="110" height="30" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-76" value="EC2 placement group" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="382" y="1245" width="140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="DeEQa3-ZB6ySzQWw1Uut-78" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="440" y="1315" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-78" value="Throughput enhancement" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="215" y="1300" width="160" height="30" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-79" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="DeEQa3-ZB6ySzQWw1Uut-80" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="1315" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-80" value="EFA" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="433" y="1300" width="50" height="30" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-81" value="Uses RDMA (Remote Direct Memory Access) to transfer data between memory of two nodes access network&amp;nbsp;&lt;div&gt;without involving OS or CPU. EFA supports NCCL for GPU communications&amp;nbsp;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="522" y="1300" width="610" height="40" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-82" value="For that we need to make sure aws-efa-k8s-device-plugin is installed" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="530" y="1370" width="390" height="30" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-83" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.633;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="DeEQa3-ZB6ySzQWw1Uut-80" target="DeEQa3-ZB6ySzQWw1Uut-82" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-84" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="DeEQa3-ZB6ySzQWw1Uut-85" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1080" y="1455" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-85" value="Then in eks module in terraform we advertise that to be allocated by resources later" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="530" y="1440" width="470" height="30" as="geometry" />
        </mxCell>
        <mxCell id="DeEQa3-ZB6ySzQWw1Uut-86" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.667;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="DeEQa3-ZB6ySzQWw1Uut-80" target="DeEQa3-ZB6ySzQWw1Uut-85" edge="1">
