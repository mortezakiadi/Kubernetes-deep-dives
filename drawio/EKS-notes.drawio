          <mxGeometry x="2390" y="760" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-147" value="XFS: better parallel I/O for DBs (allocation groups)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Comic Sans MS;fontStyle=0" parent="1" vertex="1">
          <mxGeometry x="2205" y="800" width="150" height="45.2" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-148" value="rather than (buffered I/O):&#10;Disk --&gt; Kernel Page Cache (RAM) --&gt; &#10;Kernel copies data from Page Cache to the App's memory (DB page)&#10;&#10;We do (O_DIRECT):&#10;Disk --&gt; straight into the App's memory (DB buffer pool), bypassing the Page Cache" style="text;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Comic Sans MS;fontStyle=0" parent="1" vertex="1">
          <mxGeometry x="2390" y="810" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-152" value="Volume&lt;br&gt;Cloning" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontStyle=0" parent="1" vertex="1">
          <mxGeometry x="2300" y="1007" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-153" value="Uses&lt;br&gt;EBS Volume Cloning to&lt;br&gt;create a copy of EBS super fast" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Comic Sans MS;fontStyle=0" parent="1" vertex="1">
          <mxGeometry x="2256" y="1040" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-154" value="EBS Fast Snapshot&amp;nbsp;&lt;br&gt;Restore (FSR)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontStyle=0" parent="1" vertex="1">
          <mxGeometry x="2210" y="887" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-156" value="&amp;nbsp;Eliminates the initialization &lt;br&gt;lag when&amp;nbsp;creating volumes&lt;br&gt;&amp;nbsp;from an existing snapshot,&lt;br&gt;FSR pre-warms the volume, &lt;br&gt;eliminating lazy&amp;nbsp;loading penalty." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Comic Sans MS;fontStyle=0" parent="1" vertex="1">
          <mxGeometry x="2153" y="921.22" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-157" value="(good for:&amp;nbsp;pre-seeded data like ML models, &lt;br&gt;databases with reference data)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Comic Sans MS;fontStyle=0" parent="1" vertex="1">
          <mxGeometry x="2195" y="1092" width="260" height="40" as="geometry" />
        </mxCell>
