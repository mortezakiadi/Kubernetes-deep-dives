        <mxCell id="AwUWTfmbcilj25PflmkL-15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="AwUWTfmbcilj25PflmkL-13" target="AwUWTfmbcilj25PflmkL-16" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1820" y="4610" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-13" value="IOPS accounting: One IOPS is defined as an I/O operation of &lt;b data-index-in-node=&quot;53&quot; data-path-to-node=&quot;8,0,0&quot;&gt;256 KiB or smaller&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1487.5" y="4580" width="262.5" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="AwUWTfmbcilj25PflmkL-16" target="AwUWTfmbcilj25PflmkL-18" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2270" y="4610" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-16" value="If your database writes a large 1 MB (1024 KiB) chunk of data:&#10;You might think: &quot;That’s 1 operation.&quot;&#10;But AWS says: &quot;That’s 1024 / 256 = 4 IOPS." style="rounded=1;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="1820" y="4580" width="370" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-18" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;8,2,0&quot;&gt;Why it matters:&lt;/b&gt; If you have a 3,000 IOPS limit and you do a lot of large sequential writes, you will &quot;run out&quot; of IOPS much faster than you expect." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="2280" y="4580" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-19" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="2590" y="4540.55" width="281" height="144.87" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-20" value="IOPS accounting: One IOPS is defined as an I/O operation of &lt;b data-index-in-node=&quot;53&quot; data-path-to-node=&quot;8,0,0&quot;&gt;256 KiB or smaller&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1487.5" y="4580" width="262.5" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="AwUWTfmbcilj25PflmkL-21" target="AwUWTfmbcilj25PflmkL-24" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1820" y="4760" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-21" value="gp2 Burst Credits vs. gp3:&lt;br&gt;&lt;b&gt;Baseline:&lt;/b&gt; gp3 gives a flat &lt;b&gt;3,000 IOPS&lt;/b&gt; free, with &lt;b&gt;no burst credits&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1490" y="4730" width="262.5" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="AwUWTfmbcilj25PflmkL-24" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2100" y="4760" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-24" value="The Burst (gp2): idle gp2 volumes earn credits, spent to burst to 3,000 IOPS (e.g., a quick index rebuild)." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1800" y="4730" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="AwUWTfmbcilj25PflmkL-25" target="AwUWTfmbcilj25PflmkL-27" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-25" value="If load stays high for hours, the gp2 &quot;fuel tank&quot; empties and AWS caps you at baseline (3 IOPS/GiB). gp3 has no tank: provision IOPS explicitly." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="2100" y="4730" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-27" value="The Metric: For gp2/st1/sc1 watch BurstBalance (0% = cliff). For gp3 watch IOPS vs. provisioned and VolumeQueueLength." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="2430" y="4730" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-29" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="2859" y="4685.42" width="372" height="202.41" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="AwUWTfmbcilj25PflmkL-30" target="AwUWTfmbcilj25PflmkL-32" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-30" value="Multi-Attach: The &quot;Shared Drive&quot; Trap&lt;br&gt;Most EBS volumes can only be plugged into &lt;b data-index-in-node=&quot;42&quot; data-path-to-node=&quot;15&quot;&gt;one&lt;/b&gt; EC2 instance at a time. &lt;b data-index-in-node=&quot;70&quot; data-path-to-node=&quot;15&quot;&gt;Multi-Attach&lt;/b&gt; allows a volume to be plugged into up to 16 instances simultaneously." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1490" y="4880" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="AwUWTfmbcilj25PflmkL-32" target="AwUWTfmbcilj25PflmkL-35" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2120" y="4910" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-32" value="The Constraint: This is only available on Provisioned IOPS SSD volumes (io1 and io2), not gp2/gp3." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1850" y="4880" width="220" height="68.4" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="AwUWTfmbcilj25PflmkL-35" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2410" y="4910" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-35" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;16,1,0&quot;&gt;The &quot;Application-Level&quot; Warning:&lt;/b&gt; Just because two servers are plugged into the same drive doesn't mean they know how to share." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="2120" y="4880" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-36" value="You must use a &quot;&lt;b&gt;Clustered Filesystem&lt;/b&gt;&quot; (like GFS2) or an application that handles its own distributed locking. EBS does not do this for you." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="2411.12" y="4880" width="238.88" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-38" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="2690" y="4900" width="313" height="168.38" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="AwUWTfmbcilj25PflmkL-39" target="AwUWTfmbcilj25PflmkL-42" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-39" target="AwUWTfmbcilj25PflmkL-50" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-62" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-39" target="AwUWTfmbcilj25PflmkL-60" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1183" y="5020" />
              <mxPoint x="1183" y="5420" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-39" target="AwUWTfmbcilj25PflmkL-72" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-39" value="Volume manager and file system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#60a917;fontColor=#ffffff;strokeColor=#2D7600;" parent="1" vertex="1">
          <mxGeometry x="1010" y="4990" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-42" target="AwUWTfmbcilj25PflmkL-45" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-42" target="AwUWTfmbcilj25PflmkL-48" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-42" value="ext4 vs. XFS" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1230" y="4990" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-45" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;4,0,0&quot;&gt;ext4 :&lt;/b&gt; It is extremely reliable and handles directories with millions of &lt;b data-index-in-node=&quot;90&quot; data-path-to-node=&quot;4,0,0&quot;&gt;small files&lt;/b&gt; very efficiently. If you are running a web server with many small images or logs, ext4 is great" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1400" y="4970" width="370" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-48" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;4,1,0&quot;&gt;XFS :&lt;/b&gt; XFS was designed for high-performance and &lt;b data-index-in-node=&quot;73&quot; data-path-to-node=&quot;4,1,0&quot;&gt;large files&lt;/b&gt;. It excels at &quot;Parallel I/O,&quot; meaning it can handle multiple CPU cores writing to the same disk simultaneously without getting &quot;locked up.&quot;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1395" y="5050" width="370" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-50" target="AwUWTfmbcilj25PflmkL-53" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-50" target="AwUWTfmbcilj25PflmkL-55" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-50" value="File system block size" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1230" y="5180" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-52" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1815" y="4960" width="338" height="162.42" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-53" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;8,0,0&quot;&gt;Default (4KB):&lt;/b&gt; If you write a 1KB file, it still takes up 4KB of space. This is efficient for small files but creates a lot of &lt;b data-index-in-node=&quot;127&quot; data-path-to-node=&quot;8,0,0&quot;&gt;metadata&lt;/b&gt; (paperwork) for large files." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1400" y="5150" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-55" target="AwUWTfmbcilj25PflmkL-57" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-55" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;8,1,0&quot;&gt;Large Blocks (16KB or 64KB):&lt;/b&gt; By increasing the block size, you reduce the &quot;paperwork&quot; the CPU has to do to track where data is stored." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1400" y="5250" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-82" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-57" target="AwUWTfmbcilj25PflmkL-59" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-84" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="AwUWTfmbcilj25PflmkL-57" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2650" y="5280" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-57" value="For a large sequential database (like a Data Warehouse), 64KB is faster. However, if your database writes in &lt;b&gt;4KB&lt;/b&gt; chunks (like standard PostgreSQL), using a 16KB filesystem block size can cause &quot;&lt;b&gt;Write Amplification&lt;/b&gt;,&quot; where the disk does more work than necessary." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1800" y="5250" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-59" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="2291.14" y="5086.26" width="318.5" height="153.74" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-66" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-60" target="AwUWTfmbcilj25PflmkL-63" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-60" target="AwUWTfmbcilj25PflmkL-67" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-60" value="Mount Options" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1235" y="5390" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="AwUWTfmbcilj25PflmkL-63" target="AwUWTfmbcilj25PflmkL-65" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1810" y="5380" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-63" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;12,0,0&quot;&gt;&lt;code data-index-in-node=&quot;0&quot; data-path-to-node=&quot;12,0,0&quot;&gt;noatime&lt;/code&gt; (No Access Time):&lt;/b&gt; By default, Linux records the exact time every time a file is &lt;i data-index-in-node=&quot;88&quot; data-path-to-node=&quot;12,0,0&quot;&gt;read&lt;/i&gt;.&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1400" y="5350" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-65" value="For a database that reads thousands of blocks per second, this creates thousands of tiny, useless &lt;i data-index-in-node=&quot;192&quot; data-path-to-node=&quot;12,0,0&quot;&gt;writes&lt;/i&gt;. &lt;code data-index-in-node=&quot;200&quot; data-path-to-node=&quot;12,0,0&quot;&gt;noatime&lt;/code&gt; turns this off, saving disk bandwidth." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1840" y="5350" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-70" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-67" target="AwUWTfmbcilj25PflmkL-69" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-67" value="data=writeback (ext4 journaling mode): only metadata is journaled, and file data may be written to disk after the metadata that points to it." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1400" y="5470" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-69" value="It is faster, but after a crash a file can contain stale or garbage blocks. Most production DBs keep the default data=ordered and rely on their own Write-Ahead Log (WAL) + fsync for durability." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1840" y="5470" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-71" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="2265.16" y="5330" width="299.68" height="160" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-72" target="AwUWTfmbcilj25PflmkL-74" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-72" value="Direct I/O (&lt;code data-index-in-node=&quot;15&quot; data-path-to-node=&quot;14&quot;&gt;O_DIRECT&lt;/code&gt;)" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1240" y="5630" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-79" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-74" target="AwUWTfmbcilj25PflmkL-78" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-81" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-74" target="AwUWTfmbcilj25PflmkL-76" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-74" value="Normally, when an app writes data, it goes: &lt;b style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot; data-index-in-node=&quot;44&quot; data-path-to-node=&quot;15&quot;&gt;App --&amp;gt; to Linux Page Cache (RAM) --&amp;gt;&amp;nbsp;&lt;span style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot; data-index-in-node=&quot;75&quot; data-math=&quot;\to&quot; class=&quot;math-inline&quot;&gt;to&lt;/span&gt;&amp;nbsp;Filesystem --&amp;gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot; data-index-in-node=&quot;90&quot; data-math=&quot;\to&quot; class=&quot;math-inline&quot;&gt;to&lt;/span&gt;&amp;nbsp;Disk.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1400" y="5630" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-76" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;16,0,0&quot;&gt;The Problem:&lt;/b&gt; Databases like Oracle, MySQL, and Postgres are &quot;smart&quot;—they already have their own internal RAM caches (&lt;b&gt;Buffer Pools&lt;/b&gt;). Double-caching in the Linux Page Cache is a waste of memory and CPU." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1850" y="5590" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ctojGWUmKeZBxATr2Vp4-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-78" target="AwUWTfmbcilj25PflmkL-80" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-78" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;16,1,0&quot;&gt;The Solution:&lt;/b&gt; Using the &lt;code data-index-in-node=&quot;24&quot; data-path-to-node=&quot;16,1,0&quot;&gt;O_DIRECT&lt;/code&gt; flag allows the database to talk &lt;b data-index-in-node=&quot;66&quot; data-path-to-node=&quot;16,1,0&quot;&gt;directly&lt;/b&gt; to the filesystem/disk." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1850" y="5680" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-80" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="2274.0000000000005" y="5540" width="359.29" height="190" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-83" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="2655.75" y="5180" width="458.5" height="250.5" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-85" value="WAF= Write Amplification Factor" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="2785" y="5430.5" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-86" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="3231" y="5330" width="531" height="180.93" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-87" target="AwUWTfmbcilj25PflmkL-93" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-106" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-87" target="AwUWTfmbcilj25PflmkL-105" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-118" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-87" target="AwUWTfmbcilj25PflmkL-117" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-87" value="CSI Driver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#60a917;fontColor=#ffffff;strokeColor=#2D7600;" parent="1" vertex="1">
          <mxGeometry x="1010" y="5770" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-92" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-89" target="AwUWTfmbcilj25PflmkL-91" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-89" value="The &lt;b data-index-in-node=&quot;4&quot; data-path-to-node=&quot;0&quot;&gt;EBS CSI (Container Storage Interface) Driver&lt;/b&gt; is the translator between Kubernetes and AWS." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1235" y="5730" width="225" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-90" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.409;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="AwUWTfmbcilj25PflmkL-87" target="AwUWTfmbcilj25PflmkL-89" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-91" value="It is responsible for turning a YAML request (like a PersistentVolumeClaim) into actual physical disk operations in the AWS cloud" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1500" y="5730" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-97" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-93" target="AwUWTfmbcilj25PflmkL-95" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-98" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-93" target="AwUWTfmbcilj25PflmkL-96" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-93" value="The driver is split into&lt;b&gt; two distinct&lt;/b&gt; components that live in different parts of your cluster" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1240" y="5820" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-99" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="AwUWTfmbcilj25PflmkL-95" target="AwUWTfmbcilj25PflmkL-100" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1660" y="5830" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-95" value="Controller Pods" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3c800;fontColor=#000000;strokeColor=#B09500;" parent="1" vertex="1">
          <mxGeometry x="1500" y="5810" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-104" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="AwUWTfmbcilj25PflmkL-96" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1650" y="5910" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-96" value="Node Pods" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3c800;fontColor=#000000;strokeColor=#B09500;" parent="1" vertex="1">
          <mxGeometry x="1500" y="5890" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-100" value="Runs as a Deployment on worker nodes (in EKS the control plane is AWS-managed). &lt;br&gt;They talk to the AWS API. When you ask for a new disk, the Controller calls AWS to CreateVolume. It also handles the &quot;high-level&quot; logic of attaching a volume to an EC2 instance and taking snapshots." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1650" y="5800" width="490" height="68.6" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-103" value="As a &lt;b data-index-in-node=&quot;21&quot; data-path-to-node=&quot;5,1,1,0,0&quot;&gt;DaemonSet&lt;/b&gt; (one pod on every single worker node).&lt;br&gt;They perform the &lt;b data-index-in-node=&quot;22&quot; data-path-to-node=&quot;5,1,1,1,0&quot;&gt;Linux-level&lt;/b&gt; work. Once AWS attaches a disk to the EC2 instance, the Node pod &lt;b&gt;&lt;u&gt;formats &lt;/u&gt;&lt;/b&gt;it (e.g., with XFS or ext4) and &quot;&lt;b&gt;&lt;u&gt;mounts&lt;/u&gt;&lt;/b&gt;&quot; it so your pod can see the folder." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1659" y="5880" width="441" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-107" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="AwUWTfmbcilj25PflmkL-105" target="AwUWTfmbcilj25PflmkL-108" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1440" y="5990" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-105" value="&amp;nbsp;Volume Attachment &lt;b&gt;Flow&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1240" y="5960" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-110" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-108" target="AwUWTfmbcilj25PflmkL-109" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-108" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;9,0,0&quot;&gt;1.The Request:&lt;/b&gt; You create a PVC." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1455" y="5960" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-112" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="AwUWTfmbcilj25PflmkL-109" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1910" y="5990" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-109" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;9,1,0&quot;&gt;2.The Provisioner:&lt;/b&gt; The &lt;b data-index-in-node=&quot;21&quot; data-path-to-node=&quot;9,1,0&quot;&gt;CSI Controller&lt;/b&gt; sees the request and calls the &lt;b data-index-in-node=&quot;67&quot; data-path-to-node=&quot;9,1,0&quot;&gt;AWS EC2 API&lt;/b&gt; to create a physical EBS volume." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1620" y="5960" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-114" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="AwUWTfmbcilj25PflmkL-111" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2230" y="5990" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-111" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;9,2,0&quot;&gt;3. The Attachment:&lt;/b&gt; Once the scheduler knows which node the pod will live on, the Controller calls AWS to &lt;code data-index-in-node=&quot;102&quot; data-path-to-node=&quot;9,2,0&quot;&gt;AttachVolume&lt;/code&gt; to that specific EC2 instance." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1910" y="5960" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-116" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-113" target="AwUWTfmbcilj25PflmkL-115" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-113" value="4.&amp;nbsp;&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;9,3,0&quot;&gt;The Formatting:&lt;/b&gt; The &lt;b data-index-in-node=&quot;20&quot; data-path-to-node=&quot;9,3,0&quot;&gt;CSI Node pod&lt;/b&gt; on that specific instance sees the new device (e.g., &lt;code data-index-in-node=&quot;86&quot; data-path-to-node=&quot;9,3,0&quot;&gt;/dev/nvme1n1&lt;/code&gt;). It checks if it has a filesystem; if not, it formats it." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="2235" y="5960" width="275" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-115" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;9,4,0&quot;&gt;5.The Mount:&lt;/b&gt; Finally, the Node pod mounts the disk into a directory on the host, which is then mapped directly into your running container." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="2555" y="5960" width="235" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-123" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-117" target="AwUWTfmbcilj25PflmkL-120" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-124" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-117" target="AwUWTfmbcilj25PflmkL-122" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-126" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-117" target="AwUWTfmbcilj25PflmkL-125" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-117" value="&amp;nbsp;Handling &lt;code data-index-in-node=&quot;12&quot; data-path-to-node=&quot;11&quot;&gt;WaitForFirstConsumer&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1240" y="6070" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-120" value="A critical optimization for Multi-AZ clusters " style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1472.5" y="6050" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-122" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;13,0,0&quot;&gt;The Default (Immediate):&lt;/b&gt; Without this setting, the CSI Controller creates the volume the moment you create the PVC. It might pick &lt;code data-index-in-node=&quot;130&quot; data-path-to-node=&quot;13,0,0&quot;&gt;us-east-1a&lt;/code&gt; by accident, even if your pod eventually needs to run in &lt;code data-index-in-node=&quot;198&quot; data-path-to-node=&quot;13,0,0&quot;&gt;us-east-1b&lt;/code&gt;." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1470" y="6100" width="390" height="70" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-125" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;13,1,0&quot;&gt;The Smart Way (WaitForFirstConsumer):&lt;/b&gt; The CSI Driver &lt;b data-index-in-node=&quot;53&quot; data-path-to-node=&quot;13,1,0&quot;&gt;delays&lt;/b&gt; everything. It waits until the Kubernetes Scheduler says: &lt;i data-index-in-node=&quot;118&quot; data-path-to-node=&quot;13,1,0&quot;&gt;&quot;I have found a perfect home for this pod on Node-X in us-east-1b.&quot;&lt;/i&gt; Only then does the CSI Driver trigger the volume creation in that exact zone." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1472.5" y="6190" width="397.5" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-127" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="2163" y="5800" width="20" height="140" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-129" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="2220" y="5740" width="382.33" height="204.21" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-130" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="2820" y="5860" width="450" height="243.04" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-131" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1890" y="6060" width="20" height="190" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-132" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1917.68" y="6050" width="385.75" height="206.87" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-136" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-133" target="AwUWTfmbcilj25PflmkL-135" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-140" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-133" target="AwUWTfmbcilj25PflmkL-139" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-133" value="Kubernetes Persistent Volume (PV) Subsystem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#60a917;fontColor=#ffffff;strokeColor=#2D7600;" parent="1" vertex="1">
          <mxGeometry x="1010" y="6310" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-134" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=-0.008;entryY=0.406;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="AwUWTfmbcilj25PflmkL-1" target="AwUWTfmbcilj25PflmkL-133" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-137" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="AwUWTfmbcilj25PflmkL-135" target="AwUWTfmbcilj25PflmkL-138" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1600" y="6300" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-135" value="&amp;nbsp;is the abstraction layer that allows developers to request storage without needing to know anything about the underlying AWS hardware." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1220" y="6270" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-138" value="It acts as a &quot;broker&quot; between your application and the CSI Driver we just discussed" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1590" y="6270" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-145" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-139" target="AwUWTfmbcilj25PflmkL-142" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-146" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-139" target="AwUWTfmbcilj25PflmkL-143" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-147" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="AwUWTfmbcilj25PflmkL-139" target="AwUWTfmbcilj25PflmkL-144" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-139" value="The Core Components" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1225" y="6380" width="105" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-142" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;4,0,0&quot;&gt;PersistentVolume (PV):&lt;/b&gt; The actual &quot;Physical Apartment.&quot; It is a cluster-wide resource that represents the real EBS disk. It contains details like capacity, volume ID, and the filesystem type." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1370" y="6360" width="420" height="40" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-143" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;4,1,0&quot;&gt;PersistentVolumeClaim (PVC):&lt;/b&gt; The &quot;Rental Application.&quot; A developer creates this to say, &lt;i data-index-in-node=&quot;88&quot; data-path-to-node=&quot;4,1,0&quot;&gt;&quot;I need 50GB of fast storage.&quot;&lt;/i&gt; It doesn't care if it's EBS, EFS, or a local disk." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1375" y="6420" width="415" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-144" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;4,2,0&quot;&gt;StorageClass (SC):&lt;/b&gt; The &quot;Brochure.&quot; It defines the tiers available (e.g., &quot;Gold&quot; for &lt;code data-index-in-node=&quot;84&quot; data-path-to-node=&quot;4,2,0&quot;&gt;io2&lt;/code&gt;, &quot;Silver&quot; for &lt;code data-index-in-node=&quot;102&quot; data-path-to-node=&quot;4,2,0&quot;&gt;gp3&lt;/code&gt;). It tells Kubernetes which CSI driver to use and what parameters (like &lt;code data-index-in-node=&quot;178&quot; data-path-to-node=&quot;4,2,0&quot;&gt;iops&lt;/code&gt;) to apply." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1375" y="6520" width="415" height="60" as="geometry" />
        </mxCell>
        <mxCell id="AwUWTfmbcilj25PflmkL-148" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1825" y="6370" width="369.41" height="200" as="geometry" />
        </mxCell>
        <mxCell id="Y9MMBFf4Uacj9qZebdRB-1" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="2274" y="6370" width="1016" height="553.44" as="geometry" />
        </mxCell>
        <mxCell id="ctojGWUmKeZBxATr2Vp4-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=-0.014;entryY=0.51;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="AwUWTfmbcilj25PflmkL-127" target="AwUWTfmbcilj25PflmkL-129" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
