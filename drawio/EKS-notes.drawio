        <mxCell id="AwUWTfmbcilj25PflmkL-11" value="Network RTT (0.2-0.5ms within AZ) + EBS service latency (&amp;lt; 1ms for io2 Block Express) + queue depth impact" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1487.5" y="4390" width="262.5" height="60" as="geometry" />
        </mxCell>
