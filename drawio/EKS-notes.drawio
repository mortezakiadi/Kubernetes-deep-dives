          </mxGeometry>
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-160" value="Node Topology Considerations" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="660" y="1650" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-163" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="radb1vWyycFr9nWMZkw7-162" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1120" y="1680" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-162" value="For distributed stateful systems &lt;br&gt;(Cassandra, Kafka, Elasticsearch):" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="850" y="1660" width="210" height="40" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-164" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1130" y="1550" width="397" height="298.28" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-166" value="This spreads pods across AZs (maxSkew 1, hard requirement) &lt;br&gt;and nodes (maxSkew 2, soft preference)." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="1145" y="1860" width="380" height="40" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-167" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1025" y="1920" width="550" height="300.24" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-169" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="radb1vWyycFr9nWMZkw7-168" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="870" y="2420" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-168" value="CPU Pinning and NUMA Awareness" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="660" y="2390" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-173" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="radb1vWyycFr9nWMZkw7-170" target="radb1vWyycFr9nWMZkw7-171" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-174" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="radb1vWyycFr9nWMZkw7-170" target="radb1vWyycFr9nWMZkw7-172" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-170" value="In a modern multi-socket server (like an r6i.8xlarge), the CPUs are split into &lt;b&gt;&lt;font color=&quot;#cc0066&quot;&gt;NUMA Nodes&lt;/font&gt;&lt;/b&gt;. &lt;br&gt;Each &quot;node&quot; has its own group of &lt;b&gt;CPU cores and its own dedicated bank of local RAM.&lt;/b&gt;&lt;br&gt;" style="text;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;html=1;" parent="1" vertex="1">
          <mxGeometry x="870" y="2400" width="510" height="40" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-171" value="&lt;b&gt;Local Access: &lt;/b&gt;&lt;br&gt;A CPU core accessing RAM attached to its own socket is incredibly fast (low latency)." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1470" y="2320" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-172" value="&lt;b&gt;Remote Access: &lt;br&gt;&lt;/b&gt;If a CPU core needs data that is sitting in RAM attached to a different socket, it must travel across a &quot;bridge&quot; (like Intel's UPI or AMD's Infinity Fabric). This adds significant latency and reduces total bandwidth." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1470" y="2460" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-175" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1220" y="2540" width="550" height="302.26" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-176" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1910" y="2320" width="20" height="200" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-178" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="radb1vWyycFr9nWMZkw7-177" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2375" y="2570" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-177" value="Without &quot;Awareness,&quot; &lt;b&gt;&lt;font color=&quot;#cc0066&quot;&gt;Kubernetes treats all RAM and CPUs as one big pool.&lt;/font&gt;&lt;/b&gt;&lt;br&gt;If a database pod is scheduled such that its vCPUs are on &lt;b&gt;Socket 0&lt;/b&gt; but its Data is in RAM on &lt;b&gt;Socket 1&lt;/b&gt;, every single query faces a &quot;tax&quot; of remote memory latency.&lt;br&gt;&lt;b&gt;Context Switching&lt;/b&gt;: The Linux kernel frequently moves your database process from one core to another to balance the load.Cache Thrashing: &lt;br&gt;&lt;br&gt;When the process moves to a core on a different socket, it loses its L1/L2/L3 cache data, forcing it to fetch everything from RAM again.&lt;br&gt;On a large instance like an r6i.8xlarge (&lt;b&gt;32 vCPUs&lt;/b&gt;), this &quot;&lt;b&gt;shuffling&quot; can degrade your performance by 15–20%.&lt;/b&gt;" style="text;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=0;html=1;" parent="1" vertex="1">
          <mxGeometry x="1930" y="2370" width="890" height="100" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-180" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="radb1vWyycFr9nWMZkw7-179" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2390" y="2700" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-179" value="&lt;b&gt;Solution&lt;/b&gt;:&lt;br&gt;On kubelet &lt;br&gt;config:" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="2330" y="2580" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-181" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="2163" y="2709.26" width="537" height="133" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-191" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="radb1vWyycFr9nWMZkw7-182" target="radb1vWyycFr9nWMZkw7-183" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-192" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="radb1vWyycFr9nWMZkw7-182" target="radb1vWyycFr9nWMZkw7-184" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-193" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="radb1vWyycFr9nWMZkw7-182" target="radb1vWyycFr9nWMZkw7-190" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-182" value="I/O Scheduler Tuning" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="680" y="3040" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-185" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="radb1vWyycFr9nWMZkw7-183" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1070" y="3010" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-183" value="&lt;code data-index-in-node=&quot;0&quot; data-path-to-node=&quot;3&quot;&gt;none&lt;/code&gt; &lt;br&gt;(The &quot;Pass-Through&quot;)" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="875" y="2980" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-188" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="radb1vWyycFr9nWMZkw7-184" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1080" y="3110" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-184" value="&lt;code data-index-in-node=&quot;0&quot; data-path-to-node=&quot;6&quot;&gt;mq-deadline&lt;/code&gt; (The &quot;Read Prioritizer&quot;)" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="875" y="3080" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-187" value="&lt;b data-index-in-node=&quot;22&quot; data-path-to-node=&quot;5,0,0&quot;&gt;Best for: &lt;font color=&quot;#cc0066&quot;&gt;NVMe SSDs&lt;/font&gt;&lt;/b&gt; (which power EBS) have their own &lt;b&gt;&lt;font color=&quot;#cc0066&quot;&gt;internal controllers &lt;/font&gt;&lt;/b&gt;that are smarter and faster than the Linux kernel. By choosing &lt;code data-index-in-node=&quot;149&quot; data-path-to-node=&quot;5,0,0&quot;&gt;none&lt;/code&gt;, you remove the CPU overhead of the &lt;b&gt;kernel &lt;/b&gt;trying to be &quot;helpful.&quot;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1100" y="2980" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-189" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;8,1,0&quot;&gt;Best For:&lt;/b&gt; Mixed workloads on &lt;font color=&quot;#cc0066&quot;&gt;&lt;b&gt;SATA SSDs&lt;/b&gt;&lt;/font&gt; or older EBS volumes where you want to ensure consistent latency." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1100" y="3080" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-195" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="radb1vWyycFr9nWMZkw7-190" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1080" y="3220" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-190" value="&lt;code data-index-in-node=&quot;0&quot; data-path-to-node=&quot;9&quot;&gt;bfq&lt;/code&gt; (Budget Fair Queueing)" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="875" y="3190" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-194" value="&lt;code data-index-in-node=&quot;0&quot; data-path-to-node=&quot;10&quot;&gt;bfq&lt;/code&gt; gives every process a &quot;budget&quot; of disk time.&lt;br&gt;&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;11,1,0&quot;&gt;Best For:&lt;/b&gt; Multi-tenant clusters where you don't want one &quot;noisy neighbor&quot; pod to hog the entire disk.&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1100" y="3190" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-197" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="radb1vWyycFr9nWMZkw7-196" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1530" y="3110" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-196" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1440" y="2970" width="20" height="280" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-198" value="If you are seeing high &quot;I/O Wait&quot; in your database metrics, changing the scheduler to &lt;b&gt;&lt;font color=&quot;#cc0066&quot;&gt;&lt;code data-index-in-node=&quot;86&quot; data-path-to-node=&quot;23&quot;&gt;none&lt;/code&gt; &lt;/font&gt;&lt;/b&gt;is one of the fastest ways to get a &lt;b data-index-in-node=&quot;127&quot; data-path-to-node=&quot;23&quot;&gt;5–10% performance boost&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1560" y="3080" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-200" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="468.55" y="1200" width="491.45" height="248" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-201" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.515;entryY=-0.01;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="radb1vWyycFr9nWMZkw7-119" target="radb1vWyycFr9nWMZkw7-200" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="radb1vWyycFr9nWMZkw7-202" value="Example" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="736" y="1150" width="70" height="30" as="geometry" />
        </mxCell>
        <mxCell id="XwgDIaC6WEWvp0HOkpPq-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="XwgDIaC6WEWvp0HOkpPq-1" target="XwgDIaC6WEWvp0HOkpPq-3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XwgDIaC6WEWvp0HOkpPq-17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="XwgDIaC6WEWvp0HOkpPq-1" target="XwgDIaC6WEWvp0HOkpPq-16" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XwgDIaC6WEWvp0HOkpPq-35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="XwgDIaC6WEWvp0HOkpPq-1" target="XwgDIaC6WEWvp0HOkpPq-34" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XwgDIaC6WEWvp0HOkpPq-1" value="Handling&amp;nbsp;&lt;br&gt;&quot;AZ-locked&quot; nature of EBS volumes for multi-az stateful applications" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="654.27" y="3560" width="120" height="110" as="geometry" />
        </mxCell>
        <mxCell id="XwgDIaC6WEWvp0HOkpPq-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="XwgDIaC6WEWvp0HOkpPq-3" target="XwgDIaC6WEWvp0HOkpPq-6" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XwgDIaC6WEWvp0HOkpPq-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="XwgDIaC6WEWvp0HOkpPq-3" target="XwgDIaC6WEWvp0HOkpPq-8" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XwgDIaC6WEWvp0HOkpPq-3" value="Strategy 1: StatefulSet per AZ (Horizontal Replication)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#60a917;fontColor=#ffffff;strokeColor=#2D7600;" parent="1" vertex="1">
          <mxGeometry x="880" y="3360" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XwgDIaC6WEWvp0HOkpPq-5" value="Volumes are AZ-scoped " style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="639.27" y="3520" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="XwgDIaC6WEWvp0HOkpPq-6" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;6,0,0&quot;&gt;Architecture:&lt;/b&gt; &lt;br&gt;Separate &lt;code data-index-in-node=&quot;23&quot; data-path-to-node=&quot;6,0,0&quot;&gt;StatefulSet&lt;/code&gt; objects for each AZ (e.g., &lt;code data-index-in-node=&quot;62&quot; data-path-to-node=&quot;6,0,0&quot;&gt;db-az-a&lt;/code&gt;, &lt;code data-index-in-node=&quot;71&quot; data-path-to-node=&quot;6,0,0&quot;&gt;db-az-b&lt;/code&gt;)." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1155" y="3320" width="225" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XwgDIaC6WEWvp0HOkpPq-11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="XwgDIaC6WEWvp0HOkpPq-8" target="XwgDIaC6WEWvp0HOkpPq-10" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XwgDIaC6WEWvp0HOkpPq-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="XwgDIaC6WEWvp0HOkpPq-8" target="XwgDIaC6WEWvp0HOkpPq-12" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XwgDIaC6WEWvp0HOkpPq-8" value="Mechanisms" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="1156" y="3420" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="XwgDIaC6WEWvp0HOkpPq-10" value="&lt;code data-index-in-node=&quot;0&quot; data-path-to-node=&quot;6,1,1,0,0&quot;&gt;nodeSelector&lt;/code&gt; forces pods to stay in their specific zone." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1310" y="3400" width="180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="XwgDIaC6WEWvp0HOkpPq-12" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;6,1,1,1,0&quot;&gt;Application-Level Replication:&lt;/b&gt; &lt;br&gt;Cross-AZ data syncing is handled by the database itself (e.g., Postgres Streaming, Cassandra Multi-DC, Kafka Replication)." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1316" y="3460" width="254" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XwgDIaC6WEWvp0HOkpPq-14" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1659" y="3294.74" width="546" height="290.53" as="geometry" />
        </mxCell>
