          </mxGeometry>
        </mxCell>
        <mxCell id="AZkzkRU9zzAwxuQuecVx-126" value="To associate fine-grained IAM roles with K8s service accounts." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="2620" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="AZkzkRU9zzAwxuQuecVx-127" value="Applications running in K8s Pods can assume the role using their service account identity and access other AWS services based on the role permissions." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
