        <mxCell id="ZIigoqS-Je75IbdZw9gX-143" value="If a node runs out of RAM, the Kubelet kills pods in this order: &lt;br&gt;&lt;b data-index-in-node=&quot;124&quot; data-path-to-node=&quot;9,2,0&quot;&gt;BestEffort → Burstable → Guaranteed&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
