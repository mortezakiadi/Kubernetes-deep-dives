        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="OpszgItGXjJ0zVwLgXiD-1" target="EOVEU-vpQ8RlKc4mFksw-38" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OpszgItGXjJ0zVwLgXiD-1" value="Layer 1 - CPU &lt;br&gt;&lt;b&gt;(Compressible Resource)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3c800;fontColor=#000000;strokeColor=#B09500;" parent="1" vertex="1">
          <mxGeometry x="160" y="880" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-1" target="EOVEU-vpQ8RlKc4mFksw-3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-1" target="EOVEU-vpQ8RlKc4mFksw-5" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-1" value="Kubernetes &lt;b&gt;doesn't manage CPU cycles directly&lt;/b&gt;; it delegates that task to the &lt;b data-index-in-node=&quot;77&quot; data-path-to-node=&quot;3&quot;&gt;Linux Kernel&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="520" y="806" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-3" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;4,0,0&quot;&gt;The CFS Logic:&lt;/b&gt; The &quot;Completely Fair Scheduler&quot; tries to give every process a fair slice of the CPU&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="910" y="740" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-5" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;4,1,0&quot;&gt;The &quot;Fairness&quot; calculation:&lt;/b&gt; It tracks how much time each process has spent on the CPU. Processes that have had &lt;b&gt;&lt;i data-index-in-node=&quot;111&quot; data-path-to-node=&quot;4,1,0&quot;&gt;less&lt;/i&gt; &lt;/b&gt;time get higher priority for the next available cycle." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="910" y="862" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-7" target="EOVEU-vpQ8RlKc4mFksw-9" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-7" value="In a &quot;&lt;b&gt;&lt;u&gt;noisy neighbor&lt;/u&gt;&lt;/b&gt;&quot; scenario where three pods are fighting for a single CPU core, Kubernetes uses &lt;b data-index-in-node=&quot;100&quot; data-path-to-node=&quot;7&quot;&gt;CPU Shares&lt;/b&gt; (derived from your &lt;code data-index-in-node=&quot;130&quot; data-path-to-node=&quot;7&quot;&gt;requests&lt;/code&gt;) to decide who wins." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="530" y="1050" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-9" target="EOVEU-vpQ8RlKc4mFksw-11" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-9" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;8,0,0&quot;&gt;Requests = Priority:&lt;/b&gt; Your &lt;code data-index-in-node=&quot;26&quot; data-path-to-node=&quot;8,0,0&quot;&gt;cpu: 1000m&lt;/code&gt; request is converted into &lt;b data-index-in-node=&quot;63&quot; data-path-to-node=&quot;8,0,0&quot;&gt;1024 shares&lt;/b&gt;.&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="920" y="970" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-11" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1400" y="1000" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-11" value="A &lt;code data-index-in-node=&quot;78&quot; data-path-to-node=&quot;8,0,0&quot;&gt;500m&lt;/code&gt; request becomes &lt;b data-index-in-node=&quot;99&quot; data-path-to-node=&quot;8,0,0&quot;&gt;512 shares&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1220" y="970" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-15" target="EOVEU-vpQ8RlKc4mFksw-16" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-15" target="EOVEU-vpQ8RlKc4mFksw-18" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-15" value="If the CPU is 100% busy:" style="ellipse;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1400" y="960" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-16" value="The &lt;b data-index-in-node=&quot;4&quot; data-path-to-node=&quot;8,1,1,0,0&quot;&gt;Web Service&lt;/b&gt; (1024 shares) is guaranteed &lt;b data-index-in-node=&quot;44&quot; data-path-to-node=&quot;8,1,1,0,0&quot;&gt;2/3&lt;/b&gt; of the CPU time." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1530" y="922" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-18" value="The &lt;b data-index-in-node=&quot;4&quot; data-path-to-node=&quot;8,1,1,1,0&quot;&gt;Batch Job&lt;/b&gt; (512 shares) is guaranteed &lt;b data-index-in-node=&quot;41&quot; data-path-to-node=&quot;8,1,1,1,0&quot;&gt;1/3&lt;/b&gt; of the CPU time" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1530" y="1030" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-20" target="EOVEU-vpQ8RlKc4mFksw-22" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1760" y="1000" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-20" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1680" y="940" width="20" height="120" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-22" value="If the Web Service is idle, the Batch Job can &quot;&lt;b&gt;steal&lt;/b&gt;&quot; the unused CPU. But the moment the Web Service wakes up, the Batch Job is compressed back down to its 1/3 share." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1740" y="970" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-23" target="EOVEU-vpQ8RlKc4mFksw-26" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="960" y="1280" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-23" target="EOVEU-vpQ8RlKc4mFksw-29" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-23" target="EOVEU-vpQ8RlKc4mFksw-34" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="950" y="1280" />
              <mxPoint x="950" y="1870" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-23" value="&lt;b&gt;&lt;u&gt;Throttling&lt;/u&gt;&lt;/b&gt;: The 100ms Quota Window:&lt;br&gt;&lt;u&gt;&lt;b&gt;Throttling &lt;/b&gt;&lt;/u&gt;is the &quot;speed limit&quot; enforced by the kernel. It works on a &lt;b data-index-in-node=&quot;70&quot; data-path-to-node=&quot;11&quot;&gt;100ms period&lt;/b&gt; by default." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="540" y="1250" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-26" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1270" y="1280" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-26" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;12,0&quot;&gt;Example:&lt;/b&gt; You have a &lt;code data-index-in-node=&quot;20&quot; data-path-to-node=&quot;12,0&quot;&gt;limit&lt;/code&gt; of 0.5 CPU (500m). This gives you &lt;b data-index-in-node=&quot;60&quot; data-path-to-node=&quot;12,0&quot;&gt;50ms&lt;/b&gt; of execution time every &lt;b data-index-in-node=&quot;89&quot; data-path-to-node=&quot;12,0&quot;&gt;100ms&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="975" y="1250" width="235" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-28" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1300" y="1167" width="470" height="249.51" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-29" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1440" y="1550" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-29" value="The &lt;b&gt;Sprint&lt;/b&gt;: If your app is multi-threaded and uses all 50ms in the &lt;b&gt;first 10ms&lt;/b&gt; of the window, it is instantly frozen for the remaining 90ms." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1000" y="1520" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-32" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1454" y="1470" width="620" height="327" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-34" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1350" y="1870" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-34" value="The Wait: Even if the physical CPU on the node is 90% idle, your app cannot run until the next 100ms window starts." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1030" y="1840" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-37" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1340" y="1797" width="520" height="289.32" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-38" target="EOVEU-vpQ8RlKc4mFksw-40" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-38" target="EOVEU-vpQ8RlKc4mFksw-41" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-38" value="The Impact: Latency Jitter:&lt;br&gt;Because &lt;b&gt;throttling &lt;/b&gt;stops and starts your app in tiny bursts, it creates &quot;&lt;b&gt;Jitter&lt;/b&gt;&quot;—inconsistent response times." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="540" y="2170" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-40" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;17,1,0,0&quot;&gt;Normal:&lt;br&gt;&lt;/b&gt;&lt;span data-path-to-node=&quot;17,1,1,0&quot;&gt;Request finishes in &lt;b data-index-in-node=&quot;20&quot; data-path-to-node=&quot;17,1,1,0&quot;&gt;10ms&lt;/b&gt;.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="990" y="2120" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;flowAnimation=1;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-41" target="EOVEU-vpQ8RlKc4mFksw-48" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-41" value="Throttled: &lt;br&gt;App is frozen mid-calculation. Request takes ~100ms (10ms work + ~90ms wait)." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="990" y="2540" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-44" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1890" y="2160" width="20" height="490" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-45" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;17,3,0,0&quot;&gt;Result:&lt;br&gt;&lt;/b&gt;&lt;span data-path-to-node=&quot;17,3,1,0&quot;&gt;Your &quot;&lt;b&gt;Average Latency&lt;/b&gt;&quot; might look okay, but your &lt;b data-index-in-node=&quot;49&quot; data-path-to-node=&quot;17,3,1,0&quot;&gt;P99 Latency&lt;/b&gt; (the worst cases) will spike wildly.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1930" y="2380" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-46" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1360" y="2160" width="423" height="250.73" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-47" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=-0.007;entryY=0.362;entryDx=0;entryDy=0;entryPerimeter=0;flowAnimation=1;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-40" target="EOVEU-vpQ8RlKc4mFksw-46" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-48" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1350" y="2460" width="456" height="198.7" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-50" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1920" y="2450" width="920" height="270.81" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-51" target="EOVEU-vpQ8RlKc4mFksw-52" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-51" target="EOVEU-vpQ8RlKc4mFksw-54" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-51" target="EOVEU-vpQ8RlKc4mFksw-72" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-51" value="CPU Kernel vs Kubernetes Request and Limits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;" parent="1" vertex="1">
          <mxGeometry x="260" y="2940" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-52" value="The Linux Kernel is the &lt;b data-index-in-node=&quot;82&quot; data-path-to-node=&quot;1&quot;&gt;&lt;u&gt;Enforcer&lt;/u&gt;&lt;/b&gt;, but Kubernetes is the &lt;b data-index-in-node=&quot;114&quot; data-path-to-node=&quot;1&quot;&gt;&lt;u&gt;Policy Maker&lt;/u&gt;&lt;/b&gt;&lt;u&gt; &lt;/u&gt;that tells the enforcer who is important." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="690" y="2880" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-54" target="EOVEU-vpQ8RlKc4mFksw-56" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-54" value="The Linux Kernel has no idea what a &quot;Kubernetes Pod&quot; or &quot;100m CPU&quot; is" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="700" y="3000" width="430" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-56" value="&lt;span data-index-in-node=&quot;91&quot; data-path-to-node=&quot;4&quot;&gt;Kernel only understands&lt;/span&gt;&lt;b data-index-in-node=&quot;91&quot; data-path-to-node=&quot;4&quot;&gt; Control Groups (cgroups)&lt;/b&gt; and &lt;b data-index-in-node=&quot;120&quot; data-path-to-node=&quot;4&quot;&gt;CPU Shares&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1210" y="3000" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-58" target="EOVEU-vpQ8RlKc4mFksw-60" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1210" y="3150" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-58" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;5,0,0&quot;&gt;In Kubernetes (The policy maker):&lt;/b&gt; You write &lt;code data-index-in-node=&quot;36&quot; data-path-to-node=&quot;5,0,0&quot;&gt;cpu: 250m&lt;/code&gt; in your YAML." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="700" y="3120" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-60" target="EOVEU-vpQ8RlKc4mFksw-62" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-60" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;5,1,0&quot;&gt;he Handshake:&lt;/b&gt; The Kubelet takes that number and translates it for the Kernel." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1220" y="3120" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-66" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-62" target="EOVEU-vpQ8RlKc4mFksw-65" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-62" target="EOVEU-vpQ8RlKc4mFksw-67" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-62" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;5,2,0&quot;&gt;The Linux Kernel (The Enforcer):&lt;/b&gt; It sets a value in a file called &lt;code data-index-in-node=&quot;66&quot; data-path-to-node=&quot;5,2,0&quot;&gt;cpu.shares&lt;/code&gt;. By default, &lt;b data-index-in-node=&quot;90&quot; data-path-to-node=&quot;5,2,0&quot;&gt;1000m (1 core) = 1024 shares&lt;/b&gt;&lt;span class=&quot;citation-5 citation-end-5&quot;&gt;.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1500" y="3120" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-65" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;9,0,0&quot;&gt;If Node is Idle.&lt;/b&gt; If your pod has a request of &lt;code data-index-in-node=&quot;59&quot; data-path-to-node=&quot;9,0,0&quot;&gt;100m&lt;/code&gt; but it’s the &lt;b&gt;only &lt;/b&gt;thing running, the Kernel lets it use &lt;b data-index-in-node=&quot;120&quot; data-path-to-node=&quot;9,0,0&quot;&gt;100% of the CPU&lt;/b&gt;. The &quot;request&quot; doesn't act as a cage here." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1890" y="3060" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-67" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;9,1,0&quot;&gt;&amp;nbsp;If&amp;nbsp; Node is Exploding (Contention).&lt;/b&gt; If five pods all want 100% of the CPU at the same time, the Kernel looks at the &lt;code data-index-in-node=&quot;128&quot; data-path-to-node=&quot;9,1,0&quot;&gt;cpu.shares&lt;/code&gt;." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1900" y="3180" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-69" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="2200" y="3060" width="20" height="160" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-83" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;flowAnimation=1;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-70" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2550" y="3140" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-70" value="If Pod A has &lt;code data-index-in-node=&quot;13&quot; data-path-to-node=&quot;9,1,1,0,0&quot;&gt;1000m&lt;/code&gt; (1024 shares) and Pod B has &lt;code data-index-in-node=&quot;47&quot; data-path-to-node=&quot;9,1,1,0,0&quot;&gt;100m&lt;/code&gt; (102 shares), the Kernel will ensure Pod A gets &lt;b data-index-in-node=&quot;100&quot; data-path-to-node=&quot;9,1,1,0,0&quot;&gt;10x more time&lt;/b&gt; than Pod B." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="2240" y="3110" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-71" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.617;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-51" target="EOVEU-vpQ8RlKc4mFksw-58" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-74" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-72" target="EOVEU-vpQ8RlKc4mFksw-75" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1210" y="3250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-72" target="EOVEU-vpQ8RlKc4mFksw-76" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-72" value="There is one thing the Linux Kernel &lt;b data-index-in-node=&quot;36&quot; data-path-to-node=&quot;13&quot;&gt;cannot&lt;/b&gt; do: it can't prevent a node from getting too crowded. This is the primary job of Kubernetes." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="700" y="3240" width="450" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-75" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;14,0,0&quot;&gt;Admission Control:&lt;/b&gt; When you set a &lt;code data-index-in-node=&quot;34&quot; data-path-to-node=&quot;14,0,0&quot;&gt;&lt;u&gt;request&lt;/u&gt;&lt;/code&gt;&lt;span class=&quot;citation-4&quot;&gt;, the Kubernetes &lt;/span&gt;&lt;b data-index-in-node=&quot;58&quot; data-path-to-node=&quot;14,0,0&quot;&gt;Scheduler&lt;/b&gt;&lt;span class=&quot;citation-4 citation-end-4&quot;&gt; uses it as a &quot;reservation.&quot;&lt;sup data-turn-source-index=&quot;2&quot; class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt; If a node has 4 cores and you've already scheduled pods requesting 3.8 cores, the Scheduler will refuse to put any more pods there." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1250" y="3220" width="430" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-76" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;14,1,0&quot;&gt;The Consequence:&lt;/b&gt; If you didn't set requests, the Scheduler might pack 100 pods onto a single node. The Linux Kernel would try its best to be &quot;fair,&quot; but each pod would only get 1% of the CPU, causing your entire application to crawl." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1250" y="3330" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-79" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1629" y="2740" width="542" height="297.17" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-80" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.065;entryY=1.01;entryDx=0;entryDy=0;entryPerimeter=0;flowAnimation=1;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-62" target="EOVEU-vpQ8RlKc4mFksw-79" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-82" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="2569.5" y="2927" width="681" height="373.42" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-86" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;flowAnimation=1;" parent="1" source="EOVEU-vpQ8RlKc4mFksw-84" target="EOVEU-vpQ8RlKc4mFksw-85" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-84" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1710" y="3230" width="20" height="180" as="geometry" />
        </mxCell>
        <mxCell id="EOVEU-vpQ8RlKc4mFksw-85" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1851.5" y="3260" width="773.13" height="420" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="P6PjidktPw4E1j3IoQRz-1" target="P6PjidktPw4E1j3IoQRz-4" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-1" target="P6PjidktPw4E1j3IoQRz-12" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-1" target="P6PjidktPw4E1j3IoQRz-21" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-1" value="Layer 2 - Memory (Non-Compressible Resource)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3c800;fontColor=#000000;strokeColor=#B09500;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="100" y="3720" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-2" value="While CPU can be &quot;stretched&quot; by slowing down (throttling), memory is binary" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="580" y="3660" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=-0.026;entryY=0.567;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-1" target="P6PjidktPw4E1j3IoQRz-2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="P6PjidktPw4E1j3IoQRz-4" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="890" y="3810" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-4" value="&amp;nbsp;If you exceed your limit (or the node runs out), someone must &lt;b data-index-in-node=&quot;70&quot; data-path-to-node=&quot;4,1,0&quot;&gt;die&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="590" y="3780" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-7" target="P6PjidktPw4E1j3IoQRz-8" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-7" target="P6PjidktPw4E1j3IoQRz-10" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-7" value="When memory is exhausted, the Linux Kernel invokes the &lt;b data-index-in-node=&quot;55&quot; data-path-to-node=&quot;7&quot;&gt;OOM Killer&lt;/b&gt;.&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="890" y="3780" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-8" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;8,0,0&quot;&gt;Container Level:&lt;/b&gt; If a container exceeds its own &lt;code data-index-in-node=&quot;48&quot; data-path-to-node=&quot;8,0,0&quot;&gt;&lt;u&gt;limit&lt;/u&gt;&lt;/code&gt;, the Kernel kills the processes &lt;i data-index-in-node=&quot;86&quot; data-path-to-node=&quot;8,0,0&quot;&gt;inside&lt;/i&gt; that container." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1220" y="3710" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-10" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;8,1,0&quot;&gt;Node Level:&lt;/b&gt; If the entire server &lt;u&gt;runs out of memory&lt;/u&gt; (even if no single pod hit its limit), the Kernel looks at every process on the node and picks a &quot;victim&quot; to kill." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1230" y="3850" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-12" target="P6PjidktPw4E1j3IoQRz-14" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-12" target="P6PjidktPw4E1j3IoQRz-16" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-12" value="Kubernetes assigns every Pod a &lt;b data-index-in-node=&quot;31&quot; data-path-to-node=&quot;11&quot;&gt;Quality of Service (QoS)&lt;/b&gt; class based on your &lt;code data-index-in-node=&quot;76&quot; data-path-to-node=&quot;11&quot;&gt;requests&lt;/code&gt; and &lt;code data-index-in-node=&quot;89&quot; data-path-to-node=&quot;11&quot;&gt;limits&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="600" y="3930" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-14" value="BestEffort--&amp;gt;&amp;nbsp;Highest eviction risk&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="940" y="3910" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-16" value="Burstable--&amp;gt;&amp;nbsp;Medium eviction risk&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="945" y="4010" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-18" value="Guaranteed --&amp;gt; &amp;gt;&amp;nbsp;Lowest eviction risk&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="950" y="4120" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.025;entryY=0.617;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="834" y="3960" as="sourcePoint" />
            <mxPoint x="957" y="4157.02" as="targetPoint" />
            <Array as="points">
              <mxPoint x="884" y="3960" />
              <mxPoint x="884" y="4157" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-21" target="P6PjidktPw4E1j3IoQRz-23" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-21" target="P6PjidktPw4E1j3IoQRz-27" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-21" target="P6PjidktPw4E1j3IoQRz-31" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-21" target="P6PjidktPw4E1j3IoQRz-37" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-21" value="Scoreboard:&amp;nbsp;oom_score_adj" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="610" y="4270" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="P6PjidktPw4E1j3IoQRz-23" target="P6PjidktPw4E1j3IoQRz-26" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1260" y="4250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-23" value="To tell the Linux Kernel which pods are important, the Kubelet assigns an &lt;b data-index-in-node=&quot;74&quot; data-path-to-node=&quot;15&quot;&gt;OOM Score Adjustment&lt;/b&gt; to every process" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="900" y="4220" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-26" value="A higher score means you are more likely to be killed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e51400;fontColor=#ffffff;strokeColor=#B20000;" parent="1" vertex="1">
          <mxGeometry x="1220" y="4220" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="P6PjidktPw4E1j3IoQRz-27" target="P6PjidktPw4E1j3IoQRz-30" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1100" y="4370" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-27" value="BestEffort--&amp;gt;&amp;nbsp;Highest eviction risk&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="910" y="4340" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-30" value="Gets a score of &lt;b data-index-in-node=&quot;28&quot; data-path-to-node=&quot;16,0,0&quot;&gt;1000&lt;/b&gt;. (Kill me first)." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1080" y="4340" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="P6PjidktPw4E1j3IoQRz-31" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1080" y="4450" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-31" value="Burstable--&amp;gt;&amp;nbsp;Medium eviction risk&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="910" y="4420" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-34" value="Score = 1000 - 1000 x (memory request / node memory): bigger request = safer" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1085" y="4430" width="120" height="69.1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="P6PjidktPw4E1j3IoQRz-37" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1090" y="4550" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-37" value="Guaranteed --&amp;gt; &amp;gt;&amp;nbsp;Lowest eviction risk&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="910" y="4520" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-40" value="Gets a score of &lt;b data-index-in-node=&quot;28&quot; data-path-to-node=&quot;16,1,0&quot;&gt;-997&lt;/b&gt;. (Do not kill me)." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1090" y="4520" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-41" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1230" y="4330" width="20" height="250" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-42" target="P6PjidktPw4E1j3IoQRz-43" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="P6PjidktPw4E1j3IoQRz-42" target="P6PjidktPw4E1j3IoQRz-45" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-42" value="Within the same QoS class (e.g., two Burstable pods), kubelet eviction picks the pod exceeding its memory request by the most." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1265" y="4430" width="245" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-43" value="&lt;b data-index-in-node=&quot;11&quot; data-path-to-node=&quot;18&quot;&gt;Pod A:&lt;/b&gt; Requested 100Mi, using 150Mi (&lt;b data-index-in-node=&quot;48&quot; data-path-to-node=&quot;18&quot;&gt;+50Mi over&lt;/b&gt;)." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1570" y="4380" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-45" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;19,0,0&quot;&gt;Pod B:&lt;/b&gt; Requested 500Mi, using 510Mi (&lt;b data-index-in-node=&quot;37&quot; data-path-to-node=&quot;19,0,0&quot;&gt;+10Mi over&lt;/b&gt;)." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1570" y="4480" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-47" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1720" y="4380" width="20" height="160" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-48" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;19,1,0&quot;&gt;Result:&lt;/b&gt; Pod A dies first, even though it is using way less total memory than Pod B." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1750" y="4430" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-49" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1517.31" y="3690" width="382.69" height="220" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-50" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1100" y="3930" width="462.58" height="250" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-51" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1897.5" y="4330" width="495" height="267.79" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-52" target="P6PjidktPw4E1j3IoQRz-53" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-52" target="P6PjidktPw4E1j3IoQRz-55" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-52" target="P6PjidktPw4E1j3IoQRz-57" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-52" target="P6PjidktPw4E1j3IoQRz-62" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-52" target="P6PjidktPw4E1j3IoQRz-66" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-52" target="P6PjidktPw4E1j3IoQRz-72" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-83" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-52" target="P6PjidktPw4E1j3IoQRz-82" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-52" value="Layer 3 - Network (Unmanaged Resource)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3c800;fontColor=#000000;strokeColor=#B09500;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="140" y="4770" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-53" value="is fundamentally different from CPU or Memory because, in a standard Kubernetes setup, it is an &lt;b data-index-in-node=&quot;143&quot; data-path-to-node=&quot;0&quot;&gt;Unmanaged Resource&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="590" y="4690" width="410" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-55" value="K8s&amp;nbsp;treats the network like an &quot;all-you-can-eat&quot; buffet, which can lead to significant stability issues." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="590" y="4790" width="410" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-57" target="P6PjidktPw4E1j3IoQRz-60" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-57" value="Wild West: Unmanaged Bandwidth" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="590" y="4910" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-88" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;flowAnimation=1;" parent="1" source="P6PjidktPw4E1j3IoQRz-60" target="P6PjidktPw4E1j3IoQRz-87" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-60" value="By default, Kubernetes has no built-in concept of &lt;code data-index-in-node=&quot;50&quot; data-path-to-node=&quot;4&quot;&gt;network-requests&lt;/code&gt; or &lt;code data-index-in-node=&quot;70&quot; data-path-to-node=&quot;4&quot;&gt;network-limits&lt;/code&gt; in the Pod spec." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="860" y="4910" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-62" target="P6PjidktPw4E1j3IoQRz-64" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-62" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;5,0,0&quot;&gt;The Problem:&lt;/b&gt; If you have a high-traffic API pod and a backup-sync pod on the same node, the backup pod could suddenly start a 10Gbps transfer." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="600" y="5020" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-64" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;5,1,0&quot;&gt;The Result:&lt;/b&gt; It will saturate the node's physical Network Interface Card (NIC). Your API pod's latency will spike, or it might start dropping connections entirely, even though its CPU and Memory usage look perfectly normal." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1160" y="5020" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="P6PjidktPw4E1j3IoQRz-66" target="P6PjidktPw4E1j3IoQRz-69" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="900" y="5160" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-71" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-66" target="P6PjidktPw4E1j3IoQRz-70" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-66" value="The &quot;Noisy Neighbor&quot; Effect" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="600" y="5130" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-69" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;9,0,0&quot;&gt;Shared Fate:&lt;/b&gt; Every pod on that node shares the same &quot;pipe&quot; to the outside world." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="930" y="5100" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-70" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;9,1,0&quot;&gt;Silent Failures:&lt;/b&gt; Most monitoring tools focus on Pod-level metrics. You might see your application failing but not realize it's because a completely unrelated Pod in a different namespace is hogging the node's bandwidth." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="940" y="5210" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="P6PjidktPw4E1j3IoQRz-72" target="P6PjidktPw4E1j3IoQRz-74" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-72" target="P6PjidktPw4E1j3IoQRz-76" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-72" value=" Solutions: Taming the Traffic" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="605" y="5330" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-74" value="A. Linux &lt;code data-index-in-node=&quot;9&quot; data-path-to-node=&quot;13&quot;&gt;tc&lt;/code&gt; (Traffic Control)" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="890" y="5330" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="P6PjidktPw4E1j3IoQRz-76" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1100" y="5460" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-76" value="B. CNI Bandwidth Plugins" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="900" y="5430" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-81" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;flowAnimation=1;" parent="1" source="P6PjidktPw4E1j3IoQRz-79" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1430" y="5460" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-90" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;flowAnimation=1;" parent="1" source="P6PjidktPw4E1j3IoQRz-79" target="P6PjidktPw4E1j3IoQRz-89" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1400" y="5460" />
              <mxPoint x="1400" y="5768" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-79" value="Most modern &lt;b data-index-in-node=&quot;12&quot; data-path-to-node=&quot;16&quot;&gt;CNIs&lt;/b&gt; (Container Network Interfaces) like Calico, Cilium, or the standard bandwidth plugin allow you to use &lt;b data-index-in-node=&quot;119&quot; data-path-to-node=&quot;16&quot;&gt;Annotations&lt;/b&gt; in your Pod YAML to set limits" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1110" y="5430" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-80" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1448" y="5385.5" width="504" height="149" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-84" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="P6PjidktPw4E1j3IoQRz-82" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="910" y="5660" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-82" value=" Architecture Tip: The &quot;EKS Benefit&quot;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="600" y="5630" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-85" value="certain instance types (like the &lt;code data-index-in-node=&quot;64&quot; data-path-to-node=&quot;23&quot;&gt;m5n&lt;/code&gt; or &lt;code data-index-in-node=&quot;71&quot; data-path-to-node=&quot;23&quot;&gt;c5n&lt;/code&gt; variants) have dedicated &quot;Network Cards&quot; for EBS and standard traffic. This prevents your database's disk I/O (EBS) from fighting with your user traffic for the same bandwidth!" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="930" y="5630" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-86" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="558.5" y="5750" width="783" height="235" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-87" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1146.5" y="4750" width="383.5" height="240.89" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-89" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1468.5" y="5580" width="603" height="376" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-93" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-91" target="P6PjidktPw4E1j3IoQRz-92" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-98" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-91" target="P6PjidktPw4E1j3IoQRz-97" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="510" y="6280" />
              <mxPoint x="510" y="6340" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-110" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-91" target="P6PjidktPw4E1j3IoQRz-109" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="510" y="6280" />
              <mxPoint x="510" y="6625" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-118" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-91" target="P6PjidktPw4E1j3IoQRz-117" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="510" y="6280" />
              <mxPoint x="510" y="6940" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-129" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-91" target="P6PjidktPw4E1j3IoQRz-128" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="510" y="6280" />
              <mxPoint x="510" y="7660" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-91" value="Layer 4 - Storage I/O (Unmanaged Resource)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3c800;fontColor=#000000;strokeColor=#B09500;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="100" y="6250" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-95" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-92" target="P6PjidktPw4E1j3IoQRz-94" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-92" value="&lt;b data-index-in-node=&quot;18&quot; data-path-to-node=&quot;0&quot;&gt;Storage I/O&lt;/b&gt;, is very similar to the Network layer we just discussed: it is an &lt;b data-index-in-node=&quot;96&quot; data-path-to-node=&quot;0&quot;&gt;Unmanaged Resource&lt;/b&gt; at the container level.&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="559" y="6160" width="441" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-94" value="While AWS provides a &quot;speed limit&quot; for the &lt;b&gt;entire &lt;/b&gt;EBS volume, Kubernetes does not have a native way to say,&amp;nbsp;&lt;i style=&quot;border-color: var(--border-color);&quot; data-index-in-node=&quot;247&quot; data-path-to-node=&quot;0&quot;&gt;&quot;Pod A gets 80% of the disk speed, and Pod B gets 20%.&quot;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1070" y="6160" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-96" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1480" y="6224" width="690" height="375.6" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-100" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="P6PjidktPw4E1j3IoQRz-97" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="6340" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-97" value="Per-Volume vs. Per-Container Mismatch" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="580" y="6310" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-102" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-99" target="P6PjidktPw4E1j3IoQRz-101" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-104" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-99" target="P6PjidktPw4E1j3IoQRz-103" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-99" value="In AWS, you pay for a specific amount of &quot;performance&quot; for your EBS volume (e.g., 3,000 IOPS for a &lt;code data-index-in-node=&quot;99&quot; data-path-to-node=&quot;3&quot;&gt;gp3&lt;/code&gt; volume)." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="780" y="6310" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-107" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.25;entryDx=0;entryDy=0;flowAnimation=1;" parent="1" source="P6PjidktPw4E1j3IoQRz-101" target="P6PjidktPw4E1j3IoQRz-96" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-101" value="AWS only sees the &lt;b data-index-in-node=&quot;32&quot; data-path-to-node=&quot;4,0,0&quot;&gt;EBS Volume&lt;/b&gt;. It doesn't care if one pod or ten pods are using it. If the volume hits its 3,000 IOPS limit, AWS throttles the &lt;i data-index-in-node=&quot;156&quot; data-path-to-node=&quot;4,0,0&quot;&gt;entire disk&lt;/i&gt;." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1120" y="6250" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-108" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;flowAnimation=1;" parent="1" source="P6PjidktPw4E1j3IoQRz-103" target="P6PjidktPw4E1j3IoQRz-96" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-103" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;4,1,0&quot;&gt;The Kubernetes :&lt;/b&gt; Multiple pods might be sharing that same volume (if using &lt;code data-index-in-node=&quot;82&quot; data-path-to-node=&quot;4,1,0&quot;&gt;&lt;b&gt;&lt;font color=&quot;#cc0066&quot;&gt;ReadWriteMany&lt;/font&gt;&lt;/b&gt;&lt;/code&gt; or &lt;b&gt;local disks&lt;/b&gt;) or sharing the same &lt;b data-index-in-node=&quot;132&quot; data-path-to-node=&quot;4,1,0&quot;&gt;Node's IO bandwidth&lt;/b&gt; (throughput to the EBS service)." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1120" y="6381.8" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-105" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;rotation=-90;" parent="1" vertex="1">
          <mxGeometry x="1810" y="6270" width="20" height="700" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-106" value="A background &quot;&lt;b&gt;Log Archiver&lt;/b&gt;&quot; pod could start a massive disk read, consuming all 3,000 IOPS. Your &quot;Production Database&quot; pod on the &lt;br&gt;same disk will suddenly see its disk latency jump from 1ms to 200ms, even though the database itself isn't doing anything wrong." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1450" y="6640" width="730" height="40" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-112" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="P6PjidktPw4E1j3IoQRz-109" target="P6PjidktPw4E1j3IoQRz-111" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-114" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-109" target="P6PjidktPw4E1j3IoQRz-113" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-116" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-109" target="P6PjidktPw4E1j3IoQRz-115" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="760" y="6610" />
              <mxPoint x="760" y="6820" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-109" value="The Missing Controller: &lt;code data-index-in-node=&quot;27&quot; data-path-to-node=&quot;6&quot;&gt;&lt;b&gt;&lt;font color=&quot;#cc0066&quot;&gt;blkio&lt;/font&gt;&lt;/b&gt;&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="600" y="6580" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-131" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;flowAnimation=1;" parent="1" source="P6PjidktPw4E1j3IoQRz-111" target="P6PjidktPw4E1j3IoQRz-130" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-111" value="In the Linux Kernel, there is a tool specifically for this called the &lt;b data-index-in-node=&quot;70&quot; data-path-to-node=&quot;7&quot;&gt;&lt;code data-index-in-node=&quot;70&quot; data-path-to-node=&quot;7&quot;&gt;blkio&lt;/code&gt; (Block I/O) cgroup controller&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="780" y="6580" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-132" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;flowAnimation=1;" parent="1" source="P6PjidktPw4E1j3IoQRz-113" target="P6PjidktPw4E1j3IoQRz-130" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-113" value="It can set &quot;&lt;b&gt;Weights&lt;/b&gt;&quot; (who is more important) or &quot;&lt;b&gt;Limits&lt;/b&gt;&quot; (max bytes per second) for specific processes accessing a disk." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="790" y="6680" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-115" value="Kubernetes natively exposes CPU and Memory via the Pod Spec, but it &lt;b data-index-in-node=&quot;81&quot; data-path-to-node=&quot;8,1,0&quot;&gt;does not&lt;/b&gt; expose &lt;code data-index-in-node=&quot;97&quot; data-path-to-node=&quot;8,1,0&quot;&gt;&lt;b&gt;&lt;font color=&quot;#67ab9f&quot;&gt;blkio&lt;/font&gt;&lt;/b&gt;&lt;/code&gt;. There is no &lt;code data-index-in-node=&quot;116&quot; data-path-to-node=&quot;8,1,0&quot;&gt;&lt;b&gt;&lt;font color=&quot;#67ab9f&quot;&gt;resources.limits.iops&lt;/font&gt;&lt;/b&gt;&lt;/code&gt; field in a standard Kubernetes YAML." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="800" y="6790" width="390" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-120" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="P6PjidktPw4E1j3IoQRz-117" target="P6PjidktPw4E1j3IoQRz-119" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-123" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-117" target="P6PjidktPw4E1j3IoQRz-122" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-125" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-117" target="P6PjidktPw4E1j3IoQRz-124" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-127" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-117" target="P6PjidktPw4E1j3IoQRz-126" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-117" value="The Consequences of Unmanaged I/O" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="620" y="6910" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-119" value="When a disk is saturated, it creates a &quot;blocking&quot; effect that can ripple through your entire application" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="820" y="6910" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-122" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;12,0,0&quot;&gt;I/O Wait ($iowait):&lt;/b&gt; The CPU becomes idle because it's waiting for the disk to finish a task. This makes your CPU metrics look low, but your application feels incredibly slow." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="825" y="6990" width="295" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-124" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;12,1,0&quot;&gt;Stuck Processes:&lt;/b&gt; If a process tries to write to a saturated disk, it enters an &quot;&lt;i&gt;Uninterruptible Sleep&lt;/i&gt;&quot; state (the &lt;b&gt;&lt;code data-index-in-node=&quot;114&quot; data-path-to-node=&quot;12,1,0&quot;&gt;D&lt;/code&gt; state in &lt;code data-index-in-node=&quot;125&quot; data-path-to-node=&quot;12,1,0&quot;&gt;top&lt;/code&gt;&lt;/b&gt;). You cannot kill these processes until the I/O completes." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="825" y="7080" width="295" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-126" value="&lt;b style=&quot;background-color: initial;&quot; data-index-in-node=&quot;0&quot; data-path-to-node=&quot;12,2,0&quot;&gt;Liveness Probe Failures:&lt;/b&gt;&lt;span style=&quot;background-color: initial;&quot;&gt; If your pod's health check requires writing a small temporary file (like a PID file) and the disk is too slow, the probe will fail, and Kubernetes will mistakenly restart your pod, making the problem worse.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="830" y="7190" width="390" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-137" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-128" target="P6PjidktPw4E1j3IoQRz-136" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-141" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-128" target="P6PjidktPw4E1j3IoQRz-140" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-143" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="P6PjidktPw4E1j3IoQRz-128" target="P6PjidktPw4E1j3IoQRz-142" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-128" value=" How to Fix It (The Hard Way)" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="645" y="7630" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-130" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1453" y="6710" width="707" height="383.87" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-133" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1360" y="7100" width="989" height="519.63" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-134" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1220" y="6930" width="20" height="350" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-135" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=-0.001;entryY=0.162;entryDx=0;entryDy=0;entryPerimeter=0;flowAnimation=1;" parent="1" source="P6PjidktPw4E1j3IoQRz-134" target="P6PjidktPw4E1j3IoQRz-133" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-138" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="P6PjidktPw4E1j3IoQRz-136" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1200" y="7670" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-136" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;16,0,0&quot;&gt;Dedicated Volumes:&lt;/b&gt; The most common fix is to ensure every critical pod has its &lt;b data-index-in-node=&quot;79&quot; data-path-to-node=&quot;16,0,0&quot;&gt;own dedicated EBS volume&lt;/b&gt; (via a unique PVC)" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="855" y="7630" width="275" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-139" value="This ensures Pod A's disk usage physically cannot affect Pod B's disk performance." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1205" y="7640" width="195" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-140" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;16,1,0&quot;&gt;Static Guardrails:&lt;/b&gt; You can manually configure the &lt;code data-index-in-node=&quot;50&quot; data-path-to-node=&quot;16,1,0&quot;&gt;&lt;b&gt;&lt;font color=&quot;#67ab9f&quot;&gt;blkio&lt;/font&gt;&lt;/b&gt;&lt;/code&gt; cgroup on the worker nodes via a &lt;code data-index-in-node=&quot;89&quot; data-path-to-node=&quot;16,1,0&quot;&gt;DaemonSet&lt;/code&gt; or &lt;code data-index-in-node=&quot;102&quot; data-path-to-node=&quot;16,1,0&quot;&gt;KubeletConfiguration&lt;/code&gt; (Reserved System Resources), though this is complex to maintain." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="857.5" y="7790" width="472.5" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-142" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;16,2,0&quot;&gt;Instance Selection:&lt;/b&gt; Using AWS &lt;b data-index-in-node=&quot;30&quot; data-path-to-node=&quot;16,2,0&quot;&gt;&quot;EBS-Optimized&quot;&lt;/b&gt; instances ensures that disk traffic and network traffic don't fight over the same physical hardware &quot;pipe&quot; on the EC2 host." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="867.5" y="7940" width="275" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-144" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1420" y="7650" width="807" height="440.78" as="geometry" />
        </mxCell>
        <mxCell id="P6PjidktPw4E1j3IoQRz-145" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="2340" y="7669.719999999999" width="741" height="401.35" as="geometry" />
        </mxCell>
        <mxCell id="gdrQThUqVNjvpXIVj3o6-1" value="" style="shape=flexArrow;endArrow=classic;html=1;rounded=0;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1350" y="4250" as="sourcePoint" />
            <mxPoint x="1450" y="4250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="gdrQThUqVNjvpXIVj3o6-3" value="Do not mix this with Scheduling score that is&amp;nbsp;&lt;br&gt;about selecting the node for a Pod&lt;br&gt;as opposed to this score that is about killing a pod" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=#B20000;fillColor=#e51400;fontColor=#ffffff;" parent="1" vertex="1">
          <mxGeometry x="1453" y="4223" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="3V1FUeQJP8eJD5lT5xbC-1" value="" style="image;html=1;image=img/lib/clip_art/general/Star_128x128.png" parent="1" vertex="1">
          <mxGeometry x="1730" y="4180" width="80" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="iocdLCEpAAzyJjBbHm-Y" name="Challenges-1">
    <mxGraphModel dx="1036" dy="606" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hdUNLj1Yqol0iRYaaLiT-1" target="hdUNLj1Yqol0iRYaaLiT-3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hdUNLj1Yqol0iRYaaLiT-1" target="hdUNLj1Yqol0iRYaaLiT-5" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hdUNLj1Yqol0iRYaaLiT-1" target="hdUNLj1Yqol0iRYaaLiT-9" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-1" value="Volume Attachment Limit&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="160" y="170" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-3" value="Every EC2 instance has a hardware limit on how many EBS volumes it can physically &quot;plug in.&quot;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="370" y="90" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="hdUNLj1Yqol0iRYaaLiT-5" target="hdUNLj1Yqol0iRYaaLiT-8" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="650" y="220" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-5" value="On modern AWS &lt;b data-index-in-node=&quot;27&quot; data-path-to-node=&quot;5,0,0&quot;&gt;Nitro&lt;/b&gt; instances (like &lt;code data-index-in-node=&quot;49&quot; data-path-to-node=&quot;5,0,0&quot;&gt;m5&lt;/code&gt;, &lt;code data-index-in-node=&quot;53&quot; data-path-to-node=&quot;5,0,0&quot;&gt;c5&lt;/code&gt;, &lt;code data-index-in-node=&quot;57&quot; data-path-to-node=&quot;5,0,0&quot;&gt;r6i&lt;/code&gt;), the limit is typically &lt;b data-index-in-node=&quot;86&quot; data-path-to-node=&quot;5,0,0&quot;&gt;28 attachments&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="369" y="190" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-8" value="If you try to schedule 30 database pods on a single large node, the 29th and 30th pods will stay Pending with an error: &lt;b&gt;Volume node affinity conflict &lt;/b&gt;or &lt;b&gt;MaxVolumeCountExceeded.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="650" y="190" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-9" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;5,1,0&quot;&gt;The Fix:&lt;/b&gt; Use &lt;b data-index-in-node=&quot;13&quot; data-path-to-node=&quot;5,1,0&quot;&gt;Pod Anti-Affinity&lt;/b&gt; or &lt;b data-index-in-node=&quot;34&quot; data-path-to-node=&quot;5,1,0&quot;&gt;Topology Spread Constraints&lt;/b&gt; to force Kubernetes to spread those database pods across more nodes, even if the nodes have plenty of spare CPU/RAM." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="369" y="280" width="411" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hdUNLj1Yqol0iRYaaLiT-11" target="hdUNLj1Yqol0iRYaaLiT-12" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hdUNLj1Yqol0iRYaaLiT-11" target="hdUNLj1Yqol0iRYaaLiT-14" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hdUNLj1Yqol0iRYaaLiT-11" target="hdUNLj1Yqol0iRYaaLiT-20" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hdUNLj1Yqol0iRYaaLiT-11" target="hdUNLj1Yqol0iRYaaLiT-22" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-11" value="Pod Crashloop After Node Failure (The &quot;Stuck&quot; Volume)" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="60" y="540" width="210" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-12" value="When a worker node dies suddenly, AWS doesn't always realize the EBS volume is &quot;free.&quot;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="376" y="400" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="hdUNLj1Yqol0iRYaaLiT-14" target="hdUNLj1Yqol0iRYaaLiT-15" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-14" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;9,0,0&quot;&gt;The Problem:&lt;/b&gt; The volume stays in an &lt;code data-index-in-node=&quot;36&quot; data-path-to-node=&quot;9,0,0&quot;&gt;Attached&lt;/code&gt; state to the &lt;i data-index-in-node=&quot;58&quot; data-path-to-node=&quot;9,0,0&quot;&gt;dead&lt;/i&gt; node. When Kubernetes tries to start the pod on a &lt;i data-index-in-node=&quot;113&quot; data-path-to-node=&quot;9,0,0&quot;&gt;new&lt;/i&gt; healthy node, AWS refuses to move the disk because it thinks it’s still in use.&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="369" y="530" width="231" height="80" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-15" value="The pod enters a&amp;nbsp;&lt;code style=&quot;border-color: var(--border-color);&quot; data-index-in-node=&quot;214&quot; data-path-to-node=&quot;9,0,0&quot;&gt;CrashLoopBackOff&lt;/code&gt;&amp;nbsp;because it can't find its data." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="650" y="535" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-20" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;9,1,0&quot;&gt;The Fix:&lt;/b&gt; Often, you have to go to the &lt;b data-index-in-node=&quot;38&quot; data-path-to-node=&quot;9,1,0&quot;&gt;AWS Console&lt;/b&gt;, find the volume, and click &lt;b data-index-in-node=&quot;78&quot; data-path-to-node=&quot;9,1,0&quot;&gt;&quot;Force Detach.&quot;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="370" y="660" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-22" value="&amp;nbsp;&lt;b&gt;To prevent &lt;/b&gt;this, ensure your EBS CSI driver is up to date, as newer versions handle &quot;Multi-Attach&quot; or &quot;Node Unstage&quot; timeouts more gracefully." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="376" y="750" width="294" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hdUNLj1Yqol0iRYaaLiT-25" target="hdUNLj1Yqol0iRYaaLiT-26" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hdUNLj1Yqol0iRYaaLiT-25" target="hdUNLj1Yqol0iRYaaLiT-28" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hdUNLj1Yqol0iRYaaLiT-25" target="hdUNLj1Yqol0iRYaaLiT-30" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-25" value="Snapshot Restore in Wrong AZ" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="80" y="1050" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-26" value="EBS volumes are &quot;Regionally Resilient&quot; but &quot;AZ-Locked.&quot;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="390" y="860" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-28" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;13,0,0&quot;&gt;The Problem:&lt;/b&gt; If you manually restore a snapshot into &lt;code data-index-in-node=&quot;53&quot; data-path-to-node=&quot;13,0,0&quot;&gt;us-east-1a&lt;/code&gt;, but your high-performance database nodes are all in &lt;code data-index-in-node=&quot;117&quot; data-path-to-node=&quot;13,0,0&quot;&gt;us-east-1b&lt;/code&gt;, the pod will never start. Kubernetes cannot &quot;stretch&quot; a physical cable across data centers." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="390" y="970" width="410" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-30" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;13,1,0&quot;&gt;The Fix:&lt;/b&gt; When restoring a snapshot for a PVC, you must ensure the resulting volume is in the same AZ as your nodes. Using &lt;code data-index-in-node=&quot;122&quot; data-path-to-node=&quot;13,1,0&quot;&gt;volumeBindingMode: WaitForFirstConsumer&lt;/code&gt; in your &lt;code data-index-in-node=&quot;170&quot; data-path-to-node=&quot;13,1,0&quot;&gt;StorageClass&lt;/code&gt; helps automate this alignment during the first provisioning." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="390" y="1080" width="430" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hdUNLj1Yqol0iRYaaLiT-32" target="hdUNLj1Yqol0iRYaaLiT-33" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hdUNLj1Yqol0iRYaaLiT-32" target="hdUNLj1Yqol0iRYaaLiT-35" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-32" value="Filesystem Corruption after Forced Delete" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="70" y="1350" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-33" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;17,0,0&quot;&gt;The Problem:&lt;/b&gt; If you run &lt;code data-index-in-node=&quot;24&quot; data-path-to-node=&quot;17,0,0&quot;&gt;kubectl delete pod --force --grace-period=0&lt;/code&gt;, you are telling Linux to kill the process immediately without letting it close files or flush its cache. If the DB was mid-write, the filesystem metadata can become garbled." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="360" y="1220" width="520" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-35" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;17,1,0&quot;&gt;The Fix:&lt;/b&gt; &lt;b data-index-in-node=&quot;9&quot; data-path-to-node=&quot;17,1,0&quot;&gt;Never force-delete&lt;/b&gt; a database pod unless the node is already physically gone. If corruption happens, you must restore from your last known good snapshot and let the database &quot;replay&quot; its &lt;b data-index-in-node=&quot;196&quot; data-path-to-node=&quot;17,1,0&quot;&gt;Write-Ahead Log (WAL)&lt;/b&gt; to catch up to the last valid transaction." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="350" y="1420" width="530" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hdUNLj1Yqol0iRYaaLiT-37" target="hdUNLj1Yqol0iRYaaLiT-38" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hdUNLj1Yqol0iRYaaLiT-37" target="hdUNLj1Yqol0iRYaaLiT-40" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-37" value="IOPS Throttling (The Cascading Failure)" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="80" y="1670" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-38" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;21,0,0&quot;&gt;The Problem:&lt;/b&gt; &lt;code data-index-in-node=&quot;13&quot; data-path-to-node=&quot;21,0,0&quot;&gt;gp3&lt;/code&gt; volumes give you 3,000 IOPS for free. If your database suddenly needs 10,000 IOPS, AWS will &quot;throttle&quot; your disk. Latency goes from 1ms to 100ms+. This causes database connections to pile up, the connection pool fills, and the entire application crashes." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="350" y="1550" width="510" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-40" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;21,1,0&quot;&gt;The Fix:&lt;/b&gt; Monitor the &lt;b data-index-in-node=&quot;21&quot; data-path-to-node=&quot;21,1,0&quot;&gt;BurstBalance&lt;/b&gt; (for &lt;code data-index-in-node=&quot;39&quot; data-path-to-node=&quot;21,1,0&quot;&gt;gp2&lt;/code&gt;) or &lt;b data-index-in-node=&quot;47&quot; data-path-to-node=&quot;21,1,0&quot;&gt;VolumeThroughput/IOPS&lt;/b&gt; metrics in CloudWatch. For heavy databases, don't rely on the baseline—&lt;b data-index-in-node=&quot;140&quot; data-path-to-node=&quot;21,1,0&quot;&gt;provision&lt;/b&gt; the exact IOPS you need (e.g., set &lt;code data-index-in-node=&quot;185&quot; data-path-to-node=&quot;21,1,0&quot;&gt;iops: 10000&lt;/code&gt; in your &lt;code data-index-in-node=&quot;205&quot; data-path-to-node=&quot;21,1,0&quot;&gt;StorageClass&lt;/code&gt;)." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="360" y="1750" width="510" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="hdUNLj1Yqol0iRYaaLiT-42" target="hdUNLj1Yqol0iRYaaLiT-43" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hdUNLj1Yqol0iRYaaLiT-42" target="hdUNLj1Yqol0iRYaaLiT-45" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-42" value="Cross-AZ Data Transfer Costs" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="90" y="1930" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-43" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;25,0,0&quot;&gt;The Problem:&lt;/b&gt; A 3-node Kafka cluster in 3 different AZs replicates every message 3 times. If you ingest 100TB of data, that data crosses AZ boundaries twice (once to each replica). At scale, your &quot;networking&quot; bill can actually become higher than your &quot;compute&quot; bill." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="365" y="1870" width="510" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hdUNLj1Yqol0iRYaaLiT-45" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;25,1,0&quot;&gt;The Fix:&lt;/b&gt; &lt;br&gt;1.  &lt;b data-index-in-node=&quot;13&quot; data-path-to-node=&quot;25,1,0&quot;&gt;Compression:&lt;/b&gt; Use Zstd or Snappy to shrink the data before it leaves the node.&lt;br/&gt;&lt;br&gt;2.  &lt;b data-index-in-node=&quot;95&quot; data-path-to-node=&quot;25,1,0&quot;&gt;Rack Awareness:&lt;/b&gt; Configure Kafka/Cassandra with &quot;Rack Awareness&quot; so clients try to read from a replica in their &lt;i data-index-in-node=&quot;206&quot; data-path-to-node=&quot;25,1,0&quot;&gt;own&lt;/i&gt; AZ (free) rather than reaching across to another AZ (paid)." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="370" y="1980" width="510" height="90" as="geometry" />
        </mxCell>
        <mxCell id="vyx_iZ0hjX7KheSgQzId-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="vyx_iZ0hjX7KheSgQzId-1" target="vyx_iZ0hjX7KheSgQzId-2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vyx_iZ0hjX7KheSgQzId-1" value="Memory Leak in Batch Job" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="70" y="2200" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="vyx_iZ0hjX7KheSgQzId-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="vyx_iZ0hjX7KheSgQzId-2" target="vyx_iZ0hjX7KheSgQzId-5" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="880" y="2230" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="vyx_iZ0hjX7KheSgQzId-2" target="s3L59IFOvDij3QFSKCTg-10" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vyx_iZ0hjX7KheSgQzId-2" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;25,0,0&quot;&gt;The Problem:&lt;/b&gt; Batch job gradually consumes memory, eventually &lt;b&gt;OOMKilled&lt;/b&gt;. Since it's on a shared node, kubelet starts evicting other pods.&lt;br&gt;&lt;br&gt;Why: When a batch job (like an AI training script or a data processing worker) reads a 100GB dataset from a disk, the Linux kernel doesn't just read the data and forget it. It stores that data in &lt;b data-index-in-node=&quot;191&quot; data-path-to-node=&quot;4&quot;&gt;Page Cache&lt;/b&gt; (RAM) so that if the app needs to read the same file again, it’s lightning-fast." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="319.5" y="2170" width="510" height="120" as="geometry" />
        </mxCell>
        <mxCell id="vyx_iZ0hjX7KheSgQzId-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="vyx_iZ0hjX7KheSgQzId-5" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1280" y="2230" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="vyx_iZ0hjX7KheSgQzId-5" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;5,0,0&quot;&gt;The Problem:&lt;/b&gt; The kernel will keep filling up RAM with this cache until the node is nearly full." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="940" y="2200" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="vyx_iZ0hjX7KheSgQzId-6" target="s3L59IFOvDij3QFSKCTg-3" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1690" y="2230" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="vyx_iZ0hjX7KheSgQzId-6" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;5,1,0&quot;&gt;The Confusion:&lt;/b&gt; To the kernel, this memory is &quot;&lt;b&gt;available&lt;/b&gt;&quot; because it can be deleted instantly if a process needs it. But to &lt;b data-index-in-node=&quot;123&quot; data-path-to-node=&quot;5,1,0&quot;&gt;Kubernetes&lt;/b&gt;, parts of this cache are counted against your container's limit." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1290" y="2200" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-1" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1830" y="2300" width="547.94" height="300" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s3L59IFOvDij3QFSKCTg-3" target="s3L59IFOvDij3QFSKCTg-4" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-3" value="From k8s point of view:&amp;nbsp;&lt;br&gt;Kubernetes doesn't just look at &quot;Used RAM.&quot; It looks at the &lt;b data-index-in-node=&quot;60&quot; data-path-to-node=&quot;7&quot;&gt;Working Set Size (WSS)&lt;/b&gt;&lt;span class=&quot;citation-75 citation-end-75&quot;&gt;.&lt;sup data-turn-source-index=&quot;1&quot; class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt; This is the formula that usually triggers your OOMKills:&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1650" y="2200" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-4" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="2050" y="2199" width="710" height="61" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="s3L59IFOvDij3QFSKCTg-6" target="s3L59IFOvDij3QFSKCTg-9" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2695" y="2580" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-6" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;10&quot;&gt;The Trap:&lt;/b&gt; In AI/ML, you often loop over the same training data. The first time you read the file, it is &lt;b data-index-in-node=&quot;104&quot; data-path-to-node=&quot;10&quot;&gt;Inactive Cache&lt;/b&gt; (K8s ignores this). The second time you read it, the Kernel promotes it to &lt;b data-index-in-node=&quot;194&quot; data-path-to-node=&quot;10&quot;&gt;Active Cache&lt;/b&gt;. Suddenly, your &quot;Working Set&quot; spikes, and you hit your Kubernetes limit—even though that memory is technically just a copy of a file on disk." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="2470" y="2370" width="450" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.556;entryY=0.083;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="s3L59IFOvDij3QFSKCTg-4" target="s3L59IFOvDij3QFSKCTg-6" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-9" value="Why does the Kernel kill your pod if it knows the cache can be deleted? &lt;br&gt;Cgroup Limits: When you set a limit in YAML, K8s creates a &quot;Box&quot; (a cgroup) in the kernel. &lt;br&gt;The Trigger: When the memory charged to that &quot;Box&quot; hits the limit, the kernel must reclaim memory inside that cgroup before it can grant more. &lt;br&gt;The Race: The kernel tries to reclaim (drop) the cache, but if active cache plus RSS cannot be reclaimed fast enough, the kernel gives up and invokes the cgroup OOM Killer." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="2500" y="2550" width="390" height="240" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="s3L59IFOvDij3QFSKCTg-10" target="s3L59IFOvDij3QFSKCTg-12" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1145" y="2660" />
              <mxPoint x="1530" y="2660" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-10" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;5,0,0&quot;&gt;The Solution:&lt;/b&gt;&amp;nbsp;&lt;br&gt;&lt;p data-path-to-node=&quot;21&quot;&gt;If your batch jobs are getting killed due to cache:&lt;/p&gt;&lt;ul data-path-to-node=&quot;22&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;22,0,0&quot;&gt;&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;22,0,0&quot;&gt;Don't use &lt;code data-index-in-node=&quot;10&quot; data-path-to-node=&quot;22,0,0&quot;&gt;limit&lt;/code&gt; for Memory:&lt;/b&gt; If you only set a &lt;code data-index-in-node=&quot;46&quot; data-path-to-node=&quot;22,0,0&quot;&gt;request&lt;/code&gt;, the pod can use all the node's cache and will only be killed if the &lt;i data-index-in-node=&quot;123&quot; data-path-to-node=&quot;22,0,0&quot;&gt;node&lt;/i&gt; itself actually runs out.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;22,1,0&quot;&gt;&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;22,1,0&quot;&gt;Increase the Gap:&lt;/b&gt; Always set your &lt;code data-index-in-node=&quot;34&quot; data-path-to-node=&quot;22,1,0&quot;&gt;limit&lt;/code&gt; significantly higher than your &lt;code data-index-in-node=&quot;71&quot; data-path-to-node=&quot;22,1,0&quot;&gt;request&lt;/code&gt; to account for this &quot;&lt;b&gt;&lt;font color=&quot;#cc0066&quot;&gt;Page Cache Tax&lt;/font&gt;&lt;/b&gt;.&quot;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p id=&quot;p-rc_9fcf820beb658a69-39&quot; data-path-to-node=&quot;22,2,0&quot;&gt;&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;22,2,0&quot;&gt;Monitor the right metric:&lt;/b&gt; Use &lt;code data-index-in-node=&quot;30&quot; data-path-to-node=&quot;22,2,0&quot;&gt;container_memory_working_set_bytes&lt;/code&gt;&lt;span class=&quot;citation-41 citation-end-41&quot;&gt; to see what K8s sees.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="939" y="2360" width="411" height="230" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-12" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;23,0,0&quot;&gt;Request = Limit:&lt;/b&gt; For batch jobs, set your &lt;code data-index-in-node=&quot;42&quot; data-path-to-node=&quot;23,0,0&quot;&gt;requests&lt;/code&gt; and &lt;code data-index-in-node=&quot;55&quot; data-path-to-node=&quot;23,0,0&quot;&gt;limits&lt;/code&gt; to the same value (Guaranteed QoS). This prevents the Kubelet from over-scheduling the node." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1380" y="2760" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-14" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;23,1,0&quot;&gt;Don't skip the Limit:&lt;/b&gt; Always set a memory limit. It is better for &lt;b data-index-in-node=&quot;66&quot; data-path-to-node=&quot;23,1,0&quot;&gt;one&lt;/b&gt; batch job to die than for it to cause the &lt;b data-index-in-node=&quot;112&quot; data-path-to-node=&quot;23,1,0&quot;&gt;entire node&lt;/b&gt; to evict every other pod." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="990" y="2760" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.343;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="s3L59IFOvDij3QFSKCTg-10" target="s3L59IFOvDij3QFSKCTg-14" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1145" y="2660" />
              <mxPoint x="1110" y="2660" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="s3L59IFOvDij3QFSKCTg-16" target="s3L59IFOvDij3QFSKCTg-19" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="755" y="2880" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-16" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;23,2,0&quot;&gt;App-level Tuning:&lt;/b&gt; If your job is written in Python or C++, you can use &lt;code data-index-in-node=&quot;71&quot; data-path-to-node=&quot;23,2,0&quot;&gt;posix_fadvise(POSIX_FADV_DONTNEED)&lt;/code&gt; to tell the kernel &quot;I'm done with this data, don't cache it.&quot;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="580" y="2760" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.4;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="s3L59IFOvDij3QFSKCTg-10" target="s3L59IFOvDij3QFSKCTg-16" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1145" y="2660" />
              <mxPoint x="720" y="2660" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="s3L59IFOvDij3QFSKCTg-19" target="s3L59IFOvDij3QFSKCTg-20" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-19" value="&amp;nbsp;By using &lt;code data-index-in-node=&quot;89&quot; data-path-to-node=&quot;0&quot;&gt;posix_fadvise&lt;/code&gt;, you take the steering wheel away from the kernel and tell it exactly which data is no longer useful." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="615" y="2880" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="s3L59IFOvDij3QFSKCTg-20" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="970" y="3065" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-20" value="When you read a file, the kernel keeps it in the &lt;b data-index-in-node=&quot;49&quot; data-path-to-node=&quot;2&quot;&gt;Page Cache&lt;/b&gt;. If you are processing a 1TB dataset, the kernel will try to keep all 1TB in RAM. &lt;br&gt;&lt;code data-index-in-node=&quot;142&quot; data-path-to-node=&quot;2&quot;&gt;&lt;br&gt;POSIX_FADV_DONTNEED&lt;/code&gt; is a &lt;b data-index-in-node=&quot;167&quot; data-path-to-node=&quot;2&quot;&gt;non-binding hint&lt;/b&gt; that tells the kernel: &lt;i data-index-in-node=&quot;207&quot; data-path-to-node=&quot;2&quot;&gt;&quot;I have finished reading this specific range of the file. You can safely evict it from RAM to make room for other things.&quot;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="610" y="3000" width="290" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-22" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="980" y="2906.75" width="428" height="305.25" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="s3L59IFOvDij3QFSKCTg-24" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="440" y="3370" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s3L59IFOvDij3QFSKCTg-24" target="s3L59IFOvDij3QFSKCTg-32" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s3L59IFOvDij3QFSKCTg-24" target="s3L59IFOvDij3QFSKCTg-34" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-24" value="100 batch jobs complete simultaneously, all write results to database. &lt;br&gt;&lt;br&gt;Database connection pool exhausted, web service queries fail." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="110" y="3330" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="s3L59IFOvDij3QFSKCTg-26" target="s3L59IFOvDij3QFSKCTg-31" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="710" y="3370" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-26" value="&lt;b&gt;Why&lt;/b&gt;: Batch jobs aren't rate-limited in their interactions with shared services." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="449" y="3340" width="191" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-28" value="&lt;b&gt;Solution&lt;/b&gt;: Use a message queue (SQS, Kafka) as buffer. Batch jobs publish results, separate consumer with controlled parallelism writes to database." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="900" y="3450" width="191" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-31" value="because they all tried to &quot;cross the finish line&quot; at the exact same millisecond, they accidentally performed a &lt;b data-index-in-node=&quot;239&quot; data-path-to-node=&quot;0&quot;&gt;Distributed Denial of Service (DDoS)&lt;/b&gt; attack on your own infrastructure." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="730" y="3340" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-32" value="In a typical AI or Big Data pipeline, jobs are often started in parallel. If the workload is uniform (e.g., each job processes exactly 1GB of data), they will likely finish at almost the exact same time." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="459" y="3220" width="441" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="s3L59IFOvDij3QFSKCTg-34" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="890" y="3500" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s3L59IFOvDij3QFSKCTg-34" target="s3L59IFOvDij3QFSKCTg-36" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-34" value="&lt;b&gt;Solution&lt;/b&gt;: Instead of letting the &quot;Herd&quot; run directly into the database, you put a &lt;b data-index-in-node=&quot;72&quot; data-path-to-node=&quot;12&quot;&gt;Message Queue&lt;/b&gt; (like AWS SQS, RabbitMQ, or Kafka) in the middle to act as a shock absorber." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="457" y="3470" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-36" value="If you cannot set up a Message Queue yet, a &quot;quick fix&quot; is to add &lt;b data-index-in-node=&quot;66&quot; data-path-to-node=&quot;19&quot;&gt;Jitter&lt;/b&gt; to your batch jobs. Instead of finishing and writing immediately, have the pod sleep for a random amount of time" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="910" y="3570" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-39" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1163.18" y="3250" width="436.82" height="220" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-40" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1210" y="3495.74" width="450" height="218.52" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s3L59IFOvDij3QFSKCTg-41" target="s3L59IFOvDij3QFSKCTg-42" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s3L59IFOvDij3QFSKCTg-41" target="s3L59IFOvDij3QFSKCTg-53" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s3L59IFOvDij3QFSKCTg-41" target="s3L59IFOvDij3QFSKCTg-58" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-41" value="&lt;strong&gt;&amp;nbsp;Scheduler Thrashing&lt;/strong&gt;&lt;br/&gt;Symptom: Pods repeatedly scheduled and evicted. Cluster unstable." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="140" y="3790" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="s3L59IFOvDij3QFSKCTg-42" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="910" y="3760" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s3L59IFOvDij3QFSKCTg-42" target="s3L59IFOvDij3QFSKCTg-46" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-50" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s3L59IFOvDij3QFSKCTg-42" target="s3L59IFOvDij3QFSKCTg-48" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="880" y="3760" />
              <mxPoint x="880" y="4010" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-42" value="&lt;b&gt;Why&lt;/b&gt;: Web service traffic spike triggers HPA. HPA creates 50 new pods. Scheduler preempts 50 batch pods. Batch job controller recreates batch pods (CronJob, Job completion). Scheduler preempts them again." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="495" y="3730" width="335" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-44" value="&amp;nbsp;The &lt;b data-index-in-node=&quot;113&quot; data-path-to-node=&quot;0&quot;&gt;Horizontal Pod Autoscaler (HPA)&lt;/b&gt;&amp;nbsp;is trying to save your production traffic, and the &lt;b data-index-in-node=&quot;193&quot; data-path-to-node=&quot;0&quot;&gt;Job Controller&lt;/b&gt; trying to finish its work." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="915" y="3730" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-46" value="The &quot;&lt;b&gt;Thrashing&lt;/b&gt;&quot; happens because of a logical feedback loop between &lt;b&gt;priority levels&lt;/b&gt; and &lt;b&gt;controller &lt;/b&gt;behavior." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="920" y="3820" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s3L59IFOvDij3QFSKCTg-48" target="s3L59IFOvDij3QFSKCTg-51" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-48" value="&lt;b&gt;The Trigger: &lt;/b&gt;Your Web Service (High Priority) gets a traffic spike. &lt;br&gt;The HPA scales it up by 50 pods.&lt;br&gt;&lt;br&gt;&lt;b&gt;The Conflict:&lt;/b&gt; The cluster is full. The Scheduler looks for victims and finds 50 Batch Pods (Low Priority). It evicts them to make room for the Web pods.&lt;br&gt;&lt;b&gt;The Loop:&lt;/b&gt; The standard Batch Job Controller sees that its pods are gone. It thinks, &quot;I'm supposed to have 50 workers, but I have 0. I must create them again!&quot;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="930" y="3930" width="360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-51" value="constant cycle of &quot;Create -&amp;gt; Evict -&amp;gt; Create -&amp;gt; Evict.&quot;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1385" y="3980" width="295" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s3L59IFOvDij3QFSKCTg-53" target="s3L59IFOvDij3QFSKCTg-55" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-53" value="Problem: restartPolicy alone is not the fix" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="491" y="4150" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-55" value="Jobs use restartPolicy Never or OnFailure. Either way, when a pod is preempted the Job controller creates a replacement right away, so restartPolicy alone doesn't stop the loop." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="860" y="4150" width="530" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-57" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1720" y="3770" width="870" height="479.3" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-61" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;flowAnimation=1;" parent="1" source="s3L59IFOvDij3QFSKCTg-58" target="s3L59IFOvDij3QFSKCTg-60" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-58" value="Solution: queue, don't retry: admit Jobs via Kueue only when capacity exists, plus preemptionPolicy: Never and a podFailurePolicy" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="495" y="4260" width="285" height="96.0" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-60" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="875" y="4249.3" width="430" height="183.83" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s3L59IFOvDij3QFSKCTg-62" target="s3L59IFOvDij3QFSKCTg-63" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-76" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s3L59IFOvDij3QFSKCTg-62" target="s3L59IFOvDij3QFSKCTg-75" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-62" value="&lt;strong&gt;CPU Throttling Cascade&lt;/strong&gt;&lt;br&gt;&lt;b&gt;Symptom&lt;/b&gt;: Web service latency spikes even though node CPU utilization is 60%." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="90" y="4640" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-66" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="s3L59IFOvDij3QFSKCTg-63" target="s3L59IFOvDij3QFSKCTg-65" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-63" value="&lt;b&gt;Why&lt;/b&gt;: Batch jobs set high CPU limits (&lt;b&gt;8 cores&lt;/b&gt;) but low requests (&lt;b&gt;1 core&lt;/b&gt;).&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="459" y="4500" width="407" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="s3L59IFOvDij3QFSKCTg-65" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1290" y="4650" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-65" value="When the batch job has work, it bursts to &lt;b&gt;8 cores&lt;/b&gt;. Its quota is 8 x 100ms = 800ms per window, so it is NOT throttled. But the scheduler reserved only its 1-core request, so web pods on this node now compete with 7 extra busy cores." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="750" y="4620" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-69" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="s3L59IFOvDij3QFSKCTg-68" target="s3L59IFOvDij3QFSKCTg-70" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1680" y="4660" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-68" value="&lt;br&gt;You have a batch job with a &lt;b data-index-in-node=&quot;49&quot; data-path-to-node=&quot;4,0,0&quot;&gt;1-core Request&lt;/b&gt; but an &lt;b data-index-in-node=&quot;71&quot; data-path-to-node=&quot;4,0,0&quot;&gt;8-core Limit&lt;/b&gt;&lt;br&gt;When the batch job wakes up, it tries to use all 8 cores immediately to finish its calculation." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1305" y="4620" width="305" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-71" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="s3L59IFOvDij3QFSKCTg-70" target="s3L59IFOvDij3QFSKCTg-72" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2090" y="4660" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-70" value="Its request only sets its CPU shares. Under contention CFS splits CPU by shares, but the batch burst still steals cores, caches and memory bandwidth in spikes." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1720" y="4620" width="290" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-74" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s3L59IFOvDij3QFSKCTg-72" target="s3L59IFOvDij3QFSKCTg-73" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-72" value="If web pods have tight CPU limits, those spikes throttle them. Result: p99 jitter at 60% average CPU." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="2095" y="4630" width="205" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-73" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="2430" y="4536.46" width="1021" height="267.07" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="s3L59IFOvDij3QFSKCTg-75" target="s3L59IFOvDij3QFSKCTg-78" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1050" y="4810" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-75" value="&lt;b&gt;Solution&lt;/b&gt;: For &lt;b&gt;CPU-intensive batch &lt;/b&gt;jobs, set requests closer to limits. For &lt;b&gt;I/O-bound batch&lt;/b&gt; (waiting on network/disk), low requests are fine." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="463" y="4780" width="467" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3L59IFOvDij3QFSKCTg-78" value="This tells Kubernetes: &quot;This pod is &lt;b&gt;heavy&lt;/b&gt;. Don't put too many other pods on this node.&quot; &lt;br&gt;This reduces the &quot;noise&quot; and ensures the batch job gets a steady stream of CPU rather than violent bursts." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="990" y="4780" width="510" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="k8QXCNhzzGpZrM28IS9K" name="Challenges-2">
    <mxGraphModel dx="1036" dy="-1594" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="VOArVGaKc-swofbCb_h6-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="VOArVGaKc-swofbCb_h6-4" target="VOArVGaKc-swofbCb_h6-5" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="VOArVGaKc-swofbCb_h6-4" target="Bntlva_McWB7DlHBD3pg-7" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" parent="1" source="VOArVGaKc-swofbCb_h6-4" target="Bntlva_McWB7DlHBD3pg-10" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="VOArVGaKc-swofbCb_h6-4" target="Bntlva_McWB7DlHBD3pg-17" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="VOArVGaKc-swofbCb_h6-4" value="&lt;b style=&quot;border-color: var(--border-color);&quot; data-index-in-node=&quot;0&quot; data-path-to-node=&quot;12,0,1,0,0&quot;&gt;IP Exhaustion&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="90" y="2320" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="VOArVGaKc-swofbCb_h6-5" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="2290" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VOArVGaKc-swofbCb_h6-5" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;12,0,1,0,0&quot;&gt;IP Exhaustion:&lt;/b&gt; Pods stuck in &lt;code data-index-in-node=&quot;29&quot; data-path-to-node=&quot;12,0,1,0,0&quot;&gt;Pending&lt;/code&gt;. &lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="427" y="2260" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="VOArVGaKc-swofbCb_h6-6" target="Bntlva_McWB7DlHBD3pg-21" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="VOArVGaKc-swofbCb_h6-6" target="Bntlva_McWB7DlHBD3pg-23" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="VOArVGaKc-swofbCb_h6-6" target="Bntlva_McWB7DlHBD3pg-27" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="VOArVGaKc-swofbCb_h6-6" target="Bntlva_McWB7DlHBD3pg-33" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="VOArVGaKc-swofbCb_h6-6" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;12,0,1,1,0&quot;&gt;Connectivity Drops&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="2720" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="VOArVGaKc-swofbCb_h6-7" target="Bntlva_McWB7DlHBD3pg-48" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="VOArVGaKc-swofbCb_h6-7" target="Bntlva_McWB7DlHBD3pg-50" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="VOArVGaKc-swofbCb_h6-7" target="Bntlva_McWB7DlHBD3pg-54" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-62" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="VOArVGaKc-swofbCb_h6-7" target="Bntlva_McWB7DlHBD3pg-61" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-69" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="VOArVGaKc-swofbCb_h6-7" target="Bntlva_McWB7DlHBD3pg-68" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="VOArVGaKc-swofbCb_h6-7" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;12,0,1,2,0&quot;&gt;DNS Issues&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="100" y="3340" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="Bntlva_McWB7DlHBD3pg-2" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1150" y="2290" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-2" value="Check the &quot;Source of Truth&quot; (VPC CNI Logs)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="840" y="2275" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="Bntlva_McWB7DlHBD3pg-4" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1530" y="2290" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-4" value="The &lt;code data-index-in-node=&quot;4&quot; data-path-to-node=&quot;9&quot;&gt;&lt;b&gt;&lt;font color=&quot;#cc0000&quot;&gt;aws-node&lt;/font&gt;&lt;/b&gt;&lt;/code&gt; pod is the actual manager.&lt;br&gt;&amp;nbsp;Its logs will tell you exactly why the API call to AWS failed." style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1150" y="2270" width="330" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-6" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1540" y="2264" width="836" height="56" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="Bntlva_McWB7DlHBD3pg-7" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="810" y="2390" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-7" value="&lt;b&gt;&lt;font color=&quot;#cc0000&quot;&gt;&lt;u&gt;Fix 1&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;:&lt;br&gt;A. Increase Subnet Size (The &quot;Hard&quot; Fix)" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="427" y="2360" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-9" value="You cannot &quot;expand&quot; an existing subnet. You must create a new, larger subnet and migrate your nodes to it.&lt;br&gt;&lt;b&gt;Best for:&lt;/b&gt; Small clusters that were accidentally started with a tiny /27 or /26 subnet." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="820" y="2360" width="430" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="Bntlva_McWB7DlHBD3pg-10" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="830" y="2470" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-10" value="&lt;b style=&quot;border-color: var(--border-color);&quot;&gt;&lt;font style=&quot;border-color: var(--border-color);&quot; color=&quot;#cc0000&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Fix 2&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;:&lt;br&gt;B. Prefix Delegation (The &quot;Efficiency&quot; Fix)" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="427" y="2440" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="Bntlva_McWB7DlHBD3pg-12" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1280" y="2470" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-12" value="&lt;b&gt;Pros&lt;/b&gt;: Instantly increases pod density (e.g., 17 pods --&amp;gt; 110 pods on a t3.medium).&lt;br&gt;&lt;b&gt;Cons&lt;/b&gt;: Can cause &quot;fragmentation&quot; if your subnet is already messy." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="840" y="2440" width="390" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-14" value="kubectl set env daemonset aws-node -n kube-system ENABLE_PREFIX_DELEGATION=true" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Comic Sans MS;" parent="1" vertex="1">
          <mxGeometry x="1270" y="2455" width="540" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="Bntlva_McWB7DlHBD3pg-17" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="830" y="2560" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-17" value="&lt;b style=&quot;border-color: var(--border-color);&quot;&gt;&lt;font style=&quot;border-color: var(--border-color);&quot; color=&quot;#cc0000&quot;&gt;&lt;u style=&quot;border-color: var(--border-color);&quot;&gt;Fix 3&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;:&lt;br&gt;C. Custom Networking (The &quot;Separation&quot; Fix)" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="427" y="2540" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-20" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;23,0,0&quot;&gt;How:&lt;/b&gt; You attach a &lt;b data-index-in-node=&quot;18&quot; data-path-to-node=&quot;23,0,0&quot;&gt;Secondary CIDR&lt;/b&gt; to your VPC (e.g., &lt;code data-index-in-node=&quot;52&quot; data-path-to-node=&quot;23,0,0&quot;&gt;100.64.0.0/16&lt;/code&gt;) and configure the CNI to use it via an &lt;code data-index-in-node=&quot;106&quot; data-path-to-node=&quot;23,0,0&quot;&gt;ENIConfig&lt;/code&gt; custom resource." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="840" y="2530" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-21" value="&lt;b style=&quot;border-color: var(--border-color);&quot; data-index-in-node=&quot;0&quot; data-path-to-node=&quot;12,0,1,1,0&quot;&gt;Connectivity Drops:&lt;/b&gt;&amp;nbsp;Often caused by&amp;nbsp;&lt;code style=&quot;border-color: var(--border-color);&quot; data-index-in-node=&quot;36&quot; data-path-to-node=&quot;12,0,1,1,0&quot;&gt;conntrack&lt;/code&gt;&amp;nbsp;table exhaustion or MTU mismatch." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="470" y="2660" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="Bntlva_McWB7DlHBD3pg-23" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="860" y="2790" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-23" value="When a pod cannot reach a service IP, the communication &quot;pipe&quot; is broken somewhere between the source pod and the destination pod." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="470" y="2760" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-26" value="Because Kubernetes Services are &quot;virtual,&quot; a failure here usually means the &lt;b&gt;translation layer &lt;/b&gt;(the switchboard) or the &lt;b&gt;target list&lt;/b&gt; (the endpoints) is misconfigured." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="870" y="2760" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="Bntlva_McWB7DlHBD3pg-27" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="790" y="2880" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-27" value="Troubleshoot:&lt;br&gt;Step A: Are there any targets?" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="472" y="2850" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="Bntlva_McWB7DlHBD3pg-30" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1510" y="2888.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-30" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="800" y="2850" width="655" height="77" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-32" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;6,1,0&quot;&gt;If &lt;code data-index-in-node=&quot;16&quot; data-path-to-node=&quot;6,0,0&quot;&gt;ENDPOINTS&lt;/code&gt; is &lt;code data-index-in-node=&quot;29&quot; data-path-to-node=&quot;6,0,0&quot;&gt;&amp;lt;none&amp;gt;&lt;/code&gt;, the Service is a &quot;dead end.&quot;&lt;br&gt;The Cause:&lt;/b&gt; Usually a typo in the &lt;code data-index-in-node=&quot;33&quot; data-path-to-node=&quot;6,1,0&quot;&gt;selector&lt;/code&gt; section of your Service YAML." style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1520" y="2863.5" width="420" height="50" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="Bntlva_McWB7DlHBD3pg-33" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="790" y="2970" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-33" value="Troubleshoot:&lt;br&gt;Step B: Are the rules programmed?&lt;br&gt;Does the &lt;b data-index-in-node=&quot;51&quot; data-path-to-node=&quot;8&quot;&gt;Node&lt;/b&gt; knows how to handle the traffic?" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="472" y="2940" width="268" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="Bntlva_McWB7DlHBD3pg-37" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1310" y="2981" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-37" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="800" y="2940" width="456" height="82" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-39" value="You should see rules that &quot;jump&quot; to a &lt;b&gt;specific KUBE-SVC&lt;/b&gt; chain. &lt;br&gt;If this is empty, &lt;code data-index-in-node=&quot;99&quot; data-path-to-node=&quot;10,0,0&quot;&gt;kube-proxy&lt;/code&gt; is likely crashed or stuck." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1315" y="2960" width="370" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="Bntlva_McWB7DlHBD3pg-40" target="Bntlva_McWB7DlHBD3pg-44" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-40" value="Checking:" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="473" y="3050" width="147" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.003;entryY=0.633;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="VOArVGaKc-swofbCb_h6-6" target="Bntlva_McWB7DlHBD3pg-40" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-42" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="660" y="3050" width="20" height="170" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-43" value="The Selector Mismatch (The Typo)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="660" y="3050" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-44" value="Failing Readiness Probes --&amp;gt;&amp;nbsp;Kubernetes will not send traffic to a Pod that isn't &quot;Ready.&quot;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="660" y="3090" width="490" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-45" value="NetworkPolicy Blocking: If you have a &lt;code data-index-in-node=&quot;14&quot; data-path-to-node=&quot;20&quot;&gt;NetworkPolicy&lt;/code&gt; installed, it acts as a silent firewall." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="660" y="3140" width="510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-47" value="kube-proxy Failure: If &lt;code data-index-in-node=&quot;3&quot; data-path-to-node=&quot;23&quot;&gt;kube-proxy&lt;/code&gt; dies, the &lt;code data-index-in-node=&quot;24&quot; data-path-to-node=&quot;23&quot;&gt;iptables&lt;/code&gt; or &lt;code data-index-in-node=&quot;36&quot; data-path-to-node=&quot;23&quot;&gt;IPVS&lt;/code&gt; rules on that specific node stop updating." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="660" y="3180" width="590" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-48" value="DNS issues in a cluster are particularly frustrating because they often look like &quot;the network is down&quot; when, in reality, the network is fine—the pods just can't find the &quot;address&quot; of who they want to talk to." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="460" y="3270" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="Bntlva_McWB7DlHBD3pg-50" target="Bntlva_McWB7DlHBD3pg-52" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-50" value="In EKS, this almost always points back to &lt;b data-index-in-node=&quot;42&quot; data-path-to-node=&quot;1&quot;&gt;CoreDNS&lt;/b&gt;, the internal phonebook of your cluster." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="455" y="3360" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-52" value="CoreDNS is a set of pods (usually 2 for high availability) that listen for DNS queries within the cluster. When a Pod tries to reach &lt;code data-index-in-node=&quot;133&quot; data-path-to-node=&quot;4&quot;&gt;my-service&lt;/code&gt;, it asks CoreDNS: &lt;i data-index-in-node=&quot;162&quot; data-path-to-node=&quot;4&quot;&gt;&quot;What is the IP for my-service.default.svc.cluster.local?&quot;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="870" y="3360" width="390" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="Bntlva_McWB7DlHBD3pg-54" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="890" y="3490" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-54" value="&lt;b&gt;&lt;font color=&quot;#ff0000&quot;&gt;Troubleshooting 1:&lt;/font&gt;&lt;/b&gt; The &lt;b&gt;Corefile &lt;/b&gt;Misconfiguration&quot;&lt;br&gt;The Corefile is the configuration file for CoreDNS, stored as a &lt;b&gt;&lt;u&gt;ConfigMap&lt;/u&gt;&lt;/b&gt;. If this file is messed up, the &quot;phonebook&quot; goes blank." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="457" y="3460" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-57" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="895" y="3440" width="20" height="240" as="geometry" />
        </mxCell>
        <mxCell id="4y5N1n64Z-4XKSw8RTbe-18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="Bntlva_McWB7DlHBD3pg-58" target="4y5N1n64Z-4XKSw8RTbe-19" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1200" y="3470" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-58" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;8,0,0&quot;&gt;Looping:&lt;/b&gt; If you have multiple DNS plugins that forward to each other, CoreDNS might detect a loop and shut down." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="920" y="3440" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-59" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;8,1,0&quot;&gt;Upstream Failure:&lt;/b&gt; The &lt;code data-index-in-node=&quot;22&quot; data-path-to-node=&quot;8,1,0&quot;&gt;forward . /etc/resolv.conf&lt;/code&gt; line tells CoreDNS to ask the &lt;b data-index-in-node=&quot;79&quot; data-path-to-node=&quot;8,1,0&quot;&gt;VPC DNS (169.254.169.253)&lt;/b&gt; for external names (like &lt;code data-index-in-node=&quot;130&quot; data-path-to-node=&quot;8,1,0&quot;&gt;google.com&lt;/code&gt;). If the node's &lt;code data-index-in-node=&quot;157&quot; data-path-to-node=&quot;8,1,0&quot;&gt;/etc/resolv.conf&lt;/code&gt; is broken, CoreDNS can't resolve anything outside the cluster." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="930" y="3540" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-60" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;8,2,0&quot;&gt;Memory Limits:&lt;/b&gt; In large clusters, CoreDNS can run out of RAM while trying to index all the Services. It will crash (&lt;code data-index-in-node=&quot;116&quot; data-path-to-node=&quot;8,2,0&quot;&gt;OOMKilled&lt;/code&gt;), and all DNS resolution stops." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="930" y="3620" width="370" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="Bntlva_McWB7DlHBD3pg-61" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="910" y="3760" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-61" value="&lt;b&gt;&lt;font color=&quot;#ff0000&quot;&gt;Troubleshooting 2:&lt;/font&gt;&lt;/b&gt;&amp;nbsp;&lt;br&gt;&amp;nbsp;&lt;b&gt;Service Selector Mismatch&lt;/b&gt;: This is a &quot;DNS&quot; issue that is actually a &lt;b&gt;Labeling &lt;/b&gt;issue.." style="rounded=1;whiteSpace=wrap;fontStyle=0;html=1;" parent="1" vertex="1">
          <mxGeometry x="461" y="3730" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-64" value="When you create a Service, it creates a DNS record. However, if that Service doesn't point to any Pods, the DNS record exists, but it leads to a &quot;&lt;b&gt;Dead End.&quot;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="915" y="3750" width="415" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-65" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1350" y="3710" width="20" height="120" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-66" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;13,0,0&quot;&gt;The Symptom:&lt;/b&gt; &lt;code data-index-in-node=&quot;13&quot; data-path-to-node=&quot;13,0,0&quot;&gt;nslookup my-service&lt;/code&gt; returns a valid IP address (the ClusterIP), but when you try to connect, it says &lt;code data-index-in-node=&quot;114&quot; data-path-to-node=&quot;13,0,0&quot;&gt;Connection Refused&lt;/code&gt;." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1380" y="3710" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-67" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;13,1,0&quot;&gt;The Cause:&lt;/b&gt; The Service's &lt;code data-index-in-node=&quot;25&quot; data-path-to-node=&quot;13,1,0&quot;&gt;selector&lt;/code&gt; (e.g., &lt;code data-index-in-node=&quot;41&quot; data-path-to-node=&quot;13,1,0&quot;&gt;app: web&lt;/code&gt;) doesn't match the labels on any running Pods." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1380" y="3770" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-70" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="Bntlva_McWB7DlHBD3pg-68" target="Bntlva_McWB7DlHBD3pg-71" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="900" y="4000" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="4y5N1n64Z-4XKSw8RTbe-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="Bntlva_McWB7DlHBD3pg-68" target="4y5N1n64Z-4XKSw8RTbe-3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-68" value="&lt;b&gt;&lt;font color=&quot;#ff0000&quot;&gt;Troubleshooting 3:&lt;/font&gt;&lt;/b&gt;&amp;nbsp;&lt;br&gt;&amp;nbsp;The &lt;code data-index-in-node=&quot;7&quot; data-path-to-node=&quot;15&quot;&gt;ndots&lt;/code&gt; Problem (Performance Killer).&lt;br&gt;This is a hidden DNS &quot;issue&quot; that makes your cluster feel slow. By default, Linux pods have a setting called &lt;code data-index-in-node=&quot;109&quot; data-path-to-node=&quot;16&quot;&gt;ndots:5&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;fontStyle=0;html=1;" parent="1" vertex="1">
          <mxGeometry x="461" y="3970" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="4y5N1n64Z-4XKSw8RTbe-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="Bntlva_McWB7DlHBD3pg-71" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1170" y="4000" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Bntlva_McWB7DlHBD3pg-71" value="When you try to resolve &lt;code data-index-in-node=&quot;24&quot; data-path-to-node=&quot;17&quot;&gt;google.com&lt;/code&gt;, your pod thinks it might be a local service first. It tries:" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="910" y="3970" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="4y5N1n64Z-4XKSw8RTbe-2" value="&lt;ol data-path-to-node=&quot;18&quot; start=&quot;1&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;18,0,0&quot;&gt;&lt;code data-index-in-node=&quot;0&quot; data-path-to-node=&quot;18,0,0&quot;&gt;google.com.default.svc.cluster.local&lt;/code&gt; (Fail)&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;18,1,0&quot;&gt;&lt;code data-index-in-node=&quot;0&quot; data-path-to-node=&quot;18,1,0&quot;&gt;google.com.svc.cluster.local&lt;/code&gt; (Fail)&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;18,2,0&quot;&gt;&lt;code data-index-in-node=&quot;0&quot; data-path-to-node=&quot;18,2,0&quot;&gt;google.com.cluster.local&lt;/code&gt; (Fail)&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;18,3,0&quot;&gt;...and finally, &lt;code data-index-in-node=&quot;16&quot; data-path-to-node=&quot;18,3,0&quot;&gt;google.com&lt;/code&gt; (Success)&lt;/p&gt;&lt;/li&gt;&lt;/ol&gt;&lt;p data-path-to-node=&quot;19&quot;&gt;&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;19&quot;&gt;Result:&lt;/b&gt; One single DNS request actually triggers &lt;b data-index-in-node=&quot;49&quot; data-path-to-node=&quot;19&quot;&gt;5 separate queries&lt;/b&gt;, hammering CoreDNS and increasing latency.&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
          <mxGeometry x="1170" y="3930" width="370" height="170" as="geometry" />
        </mxCell>
        <mxCell id="4y5N1n64Z-4XKSw8RTbe-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="4y5N1n64Z-4XKSw8RTbe-3" target="4y5N1n64Z-4XKSw8RTbe-6" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1270" y="4250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="4y5N1n64Z-4XKSw8RTbe-3" value="&lt;b&gt;&lt;u&gt;&lt;font color=&quot;#cc0000&quot;&gt;ndots:5&lt;/font&gt;&lt;/u&gt;&lt;/b&gt; is a default setting in the &lt;b&gt;&lt;font color=&quot;#cc0000&quot;&gt;/etc/resolv.conf&lt;/font&gt;&lt;/b&gt; file of almost every Kubernetes pod. It tells the Linux DNS resolver how to handle &quot;ambiguous&quot; domain names (names that don't look like a full web address).&lt;br&gt;Specifically, it says: &quot;If a domain name has &lt;b&gt;&lt;font color=&quot;#cc0000&quot;&gt;fewer than 5 dots&lt;/font&gt;&lt;/b&gt; in it, assume it might be a local service first and try to append the cluster's internal search paths before trying the real name.&quot;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="910" y="4150" width="720" height="60" as="geometry" />
        </mxCell>
        <mxCell id="4y5N1n64Z-4XKSw8RTbe-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="4y5N1n64Z-4XKSw8RTbe-6" target="4y5N1n64Z-4XKSw8RTbe-8" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1540" y="4280" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="4y5N1n64Z-4XKSw8RTbe-6" value="While great for local services, &lt;code data-index-in-node=&quot;32&quot; data-path-to-node=&quot;13&quot;&gt;ndots:5&lt;/code&gt; is a nightmare for high-traffic applications talking to external resources (like S3, RDS, or OpenAI APIs)." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1075" y="4250" width="390" height="60" as="geometry" />
        </mxCell>
        <mxCell id="4y5N1n64Z-4XKSw8RTbe-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="4y5N1n64Z-4XKSw8RTbe-8" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1690" y="4280" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="4y5N1n64Z-4XKSw8RTbe-8" value="How to Fix It:" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1520" y="4250" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="4y5N1n64Z-4XKSw8RTbe-10" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1710" y="4220" width="20" height="140" as="geometry" />
        </mxCell>
        <mxCell id="4y5N1n64Z-4XKSw8RTbe-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="4y5N1n64Z-4XKSw8RTbe-11" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2010" y="4250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="4y5N1n64Z-4XKSw8RTbe-11" value="Method A: The &quot;Fully Qualified&quot; Trick" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fa6800;fontColor=#000000;strokeColor=#C73500;" parent="1" vertex="1">
          <mxGeometry x="1730" y="4220" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="4y5N1n64Z-4XKSw8RTbe-13" value="Instead of &lt;code data-index-in-node=&quot;79&quot; data-path-to-node=&quot;19&quot;&gt;google.com&lt;/code&gt;, use &lt;b data-index-in-node=&quot;95&quot; data-path-to-node=&quot;19&quot;&gt;&lt;code data-index-in-node=&quot;95&quot; data-path-to-node=&quot;19&quot;&gt;google.com.&lt;/code&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="2010" y="4235" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="4y5N1n64Z-4XKSw8RTbe-15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="4y5N1n64Z-4XKSw8RTbe-14" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2010" y="4330" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="4y5N1n64Z-4XKSw8RTbe-14" value="Method B: Change the Pod Spec" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fa6800;fontColor=#000000;strokeColor=#C73500;" parent="1" vertex="1">
          <mxGeometry x="1730" y="4300" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="4y5N1n64Z-4XKSw8RTbe-16" value="You can manually lower the &lt;code data-index-in-node=&quot;27&quot; data-path-to-node=&quot;21&quot;&gt;ndots&lt;/code&gt; value for specific deployments that talk to the outside world a lot." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="2010" y="4315" width="560" height="30" as="geometry" />
        </mxCell>
        <mxCell id="4y5N1n64Z-4XKSw8RTbe-17" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="2570" y="4235" width="602" height="157.34" as="geometry" />
        </mxCell>
        <mxCell id="4y5N1n64Z-4XKSw8RTbe-20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="4y5N1n64Z-4XKSw8RTbe-19" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1430" y="3470" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="4y5N1n64Z-4XKSw8RTbe-19" value="Example" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1230" y="3440" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="4y5N1n64Z-4XKSw8RTbe-21" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1445" y="3410" width="20" height="120" as="geometry" />
        </mxCell>
        <mxCell id="4y5N1n64Z-4XKSw8RTbe-22" value="&lt;ul&gt;&lt;li&gt;&lt;b style=&quot;background-color: initial;&quot; data-path-to-node=&quot;5,0,0&quot; data-index-in-node=&quot;0&quot;&gt;The Request:&lt;/b&gt;&lt;span style=&quot;background-color: initial;&quot;&gt; A Pod asks CoreDNS for &lt;/span&gt;&lt;code style=&quot;background-color: initial;&quot; data-path-to-node=&quot;5,0,0&quot; data-index-in-node=&quot;36&quot;&gt;google.com&lt;/code&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;b style=&quot;background-color: initial;&quot; data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;0&quot;&gt;The Forward:&lt;/b&gt;&lt;span style=&quot;background-color: initial;&quot;&gt; CoreDNS doesn't know &lt;/span&gt;&lt;code style=&quot;background-color: initial;&quot; data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;34&quot;&gt;google.com&lt;/code&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;, so it checks its &lt;/span&gt;&lt;code style=&quot;background-color: initial;&quot; data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;63&quot;&gt;forward&lt;/code&gt;&lt;span style=&quot;background-color: initial;&quot;&gt; rule (usually &lt;/span&gt;&lt;code style=&quot;background-color: initial;&quot; data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;85&quot;&gt;forward . /etc/resolv.conf&lt;/code&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;).&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;b style=&quot;background-color: initial;&quot; data-path-to-node=&quot;5,2,0&quot; data-index-in-node=&quot;0&quot;&gt;The Trap:&lt;/b&gt;&lt;span style=&quot;background-color: initial;&quot;&gt; If the node's &lt;/span&gt;&lt;code style=&quot;background-color: initial;&quot; data-path-to-node=&quot;5,2,0&quot; data-index-in-node=&quot;24&quot;&gt;/etc/resolv.conf&lt;/code&gt;&lt;span style=&quot;background-color: initial;&quot;&gt; points back to a local address (like &lt;/span&gt;&lt;code style=&quot;background-color: initial;&quot; data-path-to-node=&quot;5,2,0&quot; data-index-in-node=&quot;78&quot;&gt;127.0.0.1&lt;/code&gt;&lt;span style=&quot;background-color: initial;&quot;&gt; or &lt;/span&gt;&lt;code style=&quot;background-color: initial;&quot; data-path-to-node=&quot;5,2,0&quot; data-index-in-node=&quot;91&quot;&gt;127.0.0.53&lt;/code&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;), CoreDNS sends the request to that address.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,3,0&quot;&gt;&lt;b data-path-to-node=&quot;5,3,0&quot; data-index-in-node=&quot;0&quot;&gt;The Spiral:&lt;/b&gt; That address is often just a &quot;stub&quot; that redirects traffic back to... &lt;b data-path-to-node=&quot;5,3,0&quot; data-index-in-node=&quot;82&quot;&gt;CoreDNS&lt;/b&gt;.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,4,0&quot;&gt;&lt;b data-path-to-node=&quot;5,4,0&quot; data-index-in-node=&quot;0&quot;&gt;The End:&lt;/b&gt; The request circles forever until the &lt;code data-path-to-node=&quot;5,4,0&quot; data-index-in-node=&quot;47&quot;&gt;loop&lt;/code&gt; plugin sees the same &quot;probe&quot; packet more than twice and shuts the server down to save the hardware.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1450" y="3390" width="560" height="180" as="geometry" />
        </mxCell>
        <mxCell id="dDzBHwgKQCDp_JuLpzeB-1" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="770" y="4360" width="450.5" height="245.36" as="geometry" />
        </mxCell>
        <mxCell id="Lwb1opyEe8kcOX3t9kYm-2" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;12,1,1,0,0&quot;&gt;Latency:&lt;/b&gt; Same-AZ cross-node (0.2–1ms); Cross-AZ (1–5ms)." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="110" y="4540" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Lwb1opyEe8kcOX3t9kYm-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.001;entryY=0.373;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="Lwb1opyEe8kcOX3t9kYm-2" target="dDzBHwgKQCDp_JuLpzeB-1" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Lwb1opyEe8kcOX3t9kYm-4" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="752.5" y="4670" width="535" height="290.25" as="geometry" />
        </mxCell>
        <mxCell id="Lwb1opyEe8kcOX3t9kYm-5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.564;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="Lwb1opyEe8kcOX3t9kYm-2" target="Lwb1opyEe8kcOX3t9kYm-4" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Lwb1opyEe8kcOX3t9kYm-6" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="760" y="5000" width="572" height="312.25" as="geometry" />
        </mxCell>
        <mxCell id="Lwb1opyEe8kcOX3t9kYm-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.63;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="Lwb1opyEe8kcOX3t9kYm-2" target="Lwb1opyEe8kcOX3t9kYm-6" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="xGO3qfrpxO9BTqFwCjdU-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="xGO3qfrpxO9BTqFwCjdU-1" target="xGO3qfrpxO9BTqFwCjdU-3" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="520" y="5440" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="xGO3qfrpxO9BTqFwCjdU-1" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;12,1,1,1,0&quot;&gt;Throughput:&lt;/b&gt; Scaled by instance bandwidth (e.g., 25Gbps on &lt;code data-index-in-node=&quot;58&quot; data-path-to-node=&quot;12,1,1,1,0&quot;&gt;m5.12xlarge&lt;/code&gt;)." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="101" y="5410" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="xGO3qfrpxO9BTqFwCjdU-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="xGO3qfrpxO9BTqFwCjdU-3" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="830" y="5440" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="xGO3qfrpxO9BTqFwCjdU-3" value="&amp;nbsp;no matter how powerful your CPUs are, your node's ability to move data in and out is strictly capped by the virtual hardware it runs on." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="550" y="5410" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="xGO3qfrpxO9BTqFwCjdU-5" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="841" y="5380" width="20" height="120" as="geometry" />
        </mxCell>
        <mxCell id="xGO3qfrpxO9BTqFwCjdU-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="xGO3qfrpxO9BTqFwCjdU-6" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1110" y="5440" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="xGO3qfrpxO9BTqFwCjdU-6" value="&lt;li class=&quot;whitespace-normal break-words pl-2&quot;&gt;t3.medium: Up to 5 Gbps&lt;/li&gt;&#10;&lt;li class=&quot;whitespace-normal break-words pl-2&quot;&gt;m5.large: Up to 10 Gbps&lt;/li&gt;&#10;&lt;li class=&quot;whitespace-normal break-words pl-2&quot;&gt;m5.4xlarge: Up to 10 Gbps&lt;/li&gt;&#10;&lt;li class=&quot;whitespace-normal break-words pl-2&quot;&gt;m5.12xlarge: 25 Gbps&lt;/li&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="875" y="5380" width="190" height="120" as="geometry" />
        </mxCell>
        <mxCell id="xGO3qfrpxO9BTqFwCjdU-8" value="Pay attention to the difference between &lt;b data-index-in-node=&quot;110&quot; data-path-to-node=&quot;16&quot;&gt;Burstable&lt;/b&gt; (&quot;Up to&quot;) and &lt;b data-index-in-node=&quot;134&quot; data-path-to-node=&quot;16&quot;&gt;Guaranteed&lt;/b&gt; bandwidth." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1110" y="5425" width="490" height="30" as="geometry" />
        </mxCell>
        <mxCell id="7ch4HcztpHuimuTx-uE--3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="7ch4HcztpHuimuTx-uE--1" target="7ch4HcztpHuimuTx-uE--4" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="5670" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7ch4HcztpHuimuTx-uE--1" value="MTU: 9001 (Jumbo Frames) supported; set via AWS_VPC_ENI_MTU in the VPC CNI." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="90" y="5640" width="360" height="67.2" as="geometry" />
        </mxCell>
        <mxCell id="7ch4HcztpHuimuTx-uE--2" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1630" y="5390" width="480" height="260.4" as="geometry" />
        </mxCell>
        <mxCell id="7ch4HcztpHuimuTx-uE--7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="7ch4HcztpHuimuTx-uE--4" target="7ch4HcztpHuimuTx-uE--5" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7ch4HcztpHuimuTx-uE--8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="7ch4HcztpHuimuTx-uE--4" target="7ch4HcztpHuimuTx-uE--6" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7ch4HcztpHuimuTx-uE--4" value="The difference between your VPC's &lt;b data-index-in-node=&quot;34&quot; data-path-to-node=&quot;0&quot;&gt;9001 MTU&lt;/b&gt; and your container's &lt;b data-index-in-node=&quot;64&quot; data-path-to-node=&quot;0&quot;&gt;1500 MTU&lt;/b&gt; is a classic &quot;mismatch&quot; that determines how data is chopped up before it travels across the network." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="532" y="5640" width="308" height="60" as="geometry" />
        </mxCell>
        <mxCell id="7ch4HcztpHuimuTx-uE--5" value="&amp;nbsp;VPC Default: 9001 Bytes (The &quot;Jumbo Frame&quot;):&amp;nbsp;&amp;nbsp;This only works &lt;b&gt;&lt;i data-index-in-node=&quot;27&quot; data-path-to-node=&quot;5,2,0&quot;&gt;inside&lt;/i&gt; &lt;/b&gt;the AWS network (VPC-to-VPC or VPC-to-DirectConnect)." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="890" y="5570" width="410" height="60" as="geometry" />
        </mxCell>
        <mxCell id="7ch4HcztpHuimuTx-uE--9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="7ch4HcztpHuimuTx-uE--6" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1330" y="5750" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7ch4HcztpHuimuTx-uE--6" value="Most Docker containers and Kubernetes Pods default to &lt;b data-index-in-node=&quot;54&quot; data-path-to-node=&quot;8&quot;&gt;1500 bytes&lt;/b&gt;. This is the standard size for the entire public Internet (Ethernet standard)" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="890" y="5720" width="390" height="60" as="geometry" />
        </mxCell>
        <mxCell id="7ch4HcztpHuimuTx-uE--10" value="For High-Performance AI/ML: Some engineers tune their CNI (like Calico or the AWS VPC CNI) to use an MTU of &lt;b data-index-in-node=&quot;183&quot; data-path-to-node=&quot;18&quot;&gt;8951&lt;/b&gt; or &lt;b data-index-in-node=&quot;191&quot; data-path-to-node=&quot;18&quot;&gt;9001&lt;/b&gt; for pod-to-pod traffic to eke out every bit of performance. However, if that pod ever tries to talk to the Internet without a translator, the connection will likely break." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1340" y="5730" width="460" height="60" as="geometry" />
        </mxCell>
        <mxCell id="7ch4HcztpHuimuTx-uE--11" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1881" y="5690" width="495" height="267.58" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="LgOFpDAPx05IchzCDgyP" name="cgroups">
    <mxGraphModel dx="1219" dy="-2587" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="CdUwby87fhPpT4YJmm45-1" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="540" y="3340" width="1063" height="579.35" as="geometry" />
        </mxCell>
        <mxCell id="ftktYsw6Q8p7bXNVU2P1-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="ftktYsw6Q8p7bXNVU2P1-2" target="ftktYsw6Q8p7bXNVU2P1-3" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="310" y="4149.999999999999" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ftktYsw6Q8p7bXNVU2P1-2" value="Linux cgroups" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="100" y="4120" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ftktYsw6Q8p7bXNVU2P1-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="ftktYsw6Q8p7bXNVU2P1-3" target="ftktYsw6Q8p7bXNVU2P1-4" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ftktYsw6Q8p7bXNVU2P1-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="ftktYsw6Q8p7bXNVU2P1-3" target="ftktYsw6Q8p7bXNVU2P1-5" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ftktYsw6Q8p7bXNVU2P1-3" value="Linux cgroups use two files to manage your CPU limit:&lt;sup data-turn-source-index=&quot;1&quot; class=&quot;superscript&quot;&gt;&lt;/sup&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="300" y="4120" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ftktYsw6Q8p7bXNVU2P1-4" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;4,0,0&quot;&gt;&lt;code data-index-in-node=&quot;0&quot; data-path-to-node=&quot;4,0,0&quot;&gt;cpu.cfs_period_us&lt;/code&gt;&lt;/b&gt;: The &quot;Scheduling Window.&quot;&lt;sup data-turn-source-index=&quot;2&quot; class=&quot;superscript&quot;&gt;&lt;/sup&gt; &lt;span class=&quot;citation-19&quot;&gt;In Kubernetes, this is almost always set to &lt;/span&gt;&lt;b data-index-in-node=&quot;88&quot; data-path-to-node=&quot;4,0,0&quot;&gt;100,000 microseconds&lt;/b&gt;&lt;span class=&quot;citation-19&quot;&gt; (which equals &lt;/span&gt;&lt;b data-index-in-node=&quot;123&quot; data-path-to-node=&quot;4,0,0&quot;&gt;100ms&lt;/b&gt;&lt;span class=&quot;citation-19 citation-end-19&quot;&gt; of real time).&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="710" y="4050" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ftktYsw6Q8p7bXNVU2P1-5" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;4,1,0&quot;&gt;&lt;code data-index-in-node=&quot;0&quot; data-path-to-node=&quot;4,1,0&quot;&gt;cpu.cfs_quota_us&lt;/code&gt;&lt;/b&gt;: The actual &quot;Allowance&quot; your pod gets during that 100ms window.&lt;sup data-turn-source-index=&quot;4&quot; class=&quot;superscript&quot;&gt;&lt;/sup&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="720" y="4150" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ftktYsw6Q8p7bXNVU2P1-8" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1120" y="4030" width="20" height="200" as="geometry" />
        </mxCell>
        <mxCell id="ftktYsw6Q8p7bXNVU2P1-9" value="To find the quota, Kubernetes uses this simple multiplication:&lt;sup data-turn-source-index=&quot;5&quot; class=&quot;superscript&quot;&gt;&lt;/sup&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1140" y="4110" width="350" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ftktYsw6Q8p7bXNVU2P1-10" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1160" y="4150" width="643" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ftktYsw6Q8p7bXNVU2P1-11" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1830" y="4010" width="20" height="230" as="geometry" />
        </mxCell>
        <mxCell id="ftktYsw6Q8p7bXNVU2P1-12" value="If you set a limit of &lt;b&gt;2000m&lt;/b&gt; (which is 2.0 full cores):&lt;br&gt;&lt;br&gt;&lt;br&gt;Convert millicores to cores: 2000m / 1000 = &lt;b&gt;2.0 cores&lt;/b&gt;&lt;br&gt;&lt;br&gt;Apply the formula: 2.0 x 100,000&amp;nbsp; microseconds&lt;br&gt;&lt;br&gt;Result: 200,000 microseconds." style="text;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;html=1;" parent="1" vertex="1">
          <mxGeometry x="1860" y="4065" width="310" height="130" as="geometry" />
        </mxCell>
        <mxCell id="ftktYsw6Q8p7bXNVU2P1-13" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="2170" y="4060" width="20" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ftktYsw6Q8p7bXNVU2P1-15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="ftktYsw6Q8p7bXNVU2P1-14" target="ftktYsw6Q8p7bXNVU2P1-16" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2380" y="4120" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ftktYsw6Q8p7bXNVU2P1-14" value="How can I have a 200ms quota inside a 100ms window?" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="2200" y="4090" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ftktYsw6Q8p7bXNVU2P1-19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="ftktYsw6Q8p7bXNVU2P1-16" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2560" y="4190" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ftktYsw6Q8p7bXNVU2P1-16" value="This is because &lt;b data-index-in-node=&quot;16&quot; data-path-to-node=&quot;15&quot;&gt;quotas are cumulative across all CPU cores.&lt;/b&gt;&amp;nbsp;&lt;br&gt;&amp;nbsp;If your node has 4 physical cores, there are actually &lt;b data-index-in-node=&quot;116&quot; data-path-to-node=&quot;15&quot;&gt;400ms&lt;/b&gt; of total CPU time available every 100ms of real time." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="2380" y="4090" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ftktYsw6Q8p7bXNVU2P1-18" value="By giving you a &lt;b data-index-in-node=&quot;16&quot; data-path-to-node=&quot;16,0,0&quot;&gt;200,000 us (200ms)&lt;/b&gt; quota, the Kernel is saying: &lt;i data-index-in-node=&quot;64&quot; data-path-to-node=&quot;16,0,0&quot;&gt;&quot;Your pod can use a total of 200ms of work, which it can do by running at 100% on &lt;b data-index-in-node=&quot;146&quot; data-path-to-node=&quot;16,0,0&quot;&gt;two cores simultaneously&lt;/b&gt; for the entire 100ms window.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="2390" y="4200" width="370" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="yLCqjDiFVFbfoUrqXLgC" name="EKS Scheduler ">
    <mxGraphModel dx="1434" dy="1004" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="hotQBRh_3EuXlNmoSv4f-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hotQBRh_3EuXlNmoSv4f-1" target="hotQBRh_3EuXlNmoSv4f-2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-1" value="EKS Scheduler&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="110" y="330" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-2" value="Scheduler in k8s is the &quot;brain&quot; that decides where every new Pod lives.&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="300" y="240" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hotQBRh_3EuXlNmoSv4f-4" target="hotQBRh_3EuXlNmoSv4f-6" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hotQBRh_3EuXlNmoSv4f-4" target="hotQBRh_3EuXlNmoSv4f-38" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="570" y="430" />
              <mxPoint x="570" y="950" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-4" value="it uses a two-phase workflow: &lt;b data-index-in-node=&quot;71&quot; data-path-to-node=&quot;1&quot;&gt;Filtering&lt;/b&gt; and &lt;b data-index-in-node=&quot;85&quot; data-path-to-node=&quot;1&quot;&gt;Scoring&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="300" y="400" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.004;entryY=0.617;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="hotQBRh_3EuXlNmoSv4f-1" target="hotQBRh_3EuXlNmoSv4f-4" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hotQBRh_3EuXlNmoSv4f-6" target="hotQBRh_3EuXlNmoSv4f-8" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hotQBRh_3EuXlNmoSv4f-6" target="hotQBRh_3EuXlNmoSv4f-10" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-6" value="Phase 1: &lt;b&gt;Filtering&lt;/b&gt; (The &quot;Predicate&quot; Phase)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fa6800;fontColor=#000000;strokeColor=#C73500;" parent="1" vertex="1">
          <mxGeometry x="610" y="340" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hotQBRh_3EuXlNmoSv4f-8" target="hotQBRh_3EuXlNmoSv4f-12" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="hotQBRh_3EuXlNmoSv4f-8" target="hotQBRh_3EuXlNmoSv4f-18" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hotQBRh_3EuXlNmoSv4f-8" target="hotQBRh_3EuXlNmoSv4f-22" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hotQBRh_3EuXlNmoSv4f-8" target="hotQBRh_3EuXlNmoSv4f-26" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hotQBRh_3EuXlNmoSv4f-8" target="hotQBRh_3EuXlNmoSv4f-32" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1280" y="280" />
              <mxPoint x="1280" y="640" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-8" value="The goal of the Filtering phase is simple: &lt;b data-index-in-node=&quot;43&quot; data-path-to-node=&quot;4&quot;&gt;Find all nodes that are physically and logically capable of hosting the Pod.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="950" y="250" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-10" value="The scheduler runs a series of checks (Filter plugins, formerly Predicates) against every node. If a node fails even one check, it is tossed out." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="950" y="360" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hotQBRh_3EuXlNmoSv4f-12" target="hotQBRh_3EuXlNmoSv4f-14" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-12" value="Insufficient Resources &lt;br&gt;(The &lt;b&gt;Bin-Packing Rule&lt;/b&gt;)" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1300" y="140" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="hotQBRh_3EuXlNmoSv4f-14" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1950" y="170" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-14" value="The scheduler looks at the &lt;b data-index-in-node=&quot;27&quot; data-path-to-node=&quot;7&quot;&gt;total capacity&lt;/b&gt; of the node and subtracts the &lt;b data-index-in-node=&quot;72&quot; data-path-to-node=&quot;7&quot;&gt;sum of all CPU/Memory requests&lt;/b&gt; of the pods already running there." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3c800;fontColor=#000000;strokeColor=#B09500;" parent="1" vertex="1">
          <mxGeometry x="1590" y="140" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-17" value="&lt;b style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot; data-index-in-node=&quot;0&quot; data-path-to-node=&quot;8,0,0&quot;&gt;The Check:&lt;/b&gt;&amp;nbsp;&lt;font color=&quot;#67ab9f&quot;&gt;&lt;b&gt;Available Capacity&amp;gt;= New Pod Request&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1995" y="155" width="320" height="30" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hotQBRh_3EuXlNmoSv4f-18" target="hotQBRh_3EuXlNmoSv4f-20" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-18" value="Node Selector Mismatch" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1310" y="230" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-20" value="This is the simplest form of placement control. If your Pod YAML has a &lt;code data-index-in-node=&quot;71&quot; data-path-to-node=&quot;10&quot;&gt;nodeSelector&lt;/code&gt; (e.g., &lt;code data-index-in-node=&quot;91&quot; data-path-to-node=&quot;10&quot;&gt;disktype: ssd&lt;/code&gt;), the scheduler will immediately discard any node that doesn't have that exact label." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3c800;fontColor=#000000;strokeColor=#B09500;" parent="1" vertex="1">
          <mxGeometry x="1590" y="230" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="hotQBRh_3EuXlNmoSv4f-22" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1580" y="360" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-22" value="Taints and Tolerations &lt;br&gt;(The &quot;Keep Out&quot; Sign)" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1310" y="330" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-24" value="Taints allow a node to &lt;b data-index-in-node=&quot;23&quot; data-path-to-node=&quot;12&quot;&gt;repel&lt;/b&gt; a set of pods." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3c800;fontColor=#000000;strokeColor=#B09500;" parent="1" vertex="1">
          <mxGeometry x="1590" y="340" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hotQBRh_3EuXlNmoSv4f-26" target="hotQBRh_3EuXlNmoSv4f-28" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hotQBRh_3EuXlNmoSv4f-26" target="hotQBRh_3EuXlNmoSv4f-29" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-26" value="Affinity and Anti-Affinity Violations" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1310" y="420" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-28" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;16,0,0&quot;&gt;Node Affinity:&lt;/b&gt; &quot;I &lt;i data-index-in-node=&quot;18&quot; data-path-to-node=&quot;16,0,0&quot;&gt;prefer&lt;/i&gt; or &lt;i data-index-in-node=&quot;28&quot; data-path-to-node=&quot;16,0,0&quot;&gt;must&lt;/i&gt; run on nodes in &lt;code data-index-in-node=&quot;49&quot; data-path-to-node=&quot;16,0,0&quot;&gt;us-east-1a&lt;/code&gt;.&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3c800;fontColor=#000000;strokeColor=#B09500;" parent="1" vertex="1">
          <mxGeometry x="1600" y="420" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-29" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;16,1,0&quot;&gt;Pod Anti-Affinity:&lt;/b&gt; &quot;I &lt;i data-index-in-node=&quot;22&quot; data-path-to-node=&quot;16,1,0&quot;&gt;must not&lt;/i&gt; run on a node that already has another instance of myself&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3c800;fontColor=#000000;strokeColor=#B09500;" parent="1" vertex="1">
          <mxGeometry x="1600" y="510" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="hotQBRh_3EuXlNmoSv4f-32" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1590" y="640" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-32" value="Port Conflicts" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1330" y="610" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-34" value="If your pod wants to use a specific &lt;code data-index-in-node=&quot;36&quot; data-path-to-node=&quot;18&quot;&gt;hostPort&lt;/code&gt; (like port 80 directly on the EC2 instance), and another pod on that node is already using it, the node is disqualified. You can't have two &quot;renters&quot; using the same &quot;mailbox.&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3c800;fontColor=#000000;strokeColor=#B09500;" parent="1" vertex="1">
          <mxGeometry x="1600" y="610" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-36" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="2050" y="280" width="627" height="266" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-37" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="2043" y="580" width="641" height="365.44" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hotQBRh_3EuXlNmoSv4f-38" target="hotQBRh_3EuXlNmoSv4f-40" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hotQBRh_3EuXlNmoSv4f-38" target="hotQBRh_3EuXlNmoSv4f-42" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hotQBRh_3EuXlNmoSv4f-38" target="hotQBRh_3EuXlNmoSv4f-44" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-38" value="Phase 2:&amp;nbsp;&lt;b&gt;Scoring &lt;/b&gt;Phase&lt;br&gt;(Ranking Phase)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fa6800;fontColor=#000000;strokeColor=#C73500;" parent="1" vertex="1">
          <mxGeometry x="670" y="920" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-40" value="Once the &lt;b data-index-in-node=&quot;9&quot; data-path-to-node=&quot;0&quot;&gt;Filtering Phase&lt;/b&gt; has narrowed down the list of potential homes for your pod, the &lt;b data-index-in-node=&quot;89&quot; data-path-to-node=&quot;0&quot;&gt;Scoring Phase&lt;/b&gt; (also known as the &quot;Ranking Phase&quot;) begins" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1030" y="820" width="390" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-42" value="&amp;nbsp;This is where the scheduler decides which of the &quot;capable&quot; nodes is actually the &lt;i data-index-in-node=&quot;228&quot; data-path-to-node=&quot;0&quot;&gt;best&lt;/i&gt; fit." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1030" y="920" width="390" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hotQBRh_3EuXlNmoSv4f-44" target="hotQBRh_3EuXlNmoSv4f-46" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hotQBRh_3EuXlNmoSv4f-44" target="hotQBRh_3EuXlNmoSv4f-48" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hotQBRh_3EuXlNmoSv4f-44" target="hotQBRh_3EuXlNmoSv4f-50" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1500" y="1080" />
              <mxPoint x="1500" y="1220" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="hotQBRh_3EuXlNmoSv4f-44" target="hotQBRh_3EuXlNmoSv4f-52" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1500" y="1080" />
              <mxPoint x="1500" y="1320" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-44" value="Each remaining node is run through several &quot;&lt;font color=&quot;#cc0000&quot;&gt;&lt;b&gt;priority functions,&quot;&lt;/b&gt;&lt;/font&gt; assigned a score for each, and the node with the highest cumulative score wins." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1030" y="1050" width="390" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-46" value="LeastAllocated (The &quot;Spreader&quot;): the default scoring strategy of the NodeResourcesFit plugin. It looks for the &quot;emptiest&quot; nodes by computing requested resources vs. capacity (CPU and memory). Nodes with more free space get higher scores. Great for High Availability because it spreads pods across the cluster." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1570" y="970" width="470" height="66.2" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-48" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;5,1,0&quot;&gt;BalancedResourceAllocation (The &quot;Balancer&quot;):&lt;/b&gt; This function tries to keep CPU and Memory usage &lt;b&gt;balanced on a node&lt;/b&gt;. If a node has plenty of CPU but is almost out of RAM, it will receive a lower score for a memory-heavy pod. It prevents nodes from becoming &quot;lopsided.&quot;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1580" y="1080" width="470" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-50" value="ImageLocality (The &quot;Speedster&quot;): scores nodes higher if the pod's images (e.g., a 2GB Java image) are already on local disk, so pods skip the image pull and start faster. Bigger cached images score higher; images already on many nodes count less." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1590" y="1190" width="470" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-52" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;5,3,0&quot;&gt;Node/Inter-Pod Affinity (The &quot;Socialite&quot;):&lt;/b&gt; This handles your &quot;preferred&quot; (soft) affinity rules. If you say, &lt;i data-index-in-node=&quot;108&quot; data-path-to-node=&quot;5,3,0&quot;&gt;&quot;I'd like to run near my database,&quot;&lt;/i&gt; the scheduler will give higher scores to nodes in the same rack or zone as that database." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;" parent="1" vertex="1">
          <mxGeometry x="1590" y="1290" width="470" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-54" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1380" y="1370" width="773" height="78" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-55" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="2090" y="970" width="20" height="370" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-56" value="By default, most of these plugins have the same small weight (1 or 2). However, &lt;br&gt;in large, complex clusters, these defaults can lead to sub-optimal placement &lt;br&gt;(e.g., placing all your compute-heavy pods on the same node just because they already had the image pulled).&lt;br&gt;&lt;br&gt;OR&lt;br&gt;For example: It might place a critical API pod on a node that is already 90% full just because that node already had &lt;br&gt;the container image cached, leading to CPU contention later." style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="2120" y="1105" width="640" height="110" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-57" value="Example: if ImageLocality wants Node 1 and PodAffinity wants Node 2, the scheduler scores each node (0 to 100) per plugin, multiplies by the plugin's weight, and sums." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="2405" y="1389" width="590" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-58" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="2475.5" y="1460" width="449" height="62" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-59" value="&lt;b&gt;Default weights:&lt;/b&gt; most = &lt;b&gt;1&lt;/b&gt;; affinity/spread = &lt;b&gt;2&lt;/b&gt;; taints = &lt;b&gt;3&lt;/b&gt;." style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="2510" y="1540" width="350" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-61" value="&lt;b&gt;The Conflict:&lt;/b&gt; ImageLocality (weight 1) gives Node 1 &lt;b&gt;90&lt;/b&gt; = 90 pts. InterPodAffinity (weight 2) gives Node 2 a weak &lt;b&gt;40&lt;/b&gt; = 80 pts. &lt;b&gt;Node 1 wins&lt;/b&gt;, even though you asked for affinity." style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="2470" y="1580" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="hotQBRh_3EuXlNmoSv4f-62" target="hotQBRh_3EuXlNmoSv4f-64" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2510" y="1780" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-62" value="If you want &lt;code data-path-to-node=&quot;9&quot; data-index-in-node=&quot;17&quot;&gt;PodAffinity&lt;/code&gt; to &lt;i data-path-to-node=&quot;9&quot; data-index-in-node=&quot;32&quot;&gt;always&lt;/i&gt; beat &lt;code data-path-to-node=&quot;9&quot; data-index-in-node=&quot;44&quot;&gt;ImageLocality&lt;/code&gt;, you have two choices:" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="2470" y="1650" width="480" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-64" value="Choice A: The &quot;Hard&quot; Rule (Filtering)" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="2450" y="1750" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-65" value="Instead of using &lt;br&gt;&lt;b&gt;&quot;Preferred&quot;&lt;/b&gt; (&lt;code data-path-to-node=&quot;11&quot; data-index-in-node=&quot;30&quot;&gt;preferredDuringSchedulingIgnoredDuringExecution&lt;/code&gt;), use &lt;br&gt;&lt;b data-path-to-node=&quot;11&quot; data-index-in-node=&quot;84&quot;&gt;&quot;Required&quot;&lt;/b&gt; (&lt;code data-path-to-node=&quot;11&quot; data-index-in-node=&quot;96&quot;&gt;requiredDuringSchedulingIgnoredDuringExecution&lt;/code&gt;)." style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="2050" y="1820" width="560" height="50" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-66" value="This moves the rule from the &lt;b data-path-to-node=&quot;12,0,0&quot; data-index-in-node=&quot;29&quot;&gt;Scoring Phase&lt;/b&gt; to the &lt;b data-path-to-node=&quot;12,0,0&quot; data-index-in-node=&quot;50&quot;&gt;Filtering Phase&lt;/b&gt;." style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="2050" y="1900" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-67" value="Choice B: Scheduler Configuration (Advanced)" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="2770" y="1760" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.417;entryY=0.033;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="hotQBRh_3EuXlNmoSv4f-62" target="hotQBRh_3EuXlNmoSv4f-67" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-69" value="You can create a &lt;b data-path-to-node=&quot;14&quot; data-index-in-node=&quot;17&quot;&gt;KubeSchedulerConfiguration&lt;/b&gt; file. This is a cluster-level setting where you can explicitly change the weights. You could set &lt;code data-path-to-node=&quot;14&quot; data-index-in-node=&quot;141&quot;&gt;InterPodAffinity&lt;/code&gt; to a weight of &lt;b data-path-to-node=&quot;14&quot; data-index-in-node=&quot;173&quot;&gt;100&lt;/b&gt; and &lt;code data-path-to-node=&quot;14&quot; data-index-in-node=&quot;181&quot;&gt;ImageLocality&lt;/code&gt; to &lt;b data-path-to-node=&quot;14&quot; data-index-in-node=&quot;198&quot;&gt;1&lt;/b&gt;. This ensures that even a &quot;weak&quot; affinity match will always override an image cache match." style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="2610" y="1840" width="560" height="80" as="geometry" />
        </mxCell>
        <mxCell id="hotQBRh_3EuXlNmoSv4f-70" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="2210" y="1970" width="805" height="432.12" as="geometry" />
        </mxCell>
        <mxCell id="g95Lrz4OJurHxraLs-uW-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="g95Lrz4OJurHxraLs-uW-1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2960" y="2600.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="g95Lrz4OJurHxraLs-uW-1" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="2202" y="2440" width="696" height="321" as="geometry" />
        </mxCell>
        <mxCell id="g95Lrz4OJurHxraLs-uW-3" value="When you see a weight field in a Kubernetes YAML file, &lt;br&gt;you are essentially &quot;&lt;b&gt;&lt;u&gt;tuning&lt;/u&gt;&lt;/b&gt;&quot; the &lt;b&gt;Scoring &lt;/b&gt;Phase (not the Filtering phase) &lt;br&gt;from the outside. &lt;br&gt;You are telling the scheduler how much importance it should &lt;br&gt;give to that specific rule compared to its default internal rules." style="text;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;html=1;" parent="1" vertex="1">
          <mxGeometry x="2970" y="2555.5" width="410" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g95Lrz4OJurHxraLs-uW-4" value="The scheduler takes the &lt;code data-index-in-node=&quot;24&quot; data-path-to-node=&quot;7&quot;&gt;&lt;b&gt;weight&lt;/b&gt;&lt;/code&gt; you defined (1 to 100) &lt;br&gt;and adds it to the scores for any node that satisfies that condition.&lt;br&gt;&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;8,0,0&quot;&gt;For example:&lt;br&gt;Weight 100:&lt;/b&gt; You are saying, &quot;I REALLY want this. This rule should probably &lt;br&gt;override almost every other default scoring function (like ImageLocality or LeastAllocated).&quot;&lt;br&gt;&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;8,1,0&quot;&gt;Weight 1:&lt;/b&gt; You are saying, &quot;This would be nice, but if the node is a bit busy or doesn't have the image, don't worry about it.&quot;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="2970" y="2640" width="680" height="100" as="geometry" />
        </mxCell>
        <mxCell id="g95Lrz4OJurHxraLs-uW-5" value="" style="shape=flexArrow;endArrow=classic;html=1;rounded=0;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="2250" y="2520" as="sourcePoint" />
            <mxPoint x="2150" y="2520" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="g95Lrz4OJurHxraLs-uW-6" value="You will notice there is no weight field for requiredDuringSchedulingIgnoredDuringExecution.&#10;Why? Because &quot;Required&quot; is a filter, not a score" style="text;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="1583" y="2500" width="560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="g95Lrz4OJurHxraLs-uW-7" value="Required (Hard Rule)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1820" y="2570" width="140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="g95Lrz4OJurHxraLs-uW-8" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;18,1,0&quot;&gt;Preferred (Soft Rule) + High Weight:&lt;/b&gt; A very strong suggestion" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1720" y="2600" width="360" height="30" as="geometry" />
        </mxCell>
        <mxCell id="g95Lrz4OJurHxraLs-uW-9" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;18,2,0&quot;&gt;Preferred (Soft Rule) + Low Weight:&lt;/b&gt; A &quot;nice-to-have&quot;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1720" y="2630" width="310" height="30" as="geometry" />
        </mxCell>
        <mxCell id="g95Lrz4OJurHxraLs-uW-10" value="" style="shape=flexArrow;endArrow=classic;html=1;rounded=0;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="2220" y="2185.56" as="sourcePoint" />
            <mxPoint x="2130" y="2185.56" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="g95Lrz4OJurHxraLs-uW-11" value="If you &lt;b&gt;do not&lt;/b&gt; set a &lt;code data-path-to-node=&quot;0&quot; data-index-in-node=&quot;20&quot;&gt;&lt;b&gt;weight&lt;/b&gt;&lt;/code&gt; for a &lt;b data-path-to-node=&quot;0&quot; data-index-in-node=&quot;33&quot;&gt;Preferred&lt;/b&gt; rule, the YAML actually won't be valid" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1670" y="2166.06" width="460" height="40" as="geometry" />
        </mxCell>
        <mxCell id="g95Lrz4OJurHxraLs-uW-12" value="However, there is a &quot;default&quot; system at play regarding the &lt;b data-path-to-node=&quot;1&quot; data-index-in-node=&quot;59&quot;&gt;internal plugins&lt;/b&gt; &lt;br&gt;(the ones you don't see in your YAML, like &lt;b&gt;&lt;code data-path-to-node=&quot;1&quot; data-index-in-node=&quot;119&quot;&gt;LeastAllocated&lt;/code&gt; &lt;/b&gt;or &lt;code data-path-to-node=&quot;1&quot; data-index-in-node=&quot;137&quot;&gt;&lt;b&gt;ImageLocality&lt;/b&gt;&lt;/code&gt;)." style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1660" y="2210" width="560" height="50" as="geometry" />
        </mxCell>
        <mxCell id="g95Lrz4OJurHxraLs-uW-13" value="If you write a simple pod with &lt;b&gt;no affinity rules&lt;/b&gt;, the scheduler still scores nodes using its built-in plugins and default weights:&lt;br&gt;&lt;b&gt;NodeResourcesFit (LeastAllocated):&lt;/b&gt; 1&lt;br&gt;&lt;b&gt;BalancedAllocation:&lt;/b&gt; 1&lt;br&gt;&lt;b&gt;ImageLocality:&lt;/b&gt; 1&lt;br&gt;&lt;b&gt;InterPodAffinity / NodeAffinity / TopologySpread:&lt;/b&gt; 2&lt;br&gt;&lt;b&gt;TaintToleration:&lt;/b&gt; 3" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1642" y="2270" width="560" height="50" as="geometry" />
        </mxCell>
        <mxCell id="g95Lrz4OJurHxraLs-uW-14" value="" style="endArrow=classic;html=1;rounded=0;fillColor=#e51400;strokeColor=#B20000;strokeWidth=4;" parent="1" source="g95Lrz4OJurHxraLs-uW-16" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1533" y="1470" as="sourcePoint" />
            <mxPoint x="1583" y="1420" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="g95Lrz4OJurHxraLs-uW-16" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;3,0,0&quot;&gt;The Priority that is also called Score or &quot;Grade&quot;:&lt;/b&gt; This is a measurement of &lt;i data-index-in-node=&quot;50&quot; data-path-to-node=&quot;3,0,0&quot;&gt;&lt;b&gt;&lt;font color=&quot;#cc0000&quot;&gt;quality&lt;/font&gt;&lt;/b&gt;&lt;/i&gt;&lt;span class=&quot;citation-49 citation-end-49&quot;&gt;.&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt; &lt;br&gt;(e.g., &quot;How empty is this node?&quot; or &quot;How many matching pods are already here?&quot;)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1240" y="1480" width="480" height="50" as="geometry" />
        </mxCell>
        <mxCell id="g95Lrz4OJurHxraLs-uW-17" value="" style="endArrow=classic;html=1;rounded=0;fillColor=#e51400;strokeColor=#B20000;strokeWidth=4;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1810" y="1580" as="sourcePoint" />
            <mxPoint x="1723" y="1430" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="g95Lrz4OJurHxraLs-uW-18" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;3,1,0&quot;&gt;The Weight (The &quot;Multiplier&quot;):&lt;/b&gt; &lt;br&gt;This is a measurement of &lt;i data-index-in-node=&quot;56&quot; data-path-to-node=&quot;3,1,0&quot;&gt;importance&lt;/i&gt;." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1740" y="1580" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="g95Lrz4OJurHxraLs-uW-19" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="1550" y="1720" width="367" height="56" as="geometry" />
        </mxCell>
        <mxCell id="g95Lrz4OJurHxraLs-uW-20" value="" style="shape=flexArrow;endArrow=classic;html=1;rounded=0;entryX=0.779;entryY=-0.089;entryDx=0;entryDy=0;entryPerimeter=0;exitX=0.386;exitY=0.975;exitDx=0;exitDy=0;exitPerimeter=0;fillColor=#e3c800;strokeColor=#B09500;" parent="1" source="g95Lrz4OJurHxraLs-uW-18" target="g95Lrz4OJurHxraLs-uW-19" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1730" y="1620" as="sourcePoint" />
            <mxPoint x="1580" y="1670" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="g95Lrz4OJurHxraLs-uW-21" value="" style="shape=flexArrow;endArrow=classic;html=1;rounded=0;exitX=0.583;exitY=1.02;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.027;entryY=1.167;entryDx=0;entryDy=0;entryPerimeter=0;fillColor=#e3c800;strokeColor=#B09500;" parent="1" target="g95Lrz4OJurHxraLs-uW-22" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1530" y="1541" as="sourcePoint" />
            <mxPoint x="1590" y="1680" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="g95Lrz4OJurHxraLs-uW-22" value="For each priority we calculate a point and &lt;br&gt;add them together to get the final&lt;br&gt;score of that node" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1580" y="1650" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g95Lrz4OJurHxraLs-uW-23" value="" style="endArrow=classic;html=1;rounded=0;flowAnimation=1;" parent="1" source="g95Lrz4OJurHxraLs-uW-25" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1560" y="1780" as="sourcePoint" />
            <mxPoint x="1470" y="1900" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="g95Lrz4OJurHxraLs-uW-24" value="If a node has 10 cores and 2 cores &lt;br&gt;are requested, it is &lt;b data-index-in-node=&quot;56&quot; data-path-to-node=&quot;9&quot;&gt;80% free&lt;/b&gt;.&lt;br&gt;&lt;br&gt;The plugin looks at that 80% and says: &lt;br&gt;&lt;b data-index-in-node=&quot;39&quot; data-path-to-node=&quot;10,0,0&quot;&gt;&lt;br&gt;&quot;I give this node a Score of 80.&quot;&lt;br&gt;&lt;br&gt;Because the default internal &lt;b style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot; data-index-in-node=&quot;29&quot; data-path-to-node=&quot;10,1,0&quot;&gt;Weight&lt;/b&gt; is &lt;b style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot; data-index-in-node=&quot;39&quot; data-path-to-node=&quot;10,1,0&quot;&gt;1&lt;/b&gt;, the final points for this plugin are: 80 x&amp;nbsp; 1 = 80&lt;br&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1155" y="1900" width="520" height="130" as="geometry" />
        </mxCell>
        <mxCell id="g95Lrz4OJurHxraLs-uW-27" value="" style="endArrow=classic;html=1;rounded=0;flowAnimation=1;" parent="1" source="g95Lrz4OJurHxraLs-uW-19" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1570" y="1790" as="sourcePoint" />
            <mxPoint x="1840" y="1960" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="g95Lrz4OJurHxraLs-uW-28" value="Example: &lt;br&gt;&lt;code data-index-in-node=&quot;9&quot; data-path-to-node=&quot;11&quot;&gt;ImageLocality&lt;/code&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="1735" y="1865" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="g95Lrz4OJurHxraLs-uW-29" value="Score grows with the total size of the cached images (scaled by how many nodes have them).&#10;&#10;Big image fully cached: near 100.&#10;&#10;Nothing cached: Score = 0." style="text;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="1790" y="1960" width="370" height="180" as="geometry" />
        </mxCell>
        <mxCell id="g95Lrz4OJurHxraLs-uW-30" value="" style="endArrow=classic;html=1;rounded=0;flowAnimation=1;" parent="1" target="g95Lrz4OJurHxraLs-uW-25" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1560" y="1780" as="sourcePoint" />
            <mxPoint x="1470" y="1900" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="g95Lrz4OJurHxraLs-uW-25" value="&lt;b&gt;Example: &lt;br&gt;&lt;code data-index-in-node=&quot;9&quot; data-path-to-node=&quot;8&quot;&gt;LeastAllocated&lt;/code&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1450" y="1820" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="g95Lrz4OJurHxraLs-uW-31" value="This is the only one that its score &lt;br&gt;is set in YAML file by us, the rest are calculated by k8s internally" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1020" y="1310" width="360" height="40" as="geometry" />
        </mxCell>
        <mxCell id="g95Lrz4OJurHxraLs-uW-32" value="" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;flowAnimation=1;" parent="1" source="g95Lrz4OJurHxraLs-uW-31" target="hotQBRh_3EuXlNmoSv4f-52" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1520" y="1400" as="sourcePoint" />
            <mxPoint x="1570" y="1350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="CZsgLYgdaM03uP0BuLw1-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="CZsgLYgdaM03uP0BuLw1-1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="910" y="1710" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="CZsgLYgdaM03uP0BuLw1-1" value="Do not &lt;b&gt;mix &lt;/b&gt;&lt;u&gt;Scheduling score &lt;/u&gt;that is&amp;nbsp;&lt;br&gt;about selecting the node for a Pod&lt;br&gt;as opposed to QoS score (see EKS-Batch and Realtimetab) that is about killing a pod" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=#3A5431;fillColor=#6d8764;fontColor=#ffffff;" parent="1" vertex="1">
          <mxGeometry x="805" y="1570" width="480" height="60" as="geometry" />
        </mxCell>
        <mxCell id="CZsgLYgdaM03uP0BuLw1-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="CZsgLYgdaM03uP0BuLw1-3" target="CZsgLYgdaM03uP0BuLw1-4" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CZsgLYgdaM03uP0BuLw1-3" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;15,0,0&quot;&gt;The Scheduler's Choice:&lt;/b&gt; The Scheduler might see a node is 90% full and give it a &lt;b data-index-in-node=&quot;81&quot; data-path-to-node=&quot;15,0,0&quot;&gt;low score&lt;/b&gt; for a new pod because it wants to &quot;spread&quot; the load." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="680" y="1716" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="CZsgLYgdaM03uP0BuLw1-4" value="The Kubelet's Reality: Under memory pressure, nobody checks the Scheduler's grade. The kubelet evicts the pod furthest over its memory request (then by priority); if the kernel OOM killer fires first, it uses oom_score (usage + QoS-based oom_score_adj). So an &quot;important&quot; pod can still be killed." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="680" y="1865" width="310" height="115" as="geometry" />
        </mxCell>
        <mxCell id="SCeK3jIIOfRLTv7Rye0C-1" value="" style="image;html=1;image=img/lib/clip_art/general/Star_128x128.png" parent="1" vertex="1">
          <mxGeometry x="850" y="1500" width="80" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="d-gCeTiReeNkgITZuGhb" name="EKS-MultiScheduler">
    <mxGraphModel dx="3134" dy="1004" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="umDtUc2eK4rTreSWYbao-1" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="210" y="790" width="566" height="305.44" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-3" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;Workflow&lt;/font&gt;&lt;/b&gt;:&lt;/span&gt;&lt;/div&gt;You create a &lt;b&gt;Fargate Profile i&lt;/b&gt;n AWS that says: &lt;br&gt;&quot;Any pod in the&lt;b&gt; staging namespace&lt;/b&gt; with the label type: serverless should run on Fargate.&quot;&lt;br&gt;&lt;br&gt;You submit a standard Pod YAML to the API Server.The EKS &lt;b&gt;Mutating Webhook&lt;/b&gt; sees your pod, matches it against your profile, &lt;br&gt;and automatically &lt;b&gt;injects schedulerName: fargate-scheduler&lt;/b&gt; into your Pod spec before it ever reaches the scheduling phase." style="text;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;html=1;" parent="1" vertex="1">
          <mxGeometry x="160" y="105" width="700" height="110" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-4" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="170" y="239.99999999999994" width="637" height="342.45" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-5" value="How Pods reach the right scheduler&lt;br&gt;The API Server does not route Pods; it just stores them. Every scheduler watches for unscheduled Pods (no nodeName yet) and only picks up the ones whose schedulerName matches its own name, like separate &quot;buckets&quot;.&lt;br&gt;Bucket A (default-scheduler): The standard kube-scheduler (running on the control plane) takes these and places them on EC2 nodes.&lt;br&gt;Bucket B (fargate-scheduler): The AWS Fargate scheduler takes only these, ignores Bucket A, and spins up a dedicated micro-VM for each one." style="text;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=1;fontSize=17;html=1;" parent="1" vertex="1">
          <mxGeometry x="30" y="630" width="1220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-6" value="&lt;b style=&quot;font-size: 16px;&quot;&gt;Gang Scheduling (All-or-Nothing)&lt;br&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Standard Kubernetes&lt;/b&gt; schedules pods &lt;u&gt;one by one&lt;/u&gt;. &lt;br&gt;&lt;br&gt;In distributed ML training (like PyTorch or TensorFlow), you might have &lt;b&gt;8 workers that must start at the exact same time&lt;/b&gt; to perform a &quot;C&lt;font color=&quot;#ea6b66&quot;&gt;ollective Communication&quot; (All-Reduce)&lt;/font&gt; operation.&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#67ab9f&quot;&gt;&lt;br&gt;The Problem:&lt;/font&gt;&lt;/b&gt; If a cluster has room for &lt;b&gt;6 pods&lt;/b&gt;, a &lt;b&gt;standard scheduler&lt;/b&gt; will start those 6 and leave the last &lt;b&gt;2 &quot;Pending.&lt;/b&gt;&quot; The first 6 will sit idle, consuming expensive GPU time while waiting for resources that may never come.&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#ff0000&quot;&gt;The Custom Solution:&lt;/font&gt;&lt;/b&gt; A custom scheduler uses &lt;b&gt;Gang Scheduling&lt;/b&gt;. It won't start any pods unless the cluster has enough room for the entire training job." style="text;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;html=1;" parent="1" vertex="1">
          <mxGeometry x="60" y="1520" width="1210" height="160" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-7" value="&lt;h3 data-path-to-node=&quot;7&quot;&gt;Bin-Packing for GPU Topology&lt;/h3&gt;&lt;p data-path-to-node=&quot;8&quot;&gt;Standard schedulers might place two pods on two different physical nodes because they are &quot;&lt;b&gt;&lt;font color=&quot;#67ab9f&quot;&gt;LeastAllocated&lt;/font&gt;&lt;/b&gt;.&quot; In ML, this is a disaster for performance because &lt;b&gt;communication &lt;/b&gt;between those pods must now travel over the relatively slow network.&lt;/p&gt;&lt;ul data-path-to-node=&quot;9&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;9,0,0&quot;&gt;&lt;b data-path-to-node=&quot;9,0,0&quot; data-index-in-node=&quot;0&quot;&gt;The Goal:&lt;/b&gt; You want a scheduler that uses &lt;b data-path-to-node=&quot;9,0,0&quot; data-index-in-node=&quot;41&quot;&gt;MostAllocated (Bin-Packing)&lt;/b&gt; to squeeze pods onto the &lt;b&gt;same physical GPU node&lt;/b&gt;.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;9,1,0&quot;&gt;&lt;b data-path-to-node=&quot;9,1,0&quot; data-index-in-node=&quot;0&quot;&gt;The Benefit:&lt;/b&gt; This allows pods to communicate over &lt;b data-path-to-node=&quot;9,1,0&quot; data-index-in-node=&quot;50&quot;&gt;NVLink&lt;/b&gt; (which can be 10x–50x faster than standard Ethernet), drastically reducing training time.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="50" y="2175" width="560" height="210" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-8" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="290" y="1685" width="692" height="371.07" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-9" value="&lt;h3 style=&quot;font-size: 16px;&quot; data-path-to-node=&quot;11&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Queueing and Fair Sharing&lt;/font&gt;&lt;/h3&gt;&lt;p style=&quot;font-size: 16px;&quot; data-path-to-node=&quot;12&quot;&gt;In a shared research environment, one &quot;greedy&quot; user might submit 100 training jobs, locking out everyone else.&lt;/p&gt;&lt;ul data-path-to-node=&quot;13&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;13,0,0&quot;&gt;&lt;span class=&quot;citation-6&quot;&gt;&lt;/span&gt;&lt;b data-path-to-node=&quot;13,0,0&quot; data-index-in-node=&quot;0&quot;&gt;&lt;span class=&quot;citation-6&quot;&gt;Priority Queues:&lt;/span&gt;&lt;/b&gt;&lt;span class=&quot;citation-6&quot;&gt; Custom schedulers like &lt;/span&gt;&lt;b data-path-to-node=&quot;13,0,0&quot; data-index-in-node=&quot;40&quot;&gt;&lt;span class=&quot;citation-6&quot;&gt;&lt;font color=&quot;#ff0000&quot;&gt;Kueue&lt;/font&gt;&lt;/span&gt;&lt;/b&gt;&lt;span class=&quot;citation-6 citation-end-6&quot;&gt; allow you to create &quot;&lt;b&gt;Resource Flavors&lt;/b&gt;&quot; and &quot;&lt;b&gt;Workload Priorities.&lt;/b&gt;&quot;&lt;sup class=&quot;superscript&quot; data-turn-source-index=&quot;2&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;/p&gt;&lt;div class=&quot;source-inline-chip-container ng-star-inserted&quot;&gt;&lt;button class=&quot;button ng-star-inserted&quot; aria-label=&quot;View source details for citation from Red Hat. Opens side panel.&quot; data-hveid=&quot;0&quot; data-ved=&quot;0CAAQvoAQahgKEwjfpeOf3sqSAxUAAAAAHQAAAAAQ9AE&quot;&gt;&lt;/button&gt;&lt;/div&gt;&lt;p&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;13,1,0&quot;&gt;&lt;b data-path-to-node=&quot;13,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Preemption:&lt;/b&gt; You can configure the scheduler so that a high-priority &quot;&lt;b&gt;Inference&quot;&lt;/b&gt; pod (serving a live model) can &quot;&lt;b&gt;evict&lt;/b&gt;&quot; a low-priority &quot;Research Training&quot; pod if GPU resources become scarce.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="50" y="2585" width="560" height="230" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-10" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="690" y="2170" width="666" height="364.53" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-11" value="Hardware-Aware Scheduling (NVIDIA Blackwell/Vera Rubin)&lt;br&gt;As AI hardware becomes more specialized, custom schedulers can be programmed to look for specific hardware features that Kubernetes doesn't natively track well:&lt;br&gt;RDMA/InfiniBand: Scheduling pods on nodes that share the same high-speed InfiniBand switch.&lt;br&gt;Low-precision support: Directing specific workloads only to nodes whose GPUs support the formats they need, e.g. FP8 (Hopper and newer) or FP4 (Blackwell)." style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="3050" width="560" height="210" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-12" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="680" y="2590" width="638" height="347.11" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-13" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="160" y="1150" width="763" height="260" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-14" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="680" y="3000" width="829" height="449.52" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-15" value="&lt;h2 data-path-to-node=&quot;2&quot;&gt;&lt;span class=&quot;citation-19 citation-end-19&quot;&gt;Volcano: The Batch Processing Specialist&lt;sup class=&quot;superscript&quot; data-turn-source-index=&quot;1&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;/h2&gt;&lt;p data-path-to-node=&quot;3&quot;&gt;&lt;span class=&quot;citation-18&quot;&gt;&lt;/span&gt;&lt;b data-path-to-node=&quot;3&quot; data-index-in-node=&quot;0&quot;&gt;&lt;span class=&quot;citation-18&quot;&gt;Volcano&lt;/span&gt;&lt;/b&gt;&lt;span class=&quot;citation-18 citation-end-18&quot;&gt; is a full-featured, standalone batch scheduling system built on top of Kubernetes.&lt;sup class=&quot;superscript&quot; data-turn-source-index=&quot;2&quot;&gt;&lt;/sup&gt;&lt;/span&gt; It was originally donated by Huawei and is now a CNCF incubating project.&lt;/p&gt;&lt;div class=&quot;source-inline-chip-container ng-star-inserted&quot;&gt;&lt;button class=&quot;button ng-star-inserted&quot; aria-label=&quot;View source details for citation from Cloud Native Computing Foundation. Opens side panel.&quot; data-hveid=&quot;0&quot; data-ved=&quot;0CAAQvoAQahgKEwjfpeOf3sqSAxUAAAAAHQAAAAAQ6QI&quot;&gt;&lt;/button&gt;&lt;/div&gt;&lt;p&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;4&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;4,0,0&quot;&gt;&lt;span class=&quot;citation-17&quot;&gt;&lt;/span&gt;&lt;b data-path-to-node=&quot;4,0,0&quot; data-index-in-node=&quot;0&quot;&gt;&lt;span class=&quot;citation-17&quot;&gt;Best For:&lt;/span&gt;&lt;/b&gt;&lt;span class=&quot;citation-17 citation-end-17&quot;&gt; Long-running training jobs, Big Data (Spark/Flink), and High-Performance Computing (HPC).&lt;sup class=&quot;superscript&quot; data-turn-source-index=&quot;3&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;/p&gt;&lt;div class=&quot;source-inline-chip-container ng-star-inserted&quot;&gt;&lt;button class=&quot;button ng-star-inserted&quot; aria-label=&quot;View source details for citation from YouTube. Opens side panel.&quot; data-hveid=&quot;0&quot; data-ved=&quot;0CAAQvoAQahgKEwjfpeOf3sqSAxUAAAAAHQAAAAAQ6gI&quot;&gt;&lt;/button&gt;&lt;/div&gt;&lt;p&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;4,1,0&quot;&gt;&lt;b data-path-to-node=&quot;4,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Key Feature: Gang Scheduling.&lt;/b&gt; It treats a group of pods as a single &quot;Job.&quot; It won't start any of them until there are enough resources for all of them.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;4,2,0&quot;&gt;&lt;b data-path-to-node=&quot;4,2,0&quot; data-index-in-node=&quot;0&quot;&gt;How it works:&lt;/b&gt; It introduces a new &quot;Job&quot; custom resource (CRD). Instead of managing individual pods, you submit a &lt;code data-path-to-node=&quot;4,2,0&quot; data-index-in-node=&quot;113&quot;&gt;VolcanoJob&lt;/code&gt;.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="70" y="3580" width="560" height="300" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-16" value="&lt;h2 data-path-to-node=&quot;6&quot;&gt;Kueue: The Resource Quota Manager&lt;/h2&gt;&lt;p data-path-to-node=&quot;7&quot;&gt;&lt;span class=&quot;citation-16&quot;&gt;&lt;/span&gt;&lt;b data-path-to-node=&quot;7&quot; data-index-in-node=&quot;0&quot;&gt;&lt;span class=&quot;citation-16&quot;&gt;Kueue&lt;/span&gt;&lt;/b&gt;&lt;span class=&quot;citation-16 citation-end-16&quot;&gt; (pronounced &quot;Queue&quot;) is a newer, cloud-native job queueing controller.&lt;sup class=&quot;superscript&quot; data-turn-source-index=&quot;4&quot;&gt;&lt;/sup&gt;&lt;/span&gt; Unlike Volcano, which replaces the scheduling logic, Kueue acts as a &lt;b data-path-to-node=&quot;7&quot; data-index-in-node=&quot;146&quot;&gt;gatekeeper&lt;/b&gt; that sits &lt;i data-path-to-node=&quot;7&quot; data-index-in-node=&quot;167&quot;&gt;in front&lt;/i&gt; of the default scheduler.&lt;/p&gt;&lt;div class=&quot;source-inline-chip-container ng-star-inserted&quot;&gt;&lt;button class=&quot;button ng-star-inserted&quot; aria-label=&quot;View source details for citation from Thoughtworks. Opens side panel.&quot; data-hveid=&quot;0&quot; data-ved=&quot;0CAAQvoAQahgKEwjfpeOf3sqSAxUAAAAAHQAAAAAQ6wI&quot;&gt;&lt;/button&gt;&lt;/div&gt;&lt;p&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;8&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;8,0,0&quot;&gt;&lt;b data-path-to-node=&quot;8,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Best For:&lt;/b&gt; Shared clusters with many teams, multi-cloud environments, and &quot;Cloud Bursting.&quot;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;8,1,0&quot;&gt;&lt;b data-path-to-node=&quot;8,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Key Feature: Resource Quotas.&lt;/b&gt; &lt;span class=&quot;citation-15 citation-end-15&quot;&gt;It manages a global pool of resources (like &quot;100 NVIDIA A100 GPUs&quot;) and decides which jobs are allowed to enter the cluster based on who has the remaining quota.&lt;sup class=&quot;superscript&quot; data-turn-source-index=&quot;5&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;/p&gt;&lt;div class=&quot;source-inline-chip-container ng-star-inserted&quot;&gt;&lt;button class=&quot;button ng-star-inserted&quot; aria-label=&quot;View source details for citation from Medium. Opens side panel.&quot; data-hveid=&quot;0&quot; data-ved=&quot;0CAAQvoAQahgKEwjfpeOf3sqSAxUAAAAAHQAAAAAQ7AI&quot;&gt;&lt;/button&gt;&lt;/div&gt;&lt;p&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;8,2,0&quot;&gt;&lt;b data-path-to-node=&quot;8,2,0&quot; data-index-in-node=&quot;0&quot;&gt;How it works:&lt;/b&gt; It puts your jobs in a &quot;waitlist&quot; (a ClusterQueue). Once the resources are free, it &quot;admits&quot; the job, and the standard Kubernetes scheduler then places the pods.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="814.5" y="3570" width="560" height="330" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-17" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="320" y="3910" width="847" height="401" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="umDtUc2eK4rTreSWYbao-18" target="umDtUc2eK4rTreSWYbao-19" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="umDtUc2eK4rTreSWYbao-18" target="umDtUc2eK4rTreSWYbao-22" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-18" value="&lt;p data-path-to-node=&quot;15,0&quot;&gt;&lt;b data-path-to-node=&quot;15,0&quot; data-index-in-node=&quot;0&quot;&gt;The Scenario:&lt;/b&gt; Team A submits a job needing 4 GPUs. Team B submits a job needing 4 GPUs. Your cluster only has 4 total.&lt;/p&gt;&lt;ul data-path-to-node=&quot;15,1&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;15,1,0,0&quot;&gt;&lt;b data-path-to-node=&quot;15,1,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Standard K8s:&lt;/b&gt; Might give 2 to Team A and 2 to Team B. Now &lt;b data-path-to-node=&quot;15,1,0,0&quot; data-index-in-node=&quot;58&quot;&gt;both&lt;/b&gt; jobs are stuck waiting for the other 2 GPUs, but neither will ever finish.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;15,1,1,0&quot;&gt;&lt;b data-path-to-node=&quot;15,1,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Volcano/Kueue:&lt;/b&gt; Will give all 4 to Team A. Team A finishes quickly, then Team B gets the whole cluster. This results in much higher &quot;Cluster Utilization.&quot;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="360" y="4340" width="560" height="160" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-19" value="&lt;p data-path-to-node=&quot;3&quot;&gt;&lt;b&gt;Volcano &lt;/b&gt;excels in scenarios where a single &quot;Job&quot; has different types of pods that rely on each other to start.&lt;/p&gt;&lt;p data-path-to-node=&quot;4&quot;&gt;&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;4&quot;&gt;Scenario: Distributed ML with a &quot;Master&quot; and &quot;Worker&quot; setup.&lt;/b&gt;&lt;br/&gt;In a PyTorch training job, you often have one &lt;b data-index-in-node=&quot;107&quot; data-path-to-node=&quot;4&quot;&gt;Master&lt;/b&gt; pod and multiple &lt;b data-index-in-node=&quot;131&quot; data-path-to-node=&quot;4&quot;&gt;Worker&lt;/b&gt; pods.&lt;/p&gt;&lt;ul data-path-to-node=&quot;5&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,0,0&quot;&gt;&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;5,0,0&quot;&gt;The Problem:&lt;/b&gt; If you start the workers but the master pod fails the &quot;Filtering Phase&quot; because of a port conflict, the workers will sit idle forever.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,1,0&quot;&gt;&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;5,1,0&quot;&gt;Volcano's Solution:&lt;/b&gt;&lt;span class=&quot;citation-30&quot;&gt; Volcano supports &lt;/span&gt;&lt;b data-index-in-node=&quot;37&quot; data-path-to-node=&quot;5,1,0&quot;&gt;Task-level dependencies&lt;/b&gt;&lt;span class=&quot;citation-30 citation-end-30&quot;&gt;.&lt;sup data-turn-source-index=&quot;1&quot; class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt; It can be configured to say: &quot;Only start the 100 Workers if, and only if, the Master pod is successfully placed.&quot; Standard Kubernetes (and therefore Kueue) doesn't understand these internal relationships between different pod types within the same job.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="120" y="4600" width="600" height="270" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-21" value="Volcano's Strength: Complex Task Dependencies" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=1;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="285" y="4520" width="350" height="30" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-22" value="&lt;h3 data-path-to-node=&quot;7&quot;&gt;&lt;span style=&quot;background-color: initial; font-size: 12px; font-weight: normal;&quot;&gt;Kueue excels in a corporate environment where multiple departments share a fixed, expensive resource pool (like 128 GPUs).&lt;/span&gt;&lt;br&gt;&lt;/h3&gt;&lt;p data-path-to-node=&quot;9&quot;&gt;&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;9&quot;&gt;Scenario: Departmental Quotas with &quot;Resource Borrowing.&quot;&lt;/b&gt;&lt;br&gt;Imagine the &lt;b data-index-in-node=&quot;69&quot; data-path-to-node=&quot;9&quot;&gt;Marketing Team&lt;/b&gt; has a quota of 10 GPUs and the &lt;b data-index-in-node=&quot;115&quot; data-path-to-node=&quot;9&quot;&gt;Data Science Team&lt;/b&gt; has 50.&lt;/p&gt;&lt;ul data-path-to-node=&quot;10&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;10,0,0&quot;&gt;&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;10,0,0&quot;&gt;The Scenario:&lt;/b&gt; It’s Friday night. The Marketing Team is away, and their 10 GPUs are sitting idle. The Data Science team has a massive deadline and needs 60 GPUs.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;10,1,0&quot;&gt;&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;10,1,0&quot;&gt;Kueue's Solution:&lt;/b&gt;&lt;span class=&quot;citation-29&quot;&gt; Kueue allows &lt;/span&gt;&lt;b data-index-in-node=&quot;31&quot; data-path-to-node=&quot;10,1,0&quot;&gt;Resource Sharing/Borrowing&lt;/b&gt;&lt;span class=&quot;citation-29 citation-end-29&quot;&gt;.&lt;sup data-turn-source-index=&quot;2&quot; class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt; It can see that Marketing’s &quot;Cohort&quot; is empty and temporarily &quot;lend&quot; those 10 GPUs to Data Science. &lt;span class=&quot;citation-28&quot;&gt;However, it also handles &lt;/span&gt;&lt;b data-index-in-node=&quot;184&quot; data-path-to-node=&quot;10,1,0&quot;&gt;Preemption&lt;/b&gt;&lt;span class=&quot;citation-28 citation-end-28&quot;&gt;: if a Marketing person suddenly submits a job on Saturday morning, Kueue can automatically evict the &quot;borrowed&quot; Data Science job to give Marketing their guaranteed resources back.&lt;sup data-turn-source-index=&quot;3&quot; class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;10,1,0&quot;&gt;&lt;span class=&quot;citation-28 citation-end-28&quot;&gt;&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;10,2,0&quot;&gt;Why not Volcano?&lt;/b&gt; Volcano is focused on the &lt;i data-index-in-node=&quot;43&quot; data-path-to-node=&quot;10,2,0&quot;&gt;performance&lt;/i&gt; of the individual job, not the &lt;i data-index-in-node=&quot;86&quot; data-path-to-node=&quot;10,2,0&quot;&gt;economic fairness&lt;/i&gt; and quota management across a multi-tenant organization.&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="880" y="4600" width="650" height="270" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-24" value="&lt;h3 style=&quot;border-color: var(--border-color);&quot; data-path-to-node=&quot;7&quot;&gt;Kueue's Strength: Multi-Team Fair Sharing &amp;amp; &quot;Borrowing&quot;&lt;/h3&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="840" y="4500" width="410" height="70" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-25" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="160" y="5047" width="857" height="453" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-26" value="" style="endArrow=classic;html=1;rounded=0;flowAnimation=1;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="80" y="3060" as="sourcePoint" />
            <mxPoint x="130" y="3010" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-27" value="" style="endArrow=classic;html=1;rounded=0;flowAnimation=1;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="261.5" y="2635" as="sourcePoint" />
            <mxPoint x="311.5" y="2585" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-28" value="" style="endArrow=classic;html=1;rounded=0;flowAnimation=1;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="180" y="1520" as="sourcePoint" />
            <mxPoint x="300" y="1480" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-29" value="&lt;b data-path-to-node=&quot;8,0,0&quot; data-index-in-node=&quot;0&quot;&gt;&lt;span class=&quot;citation-14&quot;&gt;Best at this:&lt;/span&gt;&lt;/b&gt;&lt;span class=&quot;citation-14&quot;&gt; &lt;/span&gt;&lt;b data-path-to-node=&quot;8,0,0&quot; data-index-in-node=&quot;14&quot;&gt;&lt;span class=&quot;citation-14&quot;&gt;Volcano&lt;/span&gt;&lt;/b&gt;&lt;span class=&quot;citation-14&quot;&gt; and &lt;/span&gt;&lt;b data-path-to-node=&quot;8,0,0&quot; data-index-in-node=&quot;26&quot;&gt;&lt;span class=&quot;citation-14&quot;&gt;KAI&lt;/span&gt;&lt;/b&gt;&lt;span class=&quot;citation-14 citation-end-14&quot;&gt; are specifically built for this &quot;atomic&quot; scheduling.&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;" parent="1" vertex="1">
          <mxGeometry x="311.5" y="1470" width="460" height="40" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-30" value="&lt;b data-path-to-node=&quot;11,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Best at this:&lt;/b&gt; &lt;b data-path-to-node=&quot;11,0,0&quot; data-index-in-node=&quot;14&quot;&gt;KAI Scheduler&lt;/b&gt; (it uses NVIDIA's GPU Operator to see the exact NVLink fabric)." style="text;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;" parent="1" vertex="1">
          <mxGeometry x="160" y="2100" width="530" height="40" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-31" value="" style="endArrow=classic;html=1;rounded=0;flowAnimation=1;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="140" y="2190" as="sourcePoint" />
            <mxPoint x="190" y="2140" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-32" value="" style="endArrow=classic;html=1;rounded=0;flowAnimation=1;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="390" y="2350" as="sourcePoint" />
            <mxPoint x="420" y="2440" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-33" value="&lt;b data-path-to-node=&quot;10&quot; data-index-in-node=&quot;51&quot;&gt;&lt;span class=&quot;citation-13&quot;&gt;Topology-aware bin-packing&lt;/span&gt;&lt;/b&gt;&lt;span class=&quot;citation-13&quot;&gt; looks at &lt;/span&gt;&lt;i data-path-to-node=&quot;10&quot; data-index-in-node=&quot;87&quot;&gt;&lt;span class=&quot;citation-13&quot;&gt;how&lt;/span&gt;&lt;/i&gt;&lt;span class=&quot;citation-13 citation-end-13&quot;&gt; the GPUs are connected.&lt;sup class=&quot;superscript&quot; data-turn-source-index=&quot;5&quot;&gt;&lt;/sup&gt;&lt;/span&gt; &lt;span class=&quot;citation-12&quot;&gt;For example, on an NVIDIA HGX system, it ensures pods that talk to each other are placed on GPUs connected by &lt;/span&gt;&lt;b data-path-to-node=&quot;10&quot; data-index-in-node=&quot;225&quot;&gt;&lt;span class=&quot;citation-12&quot;&gt;NVLink&lt;/span&gt;&lt;/b&gt;&lt;span class=&quot;citation-12&quot;&gt; (fast) rather than just &lt;/span&gt;&lt;b data-path-to-node=&quot;10&quot; data-index-in-node=&quot;256&quot;&gt;&lt;span class=&quot;citation-12&quot;&gt;PCIe&lt;/span&gt;&lt;/b&gt;&lt;span class=&quot;citation-12 citation-end-12&quot;&gt; (slow)&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;" parent="1" vertex="1">
          <mxGeometry x="120" y="2440" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-34" value="&lt;b data-path-to-node=&quot;14,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Best at this:&lt;/b&gt; &lt;b data-path-to-node=&quot;14,0,0&quot; data-index-in-node=&quot;14&quot;&gt;Apache YuniKorn&lt;/b&gt; and &lt;b data-path-to-node=&quot;14,0,0&quot; data-index-in-node=&quot;34&quot;&gt;Run:ai (via KAI)&lt;/b&gt;." style="text;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;" parent="1" vertex="1">
          <mxGeometry x="260" y="2540" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-35" value="If multiple teams (e.g., Data Science vs. &lt;span class=&quot;citation-11 citation-end-11&quot;&gt;Research) share a cluster, &quot;Fair Sharing&quot; ensures that if the cluster is idle, one team can take it all, but as soon as the other team submits a job, the first team's &quot;over-quota&quot; pods are preempted to give the second team their fair share.&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;" parent="1" vertex="1">
          <mxGeometry x="120" y="2820" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-36" value="&lt;b data-path-to-node=&quot;17,0,0&quot; data-index-in-node=&quot;11&quot;&gt;&lt;span class=&quot;citation-9&quot;&gt;NVIDIA KAI Scheduler&lt;/span&gt;&lt;/b&gt;&lt;span class=&quot;citation-9 citation-end-9&quot;&gt;.&lt;sup class=&quot;superscript&quot; data-turn-source-index=&quot;9&quot;&gt;&lt;/sup&gt;&lt;/span&gt; It is being updated specifically to manage the rack-scale integration of &lt;b data-path-to-node=&quot;17,0,0&quot; data-index-in-node=&quot;106&quot;&gt;Vera Rubin NVL72&lt;/b&gt; systems, where the entire rack acts as a single massive GPU." style="text;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;" parent="1" vertex="1">
          <mxGeometry x="140" y="2970" width="560" height="60" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-37" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="165.5" y="5530" width="846" height="408" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-38" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1290" y="1580" width="20" height="120" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-39" value="Can we do it through standard scheduler?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#647687;fontColor=#ffffff;strokeColor=#314354;" parent="1" vertex="1">
          <mxGeometry x="1330" y="1610" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-40" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1460" y="1580" width="20" height="120" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-41" value="&lt;b&gt;Standard Method:&lt;/b&gt; You can’t force the scheduler to do an &quot;All-or-Nothing&quot; start.&lt;br&gt;&lt;br&gt;&lt;b&gt;The &quot;Workaround&quot;: &lt;/b&gt;You manually calculate your cluster size. If you have 8 workers, you ensure your cluster has exactly 8 (or more) GPU slots available before you hit kubectl apply.&lt;br&gt;&lt;br&gt;&lt;b&gt;The Failure Point:&lt;/b&gt; In a shared cluster, if a coworker submits a small 1-GPU pod 1 second before you, they might &quot;steal&quot; one of your slots. Your job starts with 7 workers, hangs, and you waste money. Standard K8s has no way to say &quot;Hold these 7 slots until the 8th is free.&quot;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1490" y="1580" width="560" height="230" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-42" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1520" y="2250" width="20" height="120" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-43" value="Can we do it through standard scheduler?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#647687;fontColor=#ffffff;strokeColor=#314354;" parent="1" vertex="1">
          <mxGeometry x="1389" y="2280" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-45" value="&lt;b&gt;Standard Method:&lt;/b&gt; Use &lt;u&gt;Pod Affinity&lt;/u&gt; and &lt;u&gt;Node Selectors&lt;/u&gt;.&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;The &quot;Workaround&lt;/b&gt;&quot;: &lt;br&gt;-affinity:&lt;br&gt;podAffinity:requiredDuringSchedulingIgnoredDuringExecution&lt;br&gt;&lt;br&gt;- label&lt;br&gt;Selector:matchLabels:&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#09;&lt;/span&gt;job: my-training-runtopology&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#09;&lt;/span&gt;Key: &quot;kubernetes.io/hostname&lt;br&gt;&lt;br&gt;&lt;b&gt;The Result: &lt;/b&gt;This forces Pod 2 to go exactly where Pod 1 went.&lt;br&gt;&lt;br&gt;&lt;b&gt;The Failure Point&lt;/b&gt;: This only works if Pod 1 finds a home. If you have 100 pods, writing these rules for every single pod becomes a management nightmare. A custom scheduler does this automatically for the whole &quot;batch.&quot;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1560" y="2220" width="560" height="360" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-46" value="Can we do it through standard scheduler?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#647687;fontColor=#ffffff;strokeColor=#314354;" parent="1" vertex="1">
          <mxGeometry x="1400" y="2720" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-47" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1540" y="2680" width="20" height="120" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-48" value="&lt;b style=&quot;background-color: initial;&quot; data-path-to-node=&quot;11,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Standard Method:&lt;/b&gt;&lt;span style=&quot;background-color: initial;&quot;&gt; Use &lt;/span&gt;&lt;b style=&quot;background-color: initial;&quot; data-path-to-node=&quot;11,0,0&quot; data-index-in-node=&quot;21&quot;&gt;ResourceQuotas&lt;/b&gt;&lt;span style=&quot;background-color: initial;&quot;&gt; per Namespace.&lt;br&gt;&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;background-color: initial;&quot; data-path-to-node=&quot;11,1,0&quot; data-index-in-node=&quot;0&quot;&gt;The &quot;Workaround&quot;:&lt;/b&gt;&lt;span style=&quot;background-color: initial;&quot;&gt; You give the &quot;Marketing Team&quot; a namespace with a hard limit of 10 GPUs.&lt;/span&gt;&lt;br&gt;&lt;p style=&quot;background-color: initial; display: inline !important;&quot; data-path-to-node=&quot;11,2,0&quot;&gt;&lt;b data-path-to-node=&quot;11,2,0&quot; data-index-in-node=&quot;0&quot;&gt;&lt;br&gt;The Failure Point:&lt;/b&gt; Standard ResourceQuotas are &lt;b data-path-to-node=&quot;11,2,0&quot; data-index-in-node=&quot;47&quot;&gt;static and &quot;dumb.&quot;&lt;/b&gt;&amp;nbsp; &lt;br&gt;If Marketing isn't using their 10 GPUs, those GPUs sit empty. Other teams &lt;b data-path-to-node=&quot;11,2,0&quot; data-index-in-node=&quot;142&quot;&gt;cannot borrow them&lt;/b&gt;.&lt;br&gt;&lt;/p&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;If a team hits their limit, their pod just &lt;/span&gt;&lt;b style=&quot;background-color: initial;&quot; data-path-to-node=&quot;11,2,1,0,0&quot; data-index-in-node=&quot;43&quot;&gt;fails&lt;/b&gt;&lt;span style=&quot;background-color: initial;&quot;&gt; immediately with an error. It doesn't &quot;wait in line&quot; (queue) to start automatically when space opens up.&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1570" y="2650" width="560" height="240" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-49" value="Can we do it through standard scheduler?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#647687;fontColor=#ffffff;strokeColor=#314354;" parent="1" vertex="1">
          <mxGeometry x="1560" y="3170" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-50" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1690" y="3140" width="20" height="120" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-51" value="&lt;ul&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;14,0,0&quot;&gt;&lt;b data-path-to-node=&quot;14,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Standard Method:&lt;/b&gt; Use &lt;b data-path-to-node=&quot;14,0,0&quot; data-index-in-node=&quot;21&quot;&gt;Taints, Tolerations, and Labels&lt;/b&gt;.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;14,1,0&quot;&gt;&lt;b data-path-to-node=&quot;14,1,0&quot; data-index-in-node=&quot;0&quot;&gt;The &quot;Workaround&quot;:&lt;/b&gt; You manually label your Blackwell nodes with &lt;code data-path-to-node=&quot;14,1,0&quot; data-index-in-node=&quot;63&quot;&gt;gpu-gen=blackwell&lt;/code&gt; and your InfiniBand nodes with &lt;code data-path-to-node=&quot;14,1,0&quot; data-index-in-node=&quot;112&quot;&gt;network=infiniband&lt;/code&gt;. You then add &lt;code data-path-to-node=&quot;14,1,0&quot; data-index-in-node=&quot;145&quot;&gt;nodeSelectors&lt;/code&gt; to your AI pods.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;14,2,0&quot;&gt;&lt;b data-path-to-node=&quot;14,2,0&quot; data-index-in-node=&quot;0&quot;&gt;The Failure Point:&lt;/b&gt; This works well! This is actually how most people start. The custom scheduler only becomes necessary when you have &lt;b data-path-to-node=&quot;14,2,0&quot; data-index-in-node=&quot;134&quot;&gt;thousands of nodes&lt;/b&gt; and you don't want to manually manage labels and selectors for every single hardware iteration (FP8, HBM3, NVLink v4, etc.).&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1700" y="3120" width="560" height="240" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-52" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="2200" y="2790" width="857" height="298" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-55" value="" style="endArrow=classic;html=1;rounded=0;deletable=0;snapToPoint=1;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="850" y="3580" as="sourcePoint" />
            <mxPoint x="900" y="3530" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-56" value="&lt;span class=&quot;citation-48 interactive-span-hovered&quot;&gt;It doesn't replace the scheduler; it manages &lt;/span&gt;&lt;b data-path-to-node=&quot;10,0,0&quot; data-index-in-node=&quot;61&quot;&gt;&lt;span class=&quot;citation-48 interactive-span-hovered&quot;&gt;Resource Quotas&lt;/span&gt;&lt;/b&gt;&lt;span class=&quot;citation-48 interactive-span-hovered&quot;&gt; and &lt;/span&gt;&lt;b data-path-to-node=&quot;10,0,0&quot; data-index-in-node=&quot;81&quot;&gt;&lt;span class=&quot;citation-48 interactive-span-hovered&quot;&gt;Fair Sharing&lt;/span&gt;&lt;/b&gt;&lt;span class=&quot;citation-48 interactive-span-hovered&quot;&gt; &lt;/span&gt;&lt;i data-path-to-node=&quot;10,0,0&quot; data-index-in-node=&quot;94&quot;&gt;&lt;span class=&quot;citation-48 interactive-span-hovered&quot;&gt;before&lt;/span&gt;&lt;/i&gt;&lt;span class=&quot;citation-48 citation-end-48 interactive-span-hovered&quot;&gt; pods are created.&lt;br&gt;&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;10,1,0&quot;&gt;Best For:&lt;/b&gt; Multi-tenant clusters where teams need to &quot;borrow&quot; resources from each other (e.g., Marketing borrowing GPUs from Data Science on the weekend).&lt;br&gt;&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;" parent="1" vertex="1">
          <mxGeometry x="-530" y="5650" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-57" value="" style="endArrow=classic;html=1;rounded=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" target="umDtUc2eK4rTreSWYbao-58" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="170" y="5840" as="sourcePoint" />
            <mxPoint x="80" y="5840" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-58" value="&lt;b data-path-to-node=&quot;13,0,0&quot; data-index-in-node=&quot;16&quot;&gt;Fractional GPUs.&lt;/b&gt; It can take a single &lt;b&gt;A100 GPU&lt;/b&gt; and split it between multiple small research jobs (Hardware-Awareness) while still providing a centralized &quot;Fair Share&quot; dashboard for managers.&lt;br&gt;&lt;br&gt;&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;13,1,0&quot;&gt;Best For:&lt;/b&gt; Large enterprises that need a polished UI and strict cost/quota management for expensive H100/Blackwell clusters." style="text;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;" parent="1" vertex="1">
          <mxGeometry x="-500" y="5860" width="560" height="90" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-59" value="It is a &lt;b data-path-to-node=&quot;7,0,0&quot; data-index-in-node=&quot;24&quot;&gt;full &lt;font color=&quot;#67ab9f&quot;&gt;replacement&lt;/font&gt;&lt;/b&gt; for the default scheduler. &lt;span class=&quot;citation-52 citation-end-52&quot;&gt;It understands &quot;Jobs&quot; instead of just &quot;Pods.&quot;&lt;br&gt;&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;7,1,0&quot;&gt;Best For:&lt;/b&gt;&lt;span class=&quot;citation-51&quot;&gt; When you need deeply integrated &lt;/span&gt;&lt;b data-index-in-node=&quot;42&quot; data-path-to-node=&quot;7,1,0&quot;&gt;&lt;span class=&quot;citation-51&quot;&gt;Gang Scheduling&lt;/span&gt;&lt;/b&gt;&lt;span class=&quot;citation-51&quot;&gt; and &lt;/span&gt;&lt;b data-index-in-node=&quot;62&quot; data-path-to-node=&quot;7,1,0&quot;&gt;&lt;span class=&quot;citation-51&quot;&gt;NVLink topology awareness&lt;/span&gt;&lt;/b&gt;&lt;span class=&quot;citation-51 citation-end-51&quot;&gt; in a single tool&lt;/span&gt;&lt;br&gt;&lt;sup class=&quot;superscript&quot; data-turn-source-index=&quot;2&quot;&gt;&lt;/sup&gt;&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;" parent="1" vertex="1">
          <mxGeometry x="-510" y="5540" width="530" height="80" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-60" value="" style="endArrow=classic;html=1;rounded=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" target="umDtUc2eK4rTreSWYbao-59" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="160" y="5671" as="sourcePoint" />
            <mxPoint x="80" y="5670" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-61" value="" style="endArrow=classic;html=1;rounded=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" target="umDtUc2eK4rTreSWYbao-56" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="166" y="5751" as="sourcePoint" />
            <mxPoint x="86" y="5750" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-62" value="&lt;ul&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;16,0,0&quot;&gt;&lt;span class=&quot;citation-46&quot;&gt; It is a &lt;/span&gt;&lt;b data-path-to-node=&quot;16,0,0&quot; data-index-in-node=&quot;24&quot;&gt;&lt;span class=&quot;citation-46&quot;&gt;Meta-Scheduler&lt;/span&gt;&lt;/b&gt;&lt;span class=&quot;citation-46 citation-end-46&quot;&gt;.&lt;sup class=&quot;superscript&quot; data-turn-source-index=&quot;8&quot;&gt;&lt;/sup&gt;&lt;/span&gt; It can look at five different Kubernetes clusters and decide which one has the best &quot;Bin-Packing&quot; opportunity for your job.&lt;/p&gt;&lt;div class=&quot;source-inline-chip-container ng-star-inserted&quot;&gt;&lt;button class=&quot;button ng-star-inserted&quot; aria-label=&quot;View source details for citation from Armada Project. Opens side panel.&quot; data-hveid=&quot;0&quot; data-ved=&quot;0CAAQvoAQahgKEwjfpeOf3sqSAxUAAAAAHQAAAAAQygM&quot;&gt;&lt;/button&gt;&lt;/div&gt;&lt;p&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;16,1,0&quot;&gt;&lt;b data-path-to-node=&quot;16,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Best For:&lt;/b&gt;&lt;span class=&quot;citation-45 citation-end-45&quot;&gt; Truly massive scale where a single cluster is too small for your training needs.&lt;sup class=&quot;superscript&quot; data-turn-source-index=&quot;9&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;" parent="1" vertex="1">
          <mxGeometry x="-520" y="5730" width="560" height="120" as="geometry" />
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-63" value="" style="endArrow=classic;html=1;rounded=0;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="170" y="5800" as="sourcePoint" />
            <mxPoint x="70" y="5800" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-64" value="" style="endArrow=classic;html=1;rounded=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="200" y="5985" as="sourcePoint" />
            <mxPoint x="90" y="6050" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="umDtUc2eK4rTreSWYbao-65" value="YuniKorn was originally built to bring the advanced scheduling power of Hadoop (YARN) to Kubernetes. It acts as a replacement (or shim) for the default scheduler." style="text;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;" parent="1" vertex="1">
          <mxGeometry x="-470" y="6050" width="560" height="50" as="geometry" />
        </mxCell>
        <mxCell id="vo3AudWaQGGBbJ5Jqp5l-1" value="&lt;p class=&quot;query-text-line ng-star-inserted&quot; style=&quot;margin: 0px; color: rgb(227, 227, 227); font-family: &amp;quot;Google Sans Flex&amp;quot;, &amp;quot;Google Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: none; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(40, 42, 44); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Regardless of which scheduler you pick, you will likely use the NVIDIA GPU Operator or NVIDIA Device Plugin. These tools &quot;tell&quot; the scheduler exactly what hardware is inside the box.&lt;/p&gt;&lt;p class=&quot;query-text-line ng-star-inserted&quot; style=&quot;margin: 0px; color: rgb(227, 227, 227); font-family: &amp;quot;Google Sans Flex&amp;quot;, &amp;quot;Google Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: none; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(40, 42, 44); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;br class=&quot;ng-star-inserted&quot;&gt;&lt;/p&gt;&lt;p class=&quot;query-text-line ng-star-inserted&quot; style=&quot;margin: 0px; color: rgb(227, 227, 227); font-family: &amp;quot;Google Sans Flex&amp;quot;, &amp;quot;Google Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: none; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(40, 42, 44); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;NVIDIA Device Plugin: Advertises nvidia.com/gpu to the API server.&lt;/p&gt;&lt;p class=&quot;query-text-line ng-star-inserted&quot; style=&quot;margin: 0px; color: rgb(227, 227, 227); font-family: &amp;quot;Google Sans Flex&amp;quot;, &amp;quot;Google Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: none; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(40, 42, 44); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Network Topology Operator: Advertises infiniband or rdma status so the scheduler can group pods on the same high-speed switch.&lt;/p&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-490" y="6240" width="560" height="160" as="geometry" />
        </mxCell>
        <mxCell id="vo3AudWaQGGBbJ5Jqp5l-2" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" parent="1" vertex="1">
          <mxGeometry x="108" y="6150" width="1248" height="668" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="D1vWjax-hP7ZYdcaMQoQ" name="EKS Pod Networking">
    <mxGraphModel dx="1235" dy="731" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="Tu4LD_z154tAdkzWn4kH-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="Tu4LD_z154tAdkzWn4kH-1" target="Tu4LD_z154tAdkzWn4kH-2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Tu4LD_z154tAdkzWn4kH-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="Tu4LD_z154tAdkzWn4kH-1" target="Tu4LD_z154tAdkzWn4kH-11" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Tu4LD_z154tAdkzWn4kH-1" value="Core Architecture" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="50" y="330" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Tu4LD_z154tAdkzWn4kH-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="Tu4LD_z154tAdkzWn4kH-2" target="Tu4LD_z154tAdkzWn4kH-5" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Tu4LD_z154tAdkzWn4kH-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="Tu4LD_z154tAdkzWn4kH-2" target="Tu4LD_z154tAdkzWn4kH-7" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Tu4LD_z154tAdkzWn4kH-10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="Tu4LD_z154tAdkzWn4kH-2" target="Tu4LD_z154tAdkzWn4kH-9" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Tu4LD_z154tAdkzWn4kH-2" value="VPC CNI Plugin (aws-node DaemonSet)" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="290" y="210" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Tu4LD_z154tAdkzWn4kH-5" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;4,0,1,0,0&quot;&gt;L-IPAM (Local IP Address Manager):&lt;/b&gt; &lt;br&gt;Runs on each node; maintains &quot;&lt;b&gt;&lt;font color=&quot;#67ab9f&quot;&gt;warm pool&lt;/font&gt;&lt;/b&gt;&quot; of IPs; manages ENI lifecycle." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="530" y="140" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Tu4LD_z154tAdkzWn4kH-7" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;4,0,1,1,0&quot;&gt;CNI Plugin Binary:&lt;/b&gt; &lt;br&gt;Triggered by &lt;code data-index-in-node=&quot;32&quot; data-path-to-node=&quot;4,0,1,1,0&quot;&gt;&lt;u&gt;&lt;b&gt;kubelet&lt;/b&gt;&lt;/u&gt;&lt;/code&gt; during pod creation; configures net namespaces and &lt;u&gt;&lt;b&gt;&lt;code data-index-in-node=&quot;91&quot; data-path-to-node=&quot;4,0,1,1,0&quot;&gt;veth&lt;/code&gt; &lt;/b&gt;&lt;/u&gt;pairs." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="532" y="260" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Tu4LD_z154tAdkzWn4kH-9" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;4,0,1,2,0&quot;&gt;ipamd (IP Management Daemon):&lt;/b&gt; &lt;br&gt;Communicates with EC2 API; allocates/deallocates ENIs; updates node routing." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="532" y="360" width="288" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Tu4LD_z154tAdkzWn4kH-15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="Tu4LD_z154tAdkzWn4kH-11" target="Tu4LD_z154tAdkzWn4kH-13" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Tu4LD_z154tAdkzWn4kH-17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="Tu4LD_z154tAdkzWn4kH-11" target="Tu4LD_z154tAdkzWn4kH-16" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Tu4LD_z154tAdkzWn4kH-19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="Tu4LD_z154tAdkzWn4kH-11" target="Tu4LD_z154tAdkzWn4kH-18" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Tu4LD_z154tAdkzWn4kH-11" value="ENI &amp;amp; IP Management" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="290" y="510" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Tu4LD_z154tAdkzWn4kH-13" value="Limits: &lt;br&gt;Defined by instance type (e.g., t3.medium = 3 ENIs x (6 IPs - 1 primary) + 2 = 17 Pods)." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="530" y="470" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Tu4LD_z154tAdkzWn4kH-16" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;4,1,1,1,0&quot;&gt;Primary ENI (eth0):&lt;/b&gt; &lt;br&gt;Permanent; holds node identity." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="532" y="580" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Tu4LD_z154tAdkzWn4kH-18" value="&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;4,1,1,2,0&quot;&gt;Secondary ENIs:&lt;/b&gt; Dynamic; added/removed based on demand." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
